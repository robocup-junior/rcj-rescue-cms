//- -*- tab-width: 2 -*-
extends ../includes/modern_layout

block vars
  - var ngAppDef = 'SurveyAnswers'

append scripts
  script.
    var competitionId = "#{id}"
    var survId = "#{survId}"
  script(src='/javascripts/survey/answers.js?v=' + assetVersion)
  script(src='/components/exceljs/index.js?v=' + assetVersion)

block hero_breadcrumb
  a.breadcrumb-item(ng-click="go('/home')")
    i.fas.fa-home.mr-1
    | Home
  a.breadcrumb-item(ng-click="go('/admin')") Admin
  a.breadcrumb-item(ng-click="go('/admin/' + competitionId)") {{competition.name}}
  a.breadcrumb-item(ng-click="go('/admin/' + competitionId + '/survey')") Survey
  span.breadcrumb-item.active {{langContent(survey.i18n, 'name')}}

append css
  style.
    .table-modern p {
      margin-bottom: 0;
    }

block hero_title
  | {{langContent(survey.i18n, 'name')}}

block hero_subtitle
  | {{competition.name}}

block hero_actions
  button.btn-action-icon(type='button' ng-click="downloadExcel()" uib-tooltip='Export' tooltip-placement="bottom")
    i.fas.fa-file-excel

block main_content
  .modern-card
    .modern-card-header
      i.fas.fa-list.mr-2
      | Answers
    .modern-card-body.p-0
      .table-responsive(style="padding: 0 1.5rem 1.5rem;")
        table.table-modern.table-auto
          thead
            tr
              th {{"common.teamCode" | translate}}
              th {{"common.team" | translate}}
              th(ng-hide="question.type=='explanationOnly'" ng-repeat="question in survey.questions" ng-bind="langContent(question.i18n, 'title')")
              th(style="width: 140px;") {{"common.operation" | translate}}
          tbody
            tr(ng-repeat="ans in answers | orderBy: ['team.teamCode','team.name']")
              td(ng-bind="ans.team.teamCode")
              td.font-weight-bold(ng-bind="ans.team.name")
              td(ng-hide="question.type=='explanationOnly'" ng-repeat="question in survey.questions" ng-bind-html="getAnswer(ans, question)")
              td
                .btn-table-group
                  .btn-table-action.primary(ng-click="edit(ans)" uib-tooltip='{{"common.edit" | translate}}')
                    i.fas.fa-edit
                  .btn-table-action.danger(ng-click='delete(ans)' uib-tooltip='{{"common.delete" | translate}}')
                    i.fas.fa-trash-alt
