//- -*- tab-width: 2 -*-
extends ../includes/modern_layout

block vars
  - var ngAppDef = 'SurveyList'

append scripts
  script.
    var competitionId = "#{id}"
  script(src='/javascripts/survey/list.js?v=' + assetVersion)

block hero_breadcrumb
  a.breadcrumb-item(ng-click="go('/home')")
    i.fas.fa-home.mr-1
    | Home
  a.breadcrumb-item(ng-click="go('/admin')") Admin
  a.breadcrumb-item(ng-click="go('/admin/' + competitionId)") {{competition.name}}
  span.breadcrumb-item.active Survey

block hero_title
  | {{competition.name}}

block hero_subtitle
  | {{"survey.title" | translate}}

block hero_actions
  a.btn-create-map(ng-href="/admin/{{competitionId}}/survey/edit")
    i.fas.fa-plus-circle
    span {{"survey.new" | translate}}

block main_content
  .modern-card
    .modern-card-header
      i.fas.fa-question-circle.mr-2
      | {{"survey.title" | translate}}
    .modern-card-body.p-0
      .table-responsive(style="padding: 0 1.5rem 1.5rem;")
        table.table-modern.table-auto
          thead
            tr
              th {{"common.name" | translate}}
              th(style="width: 210px;") {{"common.operation" | translate}}
          tbody
            tr(ng-repeat='s in survey')
              td.font-weight-bold(ng-bind='s.name')
              td
                .btn-table-group
                  .btn-table-action.primary(ng-click="edit(s._id)" uib-tooltip='{{"common.edit" | translate}}')
                    i.fas.fa-edit
                  .btn-table-action(ng-click='answers(s._id)' uib-tooltip='Answers')
                    i.fas.fa-list
                  .btn-table-action.danger(ng-click='delete(s)' uib-tooltip='{{"common.delete" | translate}}')
                    i.fas.fa-trash-alt
