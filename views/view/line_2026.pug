html(ng-app="ddApp")
  head
    title Rescue Line View
    script.
      var runId = "#{id}"
      var timeIncrement = false
      var iframe = "#{iframe}"

    include ../includes/common_component
    script(src="/javascripts/sign/line_2026.js?v=" + assetVersion)
    script(src="/javascripts/translate_config.js?v=" + assetVersion)
    link(href="/stylesheets/fredrik.css?v=" + assetVersion rel="stylesheet")
    link(href="/stylesheets/line_view.css?v=" + assetVersion rel="stylesheet")
    meta(name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0")

  body.run-view(ng-controller="ddController")
    //- Sticky bar: team, live score and time
    header.rv-topbar
      button.rv-back(type='button' title="{{'common.back' | translate}}" ng-click="getParam('return')? go(getParam('return')):go('/line/' + competition_id + '/' + league)")
        i.fas.fa-arrow-left
      .rv-team
        span.rv-live(title='Live')
        span.rv-team-name {{team}}
      .rv-topbar-stats
        .rv-stat
          i.fas.fa-calculator
          span.rv-stat-value {{score}}
          span.rv-stat-unit {{'common.point' | translate}}
        .rv-stat
          i.fas.fa-stopwatch
          span.rv-stat-value {{minutes*60*1000+seconds*1000 | date:'m:ss'}}

    main.rv-page
      //- The result first: score, time, how the score adds up, then the run's details
      section.rv-summary
        .rv-summary-top
          .rv-summary-item
            .rv-summary-label
              i.fas.fa-trophy
              |  {{'common.score' | translate}}
            .rv-summary-value
              | {{score}}
              small {{'common.point' | translate}}
            //- Same format as the ranking: two decimals, a plain 1 for the best run
            .rv-summary-sub(ng-if="normalizedScore != null")
              | {{'common.normalizedScore' | translate}}: {{normalizedScore === 1 ? '1' : (normalizedScore | number:2)}}
          .rv-summary-item
            .rv-summary-label
              i.fas.fa-stopwatch
              |  {{'common.time' | translate}}
            .rv-summary-value {{minutes*60*1000+seconds*1000 | date:'m:ss'}}
        .rv-breakdown
          span.rv-paren (
          a.rv-chip(href='#rv-items' data-jump)
            .rv-chip-label {{'line.sign.item' | translate}}
            .rv-chip-value {{raw_score - checkTotal() - exitBonusPoints()}}
          span.rv-op +
          a.rv-chip(href='#rv-checkpoints' data-jump)
            .rv-chip-label {{'line.sign.checkPointScore' | translate}}
            .rv-chip-value {{checkTotal()}}
          span.rv-op +
          a.rv-chip(href='#rv-exit' data-jump)
            .rv-chip-label {{'line.sign.exitBonus' | translate}}
            .rv-chip-value {{exitBonusPoints()}}
          span.rv-paren )
          //- Phones show the equation as a list without brackets, so the sub total gets its own line
          span.rv-op.rv-phone-only =
          .rv-chip.rv-phone-only
            .rv-chip-label {{'common.stotal' | translate}}
            .rv-chip-value {{raw_score}}
          span.rv-op ×
          a.rv-chip(href='#rv-rescue' data-jump)
            .rv-chip-label {{'common.multipliers' | translate}}
            .rv-chip-value {{multiplier}}
          span.rv-op =
          .rv-chip.rv-chip-result
            .rv-chip-label {{'common.score' | translate}}
            .rv-chip-value {{score}}
        ul.rv-meta
          li(title="{{'common.competition' | translate}}")
            i.fas.fa-trophy
            | {{competition}}
          li(title="{{'common.round' | translate}}")
            i.fas.fa-redo-alt
            | {{round}}
          li(title="{{'common.field' | translate}}")
            i.fas.fa-map-marker-alt
            | {{field}}
          li(title="{{'common.league' | translate}}")
            i.fas.fa-route
            | {{league}}
          li(title="{{'common.rule' | translate}}")
            i.fas.fa-book
            | #{rule}

      //- The map with the item points
      section.rv-card.rv-map#rv-items
        .rv-card-header
          i.fas.fa-map
          | {{'line.sign.item' | translate}}
          //- Floor and rotation in the header row, before the total
          .rv-map-tools
            .btn-group(ng-show='height > 1')
              button.rv-tool(type='button' ng-repeat='zz in range(height)' ng-class='{active: zz == z}' ng-click='changeFloor(zz)')
                i.fas.fa-layer-group(ng-if='$first')
                |  {{zz}}
            .btn-group
              button.rv-tool(type='button' title='-90°' ng-click='tileRot(-90)')
                i.fas.fa-undo
              button.rv-tool(type='button' title='+90°' ng-click='tileRot(90)')
                i.fas.fa-redo
          span.rv-header-total {{raw_score - checkTotal() - exitBonusPoints()}} {{'common.point' | translate}}
        //- What the colours on the tiles mean
        .rv-map-legend
          span.rv-key.is-done {{'line.view.tileDone' | translate}}
          span.rv-key.is-halfdone {{'line.view.tilePartial' | translate}}
          span.rv-key.is-undone {{'line.view.tileNone' | translate}}
          span.rv-key.is-cp {{'line.view.checkpoint' | translate}}
          span.rv-key.is-evac(ng-if='hasEvacZone()') {{'line.view.evacuation' | translate}}
        .tilearea
          #wrapTile.mx-auto
            div(ng-repeat='r in range(length)', ng-if='sRotate==0', style='display: flex;')
              div(style='text-align:center;')
                .slot(ng-repeat='c in range(width)')
                  tile(template='view' tile="mtiles[c+','+r+','+z]", ng-click='showElements(c,r,z)')
            div(ng-repeat='r in range(length)', ng-if='sRotate==180', style='display: flex;')
              .slot(ng-repeat='c in range(width)')
                tile(template='view' tile="mtiles[width - c -1+','+(length - r -1)+','+z]", ng-click='showElements(width - c -1,length - r -1,z)')
            div(ng-repeat='r in range(width)', ng-if='sRotate==270', style='display: flex;')
              .slot(ng-repeat='c in range(length)')
                tile(template='view' tile="mtiles[width - r -1+','+c+','+z]", ng-click='showElements(width-r-1,c,z)')
            div(ng-repeat='r in range(width)', ng-if='sRotate==90', style='display: flex;')
              .slot(ng-repeat='c in range(length)')
                tile(template='view' tile="mtiles[r+','+ (length - c-1) +','+z]", ng-click='showElements(r,length-c-1,z)')

      //- Checkpoints and LoPs together: a section's checkpoint points are its tiles times the
      //- points per tile, and those depend on the LoPs in the section
      section.rv-card.rv-course#rv-checkpoints
        .rv-card-header
          i.fas.fa-flag-checkered
          | {{'line.view.cpAndLops' | translate}}
          span.rv-header-lops(title="{{'common.lops' | translate}}")
            i.fas.fa-step-forward
            | {{sum(LoPs)}} {{'common.times' | translate}}
          span.rv-header-total {{checkTotal()}} {{'common.point' | translate}}
        //- Points per tile for each number of LoPs in a section
        .rv-rates
          span.rv-rates-title {{'line.view.perTile' | translate}}
          span.rv-rate(ng-repeat='n in [0, 1, 2, 3]')
            span.rv-lop-count(ng-class="{'is-zero': !n}")
              i.fas.fa-step-forward
              | {{n}}{{$last ? '+' : ''}}
            | {{LoPsCountPoint(n)}} {{'common.point' | translate}}
        //- The course from start to goal: a dot per checkpoint (reached or not) with the points
        //- scored there, and between the dots the section's LoPs and its tiles × points per tile
        .rv-track
          .rv-track-seg(ng-repeat-start='cp in checkPointDistance track by $index' ng-if='!$first' ng-class="{'is-ok': cp.status, 'is-evac': $index - 1 == EvacuationAreaLoPIndex}")
            .rv-seg-line
            .rv-seg-meta
              span.rv-lop-count(ng-class="{'is-zero': !LoPs[$index-1]}" title="{{'common.lops' | translate}}")
                i.fas.fa-step-forward
                | {{LoPs[$index-1]}}
              span.rv-seg-calc {{cp.dis}} {{'common.tile' | translate}} × {{LoPsCountPoint(LoPs[$index-1])}}
              span.rv-sec.rv-sec-evac(ng-if='$index - 1 == EvacuationAreaLoPIndex' title="{{'line.view.evacuation' | translate}}")
                i.fas.fa-ambulance
                | {{'line.view.evacuationShort' | translate}}
          .rv-track-node(ng-repeat-end ng-class="cp.status ? 'is-ok' : 'is-ng'")
            .rv-node-dot
              i.fas(ng-class="cp.status ? 'fa-check' : 'fa-times'")
            .rv-node-label
              span.rv-sec.rv-sec-start(ng-if='$first')
                i.fas.fa-play
                | {{'line.view.start' | translate}}
              span.rv-sec.rv-sec-cp(ng-if='!$first && !$last' title="{{'line.view.checkpoint' | translate}} {{$index}}")
                i.fas.fa-flag
                | {{$index}}
              span.rv-sec.rv-sec-exit(ng-if='$last')
                i.fas.fa-flag-checkered
                | {{'line.view.goal' | translate}}
            .rv-node-points
              | {{cp.point}}
              small {{'common.point' | translate}}

      .rv-two-col
        //- Rescue, then the exit bonus: the order they happen in a run
        //- Rescue
        section.rv-card#rv-rescue
          .rv-card-header
            i.fas.fa-first-aid
            | {{'line.sign.rescue' | translate}}
            span.rv-header-total x{{multiplier}}
          .rv-rescue
            .rv-rescue-rate
              .rv-rescue-victims
                img(src='/images/liveVictim.png', alt='')
                img(src='/images/deadVictim.png', alt='')
              .rv-rescue-formula
                | {{calc_victim_type_lop_multiplier(0)}} − (0.05 ×
                i.fas.fa-step-forward
                |  {{LoPs[EvacuationAreaLoPIndex]}})
              .rv-pill.rv-pill-teal
                b {{calc_victim_type_lop_multiplier()}}
                | &nbsp;{{'line.view.perVictim' | translate}}
            //- Rescued victims in order: victim, the zone it was taken to, its multiplier
            .rv-rescues
              .rv-rescues-title
                | {{'line.view.rescuedVictims' | translate}}
                span.rv-rescues-count {{victim_list.length}}
              ol.rv-rescue-list(ng-if='victim_list.length')
                li.rv-rescue-item(ng-repeat='v in victim_list track by $index' ng-class="{'is-bonus': calc_victim_multipliers($index) > 1, 'is-void': calc_victim_multipliers($index) == 0}")
                  span.rv-rescue-order {{$index + 1}}
                  img.rv-victim(ng-src="{{v.victimType == 'LIVE' ? '/images/liveVictim.png' : '/images/deadVictim.png'}}" alt="{{v.victimType}}")
                  i.fas.fa-long-arrow-alt-right.rv-lop-arrow
                  span.rv-zone(ng-class="v.zoneType == 'RED' ? 'is-red' : 'is-green'")
                    img(ng-src="{{v.zoneType == 'RED' ? '/images/evacZone/red_lv2.png' : '/images/evacZone/green_lv2.png'}}" alt="{{v.zoneType}}")
                  span.rv-rescue-mult
                    | {{calc_victim_multipliers($index) == 0 ? '—' : 'x' + calc_victim_multipliers($index)}}

        //- Exit bonus
        section.rv-card#rv-exit
          .rv-card-header
            i.fas.fa-sign-out-alt
            | {{'line.sign.exitBonus' | translate}}
            span.rv-header-total {{exitBonusPoints()}} {{'common.point' | translate}}
          //- Did the robot exit, and how much of the 60 points the LoPs took away
          .rv-exit(ng-class="{'is-ng': !exitBonus}")
            .rv-exit-head
              .rv-exit-image(ng-class="exitBonus ? 'is-ok' : 'is-ng'")
                img(src='/images/line_bonus.png', alt='', ng-if="league != 'LineNL'")
                img(src='/images/nl_bonus.png', alt='', ng-if="league == 'LineNL'")
                span.rv-exit-mark
                  i.fas(ng-class="exitBonus ? 'fa-check' : 'fa-times'")
              .rv-exit-status
                .rv-exit-title(ng-class="exitBonus ? 'is-ok' : 'is-ng'")
                  | {{(exitBonus ? 'line.view.exitDone' : 'line.view.exitNotDone') | translate}}
                .rv-exit-formula(ng-if='exitBonus')
                  | {{'line.view.exitBase' | translate}} 60 − {{'common.lops' | translate}} {{sum(LoPs)}} {{'common.times' | translate}} × 5
            .rv-meter(ng-if='exitBonus')
              .rv-meter-track
                .rv-meter-bonus(ng-style="{width: (exitBonusPoints() / 60 * 100) + '%'}")
                .rv-meter-loss(ng-style="{width: ((60 - exitBonusPoints()) / 60 * 100) + '%'}")
              .rv-meter-legend
                span.rv-legend.rv-legend-bonus
                  | {{'line.sign.exitBonus' | translate}}
                  b {{exitBonusPoints()}}
                span.rv-legend.rv-legend-loss(ng-if='exitBonusPoints() < 60')
                  | {{'line.view.exitDeduction' | translate}}
                  b −{{60 - exitBonusPoints()}}
                span.rv-legend-max 60 {{'common.point' | translate}}

      //- Comment and signatures (staff only)
      if user
        section.rv-card
          .rv-card-header
            i.fas.fa-comment
            | {{'line.view.comment' | translate}}
          .rv-card-body
            p.rv-note {{'line.view.comment_e' | translate}}
            textarea.form-control(ng-model='comment', rows='3', disabled='')
        section.rv-card
          .rv-card-header
            i.fas.fa-pencil-alt
            | {{'line.view.sign' | translate}}
          .rv-card-body
            p.rv-note.rv-note-warning(translate='line.view.sign_e')
            .rv-sign-grid
              .rv-sign
                .rv-sign-title(translate='line.view.cap_sign')
                img(ng-src='{{cap_sig}}', alt='')
              .rv-sign
                .rv-sign-title(translate='line.view.ref_sign')
                img(ng-src='{{ref_sig}}', alt='')
              .rv-sign
                .rv-sign-title(translate='line.view.cref_sign')
                img(ng-src='{{refas_sig}}', alt='')
    include ../includes/footer
    script.
      // The chips of the score equation jump to their cards. Scrolled from here, since Angular
      // would take the #hash links for its own routes
      document.querySelectorAll('[data-jump]').forEach(function (link) {
        link.addEventListener('click', function (event) {
          event.preventDefault();
          document.querySelector(link.getAttribute('href')).scrollIntoView({ behavior: 'smooth' });
        });
      });

      // The score and time in the bar would repeat the summary, so show them only once it has scrolled away
      (function () {
        var bar = document.querySelector('.rv-topbar');
        var summary = document.querySelector('.rv-summary');
        if (!bar || !summary || !('IntersectionObserver' in window)) return;
        bar.classList.add('stats-follow-summary');
        new IntersectionObserver(function (entries) {
          bar.classList.toggle('show-stats', !entries[0].isIntersecting);
        }, { rootMargin: '-' + bar.offsetHeight + 'px 0px 0px 0px' }).observe(summary);
      })();

      // View page only: start with the map turned the way it is drawn largest (0° or 90°).
      // The rotation is set directly, because tileRot() would also save it in the cookie
      // that the judge and sign pages read.
      angular.element(document).ready(function () {
        var scope = angular.element(document.body).scope();
        var stop = scope.$watchGroup(['width', 'length'], function (size) {
          if (!size[0] || !size[1]) return;
          stop();
          var area = document.querySelector('.tilearea');
          var areaWidth = area.clientWidth - parseFloat(getComputedStyle(area).paddingLeft) * 2;
          // Same space as tile_size() in sign/line_2026.js
          var areaHeight = window.innerHeight - 140;
          function tileSize(cols, rows) {
            return Math.min((areaWidth - 2 * cols) / cols, areaHeight / rows);
          }
          scope.sRotate = tileSize(scope.length, scope.width) > tileSize(scope.width, scope.length) ? 90 : 0;
          rotate = scope.sRotate;
          setTimeout(tile_size, 0);
        });
      });
