                img.tile-image(ng-src='/images/red_right.png', ng-show="cells[2*width - r+','+c+','+z].tile.victims.bottom == 'Red'")
                img.tile-image(ng-src='/images/red_bottom.png', ng-show="cells[2*width - r+','+c+','+z].tile.victims.left == 'Red'")
                img.tile-image(ng-src='/images/yellow_left.png', ng-show="cells[2*width - r+','+c+','+z].tile.victims.top == 'Yellow'")
                img.tile-image(ng-src='/images/yellow_top.png', ng-show="cells[2*width - r+','+c+','+z].tile.victims.right == 'Yellow'")
                img.tile-image(ng-src='/images/yellow_right.png', ng-show="cells[2*width - r+','+c+','+z].tile.victims.bottom == 'Yellow'")
                img.tile-image(ng-src='/images/yellow_bottom.png', ng-show="cells[2*width - r+','+c+','+z].tile.victims.left == 'Yellow'")
                img.tile-image(ng-src='/images/green_left.png', ng-show="cells[2*width - r+','+c+','+z].tile.victims.top == 'Green'")
                img.tile-image(ng-src='/images/green_top.png', ng-show="cells[2*width - r+','+c+','+z].tile.victims.right == 'Green'")
                img.tile-image(ng-src='/images/green_right.png', ng-show="cells[2*width - r+','+c+','+z].tile.victims.bottom == 'Green'")
                img.tile-image(ng-src='/images/green_bottom.png', ng-show="cells[2*width - r+','+c+','+z].tile.victims.left == 'Green'")
                img.tile-image(ng-src='/images/red_floor.png', ng-show="cells[2*width - r+','+c+','+z].tile.victims.floor == 'Red'")
                img.tile-image(ng-src='/images/green_floor.png', ng-show="cells[2*width - r+','+c+','+z].tile.victims.floor == 'Green'")
                span.rv-mz-frame(ng-if="tileStatus(2*width - r,c,z,$odd && $parent.$odd)" ng-class="'is-' + tileStatus(2*width - r,c,z,$odd && $parent.$odd)")

//- Then the bonuses and the deduction, side by side where there is room
.rv-grid-3
  //- The reliability bonus: what the run achieved, less the LoPs (never below 0)
  section.rv-card#rv-reliability
    .rv-card-header
      i.fas.fa-shield-alt
      | {{'maze.sign.reliability' | translate}}
      span.rv-header-total {{reliability()}} {{'common.point' | translate}}
    ul.rv-calc
      li.rv-calc-row
        span.rv-calc-label
          i.fas.fa-child
          |  {{'maze.sign.rescue' | translate}}
        span.rv-calc-expr {{foundVictims}} × 10
        span.rv-calc-value {{foundVictims * 10}}
      li.rv-calc-row.is-minus
        span.rv-calc-label
          i.fas.fa-step-forward
          |  {{'maze.sign.total_lops' | translate}}
        span.rv-calc-expr {{LoPs}} × 5
        span.rv-calc-value −{{reliabilityLoPs()}}
      li.rv-calc-row.is-total
        span.rv-calc-label {{'maze.sign.reliability' | translate}}
        span.rv-calc-value {{reliability()}}

  //- The exit bonus: earned by returning to the start, from what the run achieved
  section.rv-card#rv-exit
    .rv-card-header
      i.fas.fa-sign-out-alt
      | {{'maze.sign.exit' | translate}}
      span.rv-header-total {{foundVictims * 10 * (exitBonus ? 1 : 0)}} {{'common.point' | translate}}
    .rv-exit(ng-class="{'is-ng': !exitBonus}")
      .rv-exit-head
        .rv-exit-image(ng-class="exitBonus ? 'is-ok' : 'is-ng'")
          img(src='/images/maze_bonus.png', alt='')
          span.rv-exit-mark
            i.fas(ng-class="exitBonus ? 'fa-check' : 'fa-times'")
        .rv-exit-status
          .rv-exit-title(ng-class="exitBonus ? 'is-ok' : 'is-ng'")
            | {{(exitBonus ? 'line.view.exitDone' : 'line.view.exitNotDone') | translate}}
    ul.rv-calc(ng-if='exitBonus')
      li.rv-calc-row
        span.rv-calc-label
          i.fas.fa-child
          |  {{'maze.sign.rescue' | translate}}
        span.rv-calc-expr {{foundVictims}} × 10
        span.rv-calc-value {{foundVictims * 10}}
      li.rv-calc-row.is-total
        span.rv-calc-label {{'maze.sign.exit' | translate}}
        span.rv-calc-value {{foundVictims * 10 * (exitBonus ? 1 : 0)}}

  //- Misidentifications: 5 points each, taken from the rest
  section.rv-card#rv-misident
    .rv-card-header
      i.fas.fa-exclamation-triangle
      | {{'maze.sign.misidentification' | translate}}
      span.rv-header-total {{misIdentPoints() ? '−' + misIdentPoints() : 0}} {{'common.point' | translate}}
    ul.rv-calc
      li.rv-calc-row.is-minus
        span.rv-calc-label
          i.fas.fa-times-circle
          |  {{'maze.sign.misidentification' | translate}}
        span.rv-calc-expr {{MisIdent}} × 5
        span.rv-calc-value {{misIdentPoints() ? '−' + misIdentPoints() : 0}}

