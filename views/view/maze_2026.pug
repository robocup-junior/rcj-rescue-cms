html(ng-app="ddApp")
  head
    title Rescue Maze View
    script.
      var runId = "#{id}"
      var timeIncrement = false
      var iframe = "#{iframe}"

    include ../includes/common_component
    script(src="/javascripts/cognitive_target.js?v=" + assetVersion)
    script(src="/javascripts/sign/maze_2026.js?v=" + assetVersion)
    script(src="/javascripts/translate_config.js?v=" + assetVersion)
    link(href="/stylesheets/fredrik.css?v=" + assetVersion rel="stylesheet")
    link(href="/stylesheets/maze.css?v=" + assetVersion rel="stylesheet")
    link(href="/stylesheets/line_view.css?v=" + assetVersion rel="stylesheet")
    meta(name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0")

  body.run-view.rv-is-loading(ng-controller="ddController")
    include ../includes/maze_loading
    //- Sticky bar: team, live score and time
    header.rv-topbar
      button.rv-back(type='button' title="{{'common.back' | translate}}" ng-click="getParam('return')? go(getParam('return')):go('/maze/' + competition_id + '/' + league)")
        i.fas.fa-arrow-left
      .rv-team
        span.rv-live(title='Live')
        span.rv-team-name {{team}}
      .rv-topbar-stats
        .rv-stat
          i.fas.fa-calculator
          span.rv-stat-value {{score}}
          span.rv-stat-unit {{'common.point' | translate}}
        .rv-stat
          i.fas.fa-stopwatch
          span.rv-stat-value {{minutes*60*1000+seconds*1000 | date:'m:ss'}}

    main.rv-page
      include common/maze_2026_summary
      include common/maze_2026

      //- Comment and signatures (staff only)
      if user
        section.rv-card
          .rv-card-header
            i.fas.fa-comment
            | {{'maze.view.comment' | translate}}
          .rv-card-body
            p.rv-note {{'maze.view.comment_e' | translate}}
            textarea.form-control(ng-model='comment', rows='3', disabled='')
        section.rv-card
          .rv-card-header
            i.fas.fa-pencil-alt
            | {{'maze.view.sign' | translate}}
          .rv-card-body
            p.rv-note.rv-note-warning(translate='maze.view.sign_e')
            .rv-sign-grid
              .rv-sign
                .rv-sign-title(translate='maze.view.cap_sign')
                img(ng-src='{{cap_sig}}', alt='')
              .rv-sign
                .rv-sign-title(translate='maze.view.ref_sign')
                img(ng-src='{{ref_sig}}', alt='')
              .rv-sign
                .rv-sign-title(translate='maze.view.cref_sign')
                img(ng-src='{{refas_sig}}', alt='')
    include ../includes/footer
    script(src="/javascripts/line_view.js?v=" + assetVersion)
