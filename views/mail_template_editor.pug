//- -*- tab-width: 2 -*-
extends includes/modern_layout

block vars
  - var ngAppDef = 'TemplateEditor'

append scripts
  script.
    var subject = "#{subject}"
    var kind = "#{kind}"
  script(src='/javascripts/mail_template_editor.js?v=' + assetVersion)
  script(src='/javascripts/mail_compose.js?v=' + assetVersion)
  script(src='/components/quill-dist/index.js?v=' + assetVersion)
  script(src='/components/ngQuill/src/ng-quill.js?v=' + assetVersion)
  script(src='/components/quill-image-resize-module/image-resize.min.js?v=' + assetVersion)
  script(src='/components/quill-image-drop-and-paste/dist/quill-image-drop-and-paste.min.js?v=' + assetVersion)

append css
  link(rel='stylesheet', href='/components/quill.snow/index.css?v=' + assetVersion)

block hero_breadcrumb
  a.breadcrumb-item(ng-click="go('/home')")
    i.fas.fa-home.mr-1
    | Home
  a.breadcrumb-item(ng-click="go('/admin')") Admin
  a.breadcrumb-item(ng-click="go('/admin/mailTemplates' + (kind == 'staff' ? '?kind=staff' : ''))") Mail Templates
  span.breadcrumb-item.active Editor

block hero_title
  | {{"admin.mailTemplates.title" | translate}}

block hero_subtitle
  span.badge.badge-light.mr-2
    i.fas.mr-1(ng-class="kind == 'staff' ? 'fa-user-tie' : 'fa-users'")
    | {{(kind == 'staff' ? 'mail.home.toStaff' : 'mail.home.toTeams') | translate}}
  | {{subject}}

block main_content
  .modern-card
    .modern-card-header
      .d-flex.justify-content-between.align-items-center.w-100
        div
          i.fas.fa-pen.mr-2
          | {{"admin.mailTemplates.edit" | translate}}
        span.small.text-muted(ng-if="dirty()")
          i.fas.fa-circle.mr-1(style="font-size: 0.5rem; color: #f59e0b; vertical-align: middle;")
          | {{"admin.mailTemplates.unsaved" | translate}}
    .modern-card-body
      mail-composer(subject="subject" content="mailContent" recipients="toTeam" show-errors="triedSave")

      //- What may be wrong with it, as it is written
      ul.mail-checks.mt-3(ng-if="checks.length > 0")
        li(ng-repeat="c in checks")
          i.fas.mt-1(ng-class="c.level == 'danger' ? 'fa-times-circle text-danger' : 'fa-exclamation-triangle text-warning'")
          span {{'mail.check.' + c.key | translate:c.params}}

      .d-flex.justify-content-between.align-items-center.mt-4
        a.btn.btn-light(ng-href="/admin/mailTemplates{{kind == 'staff' ? '?kind=staff' : ''}}")
          i.fas.fa-arrow-left.mr-2
          | {{"admin.mailTemplates.back" | translate}}
        button.btn.btn-premium-primary(type='button' ng-click="save()" ng-disabled="saving")
          i.fas.fa-save.mr-2
          | {{"common.save" | translate}}
