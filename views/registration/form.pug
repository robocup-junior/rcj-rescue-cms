//- -*- tab-width: 2 -*-
extends ../includes/modern_layout

block vars
  - var contentContainerStyle = 'max-width: 760px;'
  - var ngAppDef = 'form'

append scripts
  script.
    var competitionId = "#{id}"
    var leagueId = "#{leagueId}"
    var authId = "#{authId}"
    var token = "#{token}"
  script(src='/components/angular-toastr/dist/angular-toastr.tpls.min.js')
  script(src='/javascripts/registration/form.js')

block hero_breadcrumb
  a.breadcrumb-item(ng-click="go('/home')")
    i.fas.fa-home.mr-1
    | Home
  span.breadcrumb-item.active Registration

block hero_title
  | {{competition.name}}

block hero_subtitle
  | {{leagueName}}

block main_content
  .modern-card.mb-5
    .modern-card-header
      i.fas.fa-pen-fancy.mr-2
      | {{"registration.register" | translate}}
    .modern-card-body
      .result-state(ng-show="isProcessing")
        i.fas.fa-spinner.fa-spin.text-primary
        p {{"registration.processing" | translate}}

      div(ng-hide="isSuccess || isProcessing")
        p.small.text-muted {{"registration.timelimit" | translate}}
        .alert.alert-danger(role='alert' ng-if="isEmpty") {{"registration.validation" | translate}}
        .alert.alert-danger(role='alert' ng-if="isFailed") {{"registration.timeError" | translate}}
        form(ng-submit="submit()")
          .form-group
            label.small.text-muted {{"common.team" | translate}}
            .input-group.input-group-lg
              .input-group-prepend
                span.input-group-text
                  i.fas.fa-user-friends
              input.form-control(type='text' autocorrect="off" autocapitalize="off" placeholder='Team Name' aria-label='teamName' ng-model="teamName")
          .form-group
            label.small.text-muted {{"common.region" | translate}}
            .input-group.input-group-lg
              .input-group-prepend
                span.input-group-text
                  i.fas.fa-globe-asia
              input.form-control(type='text' placeholder='Region' aria-label='Region' ng-model="region")
          .form-group
            label.small.text-muted {{"registration.email" | translate}}
            .input-group.input-group-lg
              .input-group-prepend
                span.input-group-text
                  i.fas.fa-at
              input.form-control(type='text' placeholder='Mail address' aria-label='Address1' value=`${mail}` disabled)
          if consentForm != ""
            hr
            label.small.text-muted.d-block {{"registration.consent" | translate}}
            a.btn.btn-sm.btn-outline-primary.mb-2(href=`${consentForm}` target="_blank")
              i.fas.fa-file-pdf.mr-1
              | {{"registration.viewConsent" | translate}}
            p.small {{"registration.consentMes" | translate}}
            input(type='checkbox' ng-model='consent' id="check_consent")
            label.checkbox(for="check_consent") {{"registration.allConsent" | translate}}
            hr
            .text-center
              button.btn.btn-premium-primary.btn-lg(type='submit' ng-disabled="!consent")
                i.fas.fa-sign-in-alt.mr-2
                | {{"registration.register" | translate}}
          else
            .text-center.mt-4
              button.btn.btn-premium-primary.btn-lg(type='submit')
                i.fas.fa-sign-in-alt.mr-2
                | {{"registration.register" | translate}}

      .result-state.success(ng-if="isSuccess && !isProcessing")
        i.far.fa-check-circle
        p.text-muted {{"registration.registered" | translate}}
