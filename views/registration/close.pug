//- -*- tab-width: 2 -*-
extends ../includes/modern_layout

block vars
  - var contentContainerStyle = 'max-width: 760px;'
  - var ngAppDef = 'top'

append scripts
  script.
    var competitionId = "#{id}"
    var leagueId = "#{leagueId}"
  script(src='/components/angular-toastr/dist/angular-toastr.tpls.min.js?v=' + assetVersion)
  script(src='/javascripts/registration/top.js?v=' + assetVersion)

block hero_breadcrumb
  a.breadcrumb-item(ng-click="go('/home')")
    i.fas.fa-home.mr-1
    | Home
  span.breadcrumb-item.active Registration

block hero_title
  | {{competition.name}}

block hero_subtitle
  | {{leagueName}}

block main_content
  .modern-card.mb-5
    .modern-card-body
      .result-state.error
        i.fas.fa-ban
        p.text-muted {{"registration.close" | translate}}
