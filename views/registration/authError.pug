//- -*- tab-width: 2 -*-
extends ../includes/modern_layout

block vars
  - var contentContainerStyle = 'max-width: 760px;'
  - var ngAppDef = 'authError'

append scripts
  script(src='/components/angular-toastr/dist/angular-toastr.tpls.min.js?v=' + assetVersion)
  script(src='/javascripts/registration/authError.js?v=' + assetVersion)

block hero_breadcrumb
  a.breadcrumb-item(ng-click="go('/home')")
    i.fas.fa-home.mr-1
    | Home
  span.breadcrumb-item.active Registration

block hero_title
  | {{"registration.error" | translate}}

block hero_subtitle
  | Registration

block main_content
  .modern-card.mb-5
    .modern-card-body
      .result-state
        i.fas.fa-exclamation-triangle(style="color: #f59e0b;")
        p.text-muted {{"registration.errorMes" | translate}}
