//- -*- tab-width: 2 -*-
extends ../includes/modern_layout

block vars
  - var contentContainerStyle = 'max-width: 760px;'
  - var ngAppDef = 'top'

append scripts
  script.
    var competitionId = "#{id}"
    var leagueId = "#{leagueId}"
  script(src='/components/angular-toastr/dist/angular-toastr.tpls.min.js')
  script(src='/javascripts/registration/top.js')

block hero_breadcrumb
  a.breadcrumb-item(ng-click="go('/home')")
    i.fas.fa-home.mr-1
    | Home
  span.breadcrumb-item.active Registration

block hero_title
  | {{competition.name}}

block hero_subtitle
  | {{leagueName}}

block main_content
  .modern-card.mb-5
    .modern-card-header
      i.fas.fa-key.mr-2
      | {{"registration.auth" | translate}}
    .modern-card-body
      .result-state(ng-show="isProcessing")
        i.fas.fa-spinner.fa-spin.text-primary
        p {{"registration.processing" | translate}}

      div(ng-hide="isSuccess || isProcessing")
        .alert.alert-danger(role='alert' ng-if="isFailed") {{"registration.authError" | translate}}
        form(ng-submit="submit()")
          .form-group
            .input-group.input-group-lg
              .input-group-prepend
                span.input-group-text
                  i.fas.fa-key
              input.form-control(type='password' autocorrect="off" autocapitalize="off" placeholder='Registration Code' aria-label='passCode' ng-model="passCode" ng-class="isFailed?'is-invalid':''")
          .form-group
            .input-group.input-group-lg
              .input-group-prepend
                span.input-group-text
                  i.fas.fa-at
              input.form-control(type='email' placeholder='Mail Address' aria-label='Mail' ng-model="mail" ng-class="isFailed?'is-invalid':''")
          .alert.alert-info(role='alert')
            p {{"registration.authDesc1" | translate}}
            p.text-center
              strong #{fromAddress}
            p.mb-0 {{"registration.authDesc2" | translate}}
          .text-center
            button.btn.btn-premium-primary.btn-lg(type='submit')
              i.far.fa-paper-plane.mr-2
              | {{"registration.authButton" | translate}}

      .result-state.success(ng-if="isSuccess && !isProcessing")
        i.far.fa-paper-plane
        p.text-muted {{"registration.authSent" | translate}}
