//- -*- tab-width: 2 -*-
extends ../includes/modern_layout

block vars
  - var ngAppDef = 'RegistrationSettings'

append scripts
  script.
    var competitionId = "#{id}"
  script(src='/components/angular-toastr/dist/angular-toastr.tpls.min.js')
  script(src='/javascripts/registration/settings.js')

append css
  link(rel='stylesheet', href='/components/angular-toastr/dist/angular-toastr.css')

block hero_breadcrumb
  a.breadcrumb-item(ng-click="go('/home')")
    i.fas.fa-home.mr-1
    | Home
  a.breadcrumb-item(ng-click="go('/admin')") Admin
  a.breadcrumb-item(ng-click="go('/admin/' + competitionId)") {{competition.name}}
  span.breadcrumb-item.active Registration settings

block hero_title
  | {{competition.name}}

block hero_subtitle
  | {{"registration.title" | translate}}

block hero_actions
  button.btn-hero-action(type='button' ng-click='set()')
    i.fas.fa-save
    | {{"admin.settings.set" | translate}}

block main_content
  p.text-muted {{"registration.description" | translate}}

  .modern-card.mb-4
    .modern-card-header
      i.fas.fa-file-signature.mr-2
      | {{"registration.common" | translate}}
    .modern-card-body
      label.small.text-muted {{"registration.consentURL" | translate}}
      input.form-control(type='text' ng-model='competition.consentForm')

  .modern-card
    .modern-card-header
      i.fas.fa-trophy.mr-2
      | {{"registration.league" | translate}}
    .modern-card-body.p-0
      .table-responsive(style="padding: 0 1.5rem 1.5rem;")
        table.table-modern.table-auto
          thead
            tr
              th {{"common.league" | translate}}
              th {{"registration.open" | translate}}
              th {{"registration.deadline" | translate}}
              th {{"registration.passCode" | translate}}
              th(style="width: 90px;") URL
          tbody
            tr(ng-repeat='league in competition.registration')
              td.font-weight-bold(ng-bind='getLeagueName(league.league)')
              td
                select.custom-select.custom-select-sm(ng-model='league.enable' ng-style="{backgroundColor: league.enable ? '#bcffbc':'#ffcccc'}")
                  option(ng-value='true') {{"common.enable" | translate}}
                  option(ng-value='false') {{"common.disable" | translate}}
              td
                input.form-control.form-control-sm(type='datetime-local' step=1 ng-model='league.deadlineW' ng-style="{backgroundColor: deadlineColour(league.deadlineW)}")
              td
                input.form-control.form-control-sm(type='text' ng-model='league.passCode')
              td
                .btn-table-group
                  .btn-table-action(ng-click='copy(league.league)' uib-tooltip='Copy URL')
                    i.fas.fa-clipboard
