                      img.tile-image(ng-src='/images/phi_top.png', ng-show="cells[c+','+r+','+z].tile.victims.top == 'PHI'")
                      img.tile-image(ng-src='/images/phi_right.png', ng-show="cells[c+','+r+','+z].tile.victims.right == 'PHI'")
                      img.tile-image(ng-src='/images/phi_bottom.png', ng-show="cells[c+','+r+','+z].tile.victims.bottom == 'PHI'")
                      img.tile-image(ng-src='/images/phi_left.png', ng-show="cells[c+','+r+','+z].tile.victims.left == 'PHI'")
