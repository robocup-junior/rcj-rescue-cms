          i.fas.fa-square(style="color: #2980b9;", title="{{'maze.sign.blue' | translate}}")
          |  {{blueTilesVisited()}}
        .col
          i.fas.fa-child(title="{{'maze.sign.rescue' | translate}}")
          |  {{foundVictims}}
        .col
