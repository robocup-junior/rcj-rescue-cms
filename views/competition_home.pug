//- -*- tab-width: 2 -*-
extends includes/modern_layout

block vars
  - var ngAppDef = 'CompetitionHome'

append scripts
  script.
    var competitionId = "#{id}"
  script(src='/javascripts/competition_home.js')
  script(src='/components/cheet.js/cheet.min.js')

block hero_title_container
  .hero-logo-container(ng-if="competition.logo")
    img.comp-logo-hero(ng-src="{{competition.logo}}")
  h1.hero-title {{competition.name}}

block hero_extra
  .comp-message-box(ng-if="competition.message" style="max-width: 800px; margin-top: 1.5rem; padding: 1.25rem; background: rgba(255,255,255,0.05); border-radius: 1rem; border: 1px solid rgba(255,255,255,0.1);")
    h4(style="font-size: 0.9rem; font-weight: 800; text-transform: uppercase; opacity: 0.7; margin-bottom: 0.5rem;") {{'common.message' | translate}}
    p(ng-bind-html="competition.message" style="font-size: 1rem; opacity: 0.9; margin-bottom: 0;")

block main_content
  //- SECTION 1: LEAGUES (Unified Premium Style)
  .mb-5
    h3.text-heading-premium.mb-4(style="font-size: 1.5rem; display: flex; align-items: center;")
      i.fas.fa-trophy.mr-3(style="color: #f59e0b; font-size: 1.1rem;")
      | {{'admin.competition.leagues' | translate}}

    .row.league-grid-premium
      div(ng-repeat="league in leagues" class="col-md-6 col-lg-4 mb-4")
        .league-card-premium(ng-click="goLeaguePage(league)" ng-style="{'--league-color': league.color || (league.type == 'line' ? '#10b981' : (league.type == 'maze' ? '#3b82f6' : '#f59e0b'))}")
          img(ng-src="/images/leagues/{{leagueImage(league)}}.png")
          .card-overlay
          .league-accent
          i.fas.bg-icon(ng-class="{'fa-route': league.type=='line', 'fa-border-all': league.type=='maze', 'fa-desktop': league.type=='simulation'}")

          .card-content
            h4.league-name
              i.fas(ng-class="{'fa-route': league.type=='line', 'fa-border-all': league.type=='maze', 'fa-desktop': league.type=='simulation'}")
              | {{league.name}}
            .enter-label
              span {{'home.enterLeague' | translate}}
              i.fas.fa-chevron-right.ml-2

  //- SECTION 2: STAFF WORKSPACE
  if judge || interview
    .section-gap
      h3.text-heading-premium.mb-4(style="font-size: 1.5rem;")
        i.fas.fa-briefcase.mr-3(style="color: #6366f1;")
        | {{'home.staffWorkspace' | translate}}

      .row
        if judge
          .col-md-6.col-lg-4.mb-4
            a.tool-btn-home(ng-click="go('/home/' + competition._id + '/teams')")
              .tool-icon-home
                i.fas.fa-users
              div
                h6.tool-label.mb-1 {{'team_home.title' | translate}}
                p.tool-sublabel.mb-0 {{'home.manageTeamsDesc' | translate}}

          .col-md-6.col-lg-4.mb-4
            a.tool-btn-home(ng-click="go('/home/scanner/home')")
              .tool-icon-home
                i.fas.fa-qrcode
              div
                h6.tool-label.mb-1 {{'home.goScanner' | translate}}
                p.tool-sublabel.mb-0 {{'home.scannerDesc' | translate}}

        if interview
          .col-md-6.col-lg-4.mb-4
            a.tool-btn-home(ng-click="go('/document/assigned/' + competition._id)")
              .tool-icon-home
                i.fas.fa-file-signature
              div
                h6.tool-label.mb-1 {{'team_home.review' | translate}}
                p.tool-sublabel.mb-0 {{'home.reviewsDesc' | translate}}

  //- SECTION 3: ADMIN COMMANDS
  .admin-tools-container.section-gap(ng-if="secretCommand" style="padding-bottom: 8rem;")
    h4.text-heading-premium.mb-4(style="display: flex; align-items: center;")
      i.fas.fa-user-shield.mr-3(style="color: #ef4444; font-size: 1.1rem;")
      | {{'home.adminCommand' | translate}}

    .row
      .col-md-6.col-lg-4.mb-4
        a.tool-btn-home(ng-click="go('/signage/games/' + competition._id)")
          .tool-icon-home(style="background: #f8fafc; color: #1e293b;")
            i.fas.fa-desktop
          div
            h6.tool-label.mb-1 {{'home.runsMonitor' | translate}}
            p.tool-sublabel.mb-0 {{'home.runsMonitorDesc' | translate}}

      .col-md-6.col-lg-4.mb-4(ng-repeat="sign in signs")
        .tool-btn-home(style="flex-direction: column; align-items: stretch; cursor: default;")
          .d-flex.align-items-center.mb-4
            .tool-icon-home
              i.fas.fa-tv(style="color: #6366f1;")
            span.text-heading-premium(style="font-size: 1.1rem;") {{sign.name}}
          .d-flex.gap-3
            button.btn-premium.btn-premium-dark.flex-grow-1(ng-click="go('/signage/display/' + sign._id + '/0')")
              i.fas.fa-play
              | {{'home.signageOnly' | translate}}
            button.btn-premium.btn-premium-primary.flex-grow-1(ng-click="go('/signage/games/' + competition._id + '/' + sign._id + '/0')")
              i.fas.fa-columns
              | {{'home.dualView' | translate}}
