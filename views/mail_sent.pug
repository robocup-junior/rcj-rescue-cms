//- -*- tab-width: 2 -*-
extends includes/modern_layout

block vars
  - var ngAppDef = 'MailSent'
  - var heroContainerStyle = 'max-width: 1600px;'
  - var contentContainerStyle = 'max-width: 1600px;'

append scripts
  script.
    var competitionId = "#{id}"
  script(src='/javascripts/mail_sent.js?v=' + assetVersion)

block hero_breadcrumb
  a.breadcrumb-item(ng-click="go('/home')")
    i.fas.fa-home.mr-1
    | Home
  a.breadcrumb-item(ng-click="go('/admin')") Admin
  a.breadcrumb-item(ng-click="go('/admin/' + competition._id)") {{competition.name}}
  a.breadcrumb-item(ng-click="go('/admin/' + competition._id + '/mails')") Mail
  span.breadcrumb-item.active Sent

block hero_title
  | {{competition.name}}

block hero_subtitle
  | {{"mail.sent.title" | translate}}

block main_content
  .modern-card
    .modern-card-header
      .d-flex.justify-content-between.align-items-center.w-100
        div
          i.fas.fa-mail-bulk.mr-2
          | {{"mail.sent.title" | translate}}
        .btn-table-group
          .btn-table-action.primary(ng-click="showFilter = !showFilter" ng-class="showFilter ? 'active-blue' : ''" uib-tooltip="{{'common.refine' | translate}}")
            i.fas.fa-filter

    .filter-collapse(ng-show="showFilter" style="background: #f8fafc; border-bottom: 1px solid #f1f5f9; padding: 1.5rem;")
      .row
        .col-md-3.mb-2
          h6.font-weight-bold.text-muted.small.text-uppercase.mb-2 {{"mail.sent.subject" | translate}}
          .input-group
            .input-group-prepend
              span.input-group-text
                i.fas.fa-envelope
            input.form-control.form-control-sm(type='text' placeholder='{{"mail.sent.subject" | translate}}' ng-model='refineSubject')
        .col-md-2.mb-2
          h6.font-weight-bold.text-muted.small.text-uppercase.mb-2 {{"common.teamCode" | translate}}
          .input-group
            .input-group-prepend
              span.input-group-text
                i.fas.fa-hashtag
            input.form-control.form-control-sm(type='text' placeholder='{{"common.teamCode" | translate}}' ng-model='refineCode')
        .col-md-2.mb-2
          h6.font-weight-bold.text-muted.small.text-uppercase.mb-2 {{"common.team" | translate}}
          .input-group
            .input-group-prepend
              span.input-group-text
                i.fas.fa-users
            input.form-control.form-control-sm(type='text' placeholder='{{"common.team" | translate}}' ng-model='refineName')
        .col-md-2.mb-2
          h6.font-weight-bold.text-muted.small.text-uppercase.mb-2 {{"common.region" | translate}}
          .input-group
            .input-group-prepend
              span.input-group-text
                i.fas.fa-globe-asia
            input.form-control.form-control-sm(type='text' placeholder='{{"common.region" | translate}}' ng-model='refineRegion')
        .col-md-3.mb-2
          h6.font-weight-bold.text-muted.small.text-uppercase.mb-2 {{"common.league" | translate}}
          .filter-container
            span.filter-badge(ng-repeat='(key, value) in Rleagues track by key' ng-class="{'active': Rleagues[key]}" ng-click="Rleagues[key] = !Rleagues[key]") {{key}}

    .modern-card-body.p-0
      .table-responsive(style="padding: 0 1.5rem 1.5rem;")
        table.table-modern.table-auto
          thead
            tr
              th {{"mail.sent.time" | translate}}
              th {{"mail.sent.subject" | translate}}
              th {{"common.teamCode" | translate}}
              th {{"common.team" | translate}}
              th {{"common.region" | translate}}
              th {{"common.league" | translate}}
              th {{"mail.sent.status" | translate}}
              th(style="width: 90px;") {{"common.operation" | translate}}
          tbody
            tr(ng-repeat='mail in mails | filter:list_filter | orderBy:"[name]"')
              td.text-nowrap
                i.fas.fa-clock.mr-1.text-muted(ng-if="mail.reservation")
                | {{time(mail.time)}}
              td
                a(href="" ng-click="mailView(mail)" ng-bind="mail.subject")
              td(ng-bind='mail.team.teamCode')
              td.font-weight-bold(ng-bind='mail.team.name')
              td(ng-bind='mail.team.country')
              td(ng-bind='mail.team.league')
              td.text-nowrap
                span.status-dot(ng-style="{'background-color': statusColour(mail.status)}")
                | {{'mail.status.' + mail.status | translate}}
              td
                .btn-table-group
                  .btn-table-action(ng-click="detail(mail)" uib-tooltip='{{"mail.sent.detail" | translate}}')
                    i.fas.fa-envelope-open-text
