html(ng-app="ddApp")
  head
    title Rescue Line Judge
    script.
      var runId = "#{id}"
      var movie = ""

    include ../includes/common_component

    script(src="/javascripts/judge/line_2026.js?v=" + assetVersion)

    script(src="/javascripts/deflate.js?v=" + assetVersion)
    script(src="/components/jquery-qrcode/jquery.qrcode.min.js?v=" + assetVersion)
    script(src="/javascripts/makeQR.js?v=" + assetVersion)
    script(src="/javascripts/translate_config.js?v=" + assetVersion)
    script(src='/components/lightbox2/dist/js/lightbox.min.js?v=' + assetVersion)

    link(rel='stylesheet',href='/components/lightbox2/dist/css/lightbox.min.css?v=' + assetVersion)
    link(href="/stylesheets/fredrik.css?v=" + assetVersion rel="stylesheet")
    link(href="/stylesheets/line_view.css?v=" + assetVersion rel="stylesheet")

    meta(name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0")

  //- The judge page in the run pages' design (line_view.css), in red: first the run is checked
  //- with the team, then scored on the map, the LoPs, the rescue and the exit. Only what the judge
  //- operates is shown, not the points. The timer runs from the start to the end of the run, so it
  //- starts at the top of the page and stops only at its end, away from the scoring
  body.run-view.is-judge.rv-is-loading(ng-controller="ddController")
    include ../includes/line_loading
    header.rv-topbar
      button.rv-back(type='button' title="{{'common.back' | translate}}" ng-click="getParam('return')? go(getParam('return')):go('/line/' + competition._id + '/' + league)")
        i.fas.fa-arrow-left
      .rv-team
        //- Whether what was scored is on the server
        span.rv-sync(ng-class="networkError ? 'is-error' : (sync > 0 ? 'is-saving' : 'is-saved')" title="{{(networkError ? 'line.judge.networkError' : (sync > 0 ? 'line.judge.saving' : 'line.judge.saved')) | translate}}")
          i.fas(ng-class="networkError ? 'fa-exclamation-triangle' : (sync > 0 ? 'fa-sync fa-spin' : 'fa-cloud')")
        span.rv-team-name {{team.name}}
      .rv-topbar-stats
        .rv-stat.rv-stat-score
          i.fas.fa-calculator
          span.rv-stat-value {{score}}
          span.rv-stat-unit {{'common.point' | translate}}
        .rv-stat(ng-if='!startedTime')
          i.fas.fa-stopwatch
          span.rv-stat-value {{time | date:'m:ss'}}
        //- Running, the time is what stops it: in reach without scrolling, away from the scoring,
        //- and asked once more (the sheet below)
        button.rv-stat.rv-stat-stop(type='button' ng-if='startedTime' ng-click='askStop(true)' title="{{'line.judge.stopTimer' | translate}}")
          span.rv-live
          span.rv-stat-value {{time | date:'m:ss'}}
          span.rv-stop-label
            i.fas.fa-stop
            | {{'line.judge.tim_stop' | translate}}

    //- Before the run: the team, the round and the photos, checked one by one with the team
    main.rv-page.rv-judge-check(ng-if='!checked')
      p.rv-lead
        i.far.fa-check-circle
        |  {{'line.judge.before' | translate}}
      section.rv-card
        .rv-card-header
          i.fas.fa-info-circle
          | {{'line.judge.info' | translate}}
        .rv-checks
          button.rv-check(type='button' ng-class="{'is-ok': checkTeam}" ng-click='toggleCheckTeam()' aria-pressed='{{!!checkTeam}}')
            span.rv-check-mark
              i.fas(ng-class="checkTeam ? 'fa-check' : 'fa-question'")
            span.rv-check-label {{'common.team' | translate}}
            span.rv-check-value {{team.name}}
          button.rv-check(type='button' ng-class="{'is-ok': checkRound}" ng-click='toggleCheckRound()' aria-pressed='{{!!checkRound}}')
            span.rv-check-mark
              i.fas(ng-class="checkRound ? 'fa-check' : 'fa-question'")
            span.rv-check-label {{'common.round' | translate}}
            span.rv-check-value {{round}}
        dl.rv-facts
          div
            dt {{'common.competition' | translate}}
            dd {{competition.name}}
          div
            dt {{'common.field' | translate}}
            dd {{field}}
          div
            dt {{'common.league' | translate}}
            dd {{league}}
          div
            dt {{'common.rule' | translate}}
            dd #{rule}
      .rv-two-col
        button.rv-card.rv-photo-check(type='button' ng-class="{'is-ok': checkMember}" ng-click='toggleCheckMember()' aria-pressed='{{!!checkMember}}')
          .rv-card-header
            i.far.fa-images
            | {{'interview.me_pic' | translate}}
            span.rv-check-mark
              i.fas(ng-class="checkMember ? 'fa-check' : 'fa-question'")
          img(ng-src='/api/document/inspection/files/{{team._id}}/teamPhoto' alt='')
        button.rv-card.rv-photo-check(type='button' ng-class="{'is-ok': checkMachine}" ng-click='toggleCheckMachine()' aria-pressed='{{!!checkMachine}}')
          .rv-card-header
            i.far.fa-images
            | {{'interview.ma_pic' | translate}}
            span.rv-check-mark
              i.fas(ng-class="checkMachine ? 'fa-check' : 'fa-question'")
          img(ng-src='/api/document/inspection/files/{{team._id}}/robotPhoto' alt='')
      p.rv-note.rv-note-center(ng-show='!checks()') {{'line.judge.tap_red' | translate}}
      button.rv-submit(type='button' ng-click='infochecked()' ng-disabled='!checks()' ng-class="{'is-ready': checks()}")
        i.fas.fa-check-circle
        | {{'line.judge.confirm' | translate}}
      //- A team that does not come: its time runs from here
      section.rv-card.rv-noshow
        .rv-card-body
          p {{'line.judge.noShow' | translate}}
          button.rv-timer-btn(type='button' ng-click='toggleTime()' ng-class="{'is-running': startedTime}")
            i.fas(ng-class="startedTime ? 'fa-stop' : 'fa-play'")
            | {{(startedTime ? 'line.judge.tim_stop' : 'line.judge.tim_start') | translate}}

    //- The run: the map beside the LoPs, the rescue and the exit
    main.rv-page.rv-judge(ng-show='checked')
      .rv-alert(ng-show='networkError' role='alert')
        i.fas.fa-exclamation-triangle
        .rv-alert-body
          b {{'line.judge.networkError' | translate}}
          p {{'line.judge.networkErrorDescription' | translate}}
        button.rv-alert-action(type='button' ng-click='saveEverything()')
          i.fas.fa-redo
          |  {{'line.judge.reSend' | translate}}

      //- The timer is started here, and gone from here while it runs (the time in the bar stops
      //- it); stopped, it can be started again or reset
      section.rv-card.rv-timer-card(ng-if='!startedTime')
        .rv-timer-display
          i.fas.fa-stopwatch
          span.rv-timer-time {{time | date:'m:ss'}}
        .rv-timer-actions
          button.rv-timer-reset(type='button' ng-show='time != 0' ng-click='TimeReset()')
            i.fas.fa-undo
            span {{'line.judge.tim_reset' | translate}}
          button.rv-timer-btn(type='button' ng-click='toggleTime()' ng-class="{'is-blink': minutes < 8 && !fromSign}")
            i.fas.fa-play
            | {{'line.judge.tim_start' | translate}}

      .rv-judge-grid
        section.rv-card.rv-map.rv-judge-map#rv-items
          .rv-card-header
            i.fas.fa-map
            | {{'common.map' | translate}}
            .rv-map-tools
              .btn-group(ng-show='height > 1')
                //- The floors, after an icon that says what they are
                span.rv-tool.rv-tool-label(aria-hidden='true')
                  i.fas.fa-layer-group
                button.rv-tool(type='button' ng-repeat='zz in range(height)' ng-class='{active: zz == z}' ng-click='changeFloor(zz)')
                  | {{zz}}
              .btn-group
                button.rv-tool(type='button' title='-90°' ng-click='tileRot(-90)')
                  i.fas.fa-undo
                button.rv-tool(type='button' title='+90°' ng-click='tileRot(90)')
                  i.fas.fa-redo
          .rv-map-legend
            span.rv-key.is-done {{'line.view.tileDone' | translate}}
            span.rv-key.is-halfdone {{'line.view.tilePartial' | translate}}
            span.rv-key.is-undone {{'line.view.tileNone' | translate}}
            span.rv-key.is-cp {{'line.view.checkpoint' | translate}}
          //- A map without evacuation zone tiles (or another floor): the rescue from here instead
          button.rv-rescue-add(type='button' ng-if='!evacBox && EvacuationAreaLoPIndex >= 0' ng-click='openRescue()')
            span
              i.fas.fa-first-aid
              |  {{'line.judge.rescue' | translate}}
            span.rv-evac-rescues(ng-if='victim_list.length')
              span.rv-evac-victim(ng-repeat='v in victim_list track by $index' ng-class="v.zoneType == 'RED' ? 'is-red' : 'is-green'")
                img(ng-src="{{v.victimType == 'LIVE' ? '/images/liveVictim.png' : '/images/deadVictim.png'}}" alt='{{v.victimType}} {{v.zoneType}}')
          //- Tiles score only once the timer has run
          p.rv-map-hint(ng-if='time == 0')
            i.fas.fa-stopwatch
            |  {{'line.judge.push_timer' | translate}}
          .tilearea
            #wrapTile.mx-auto
              div(ng-repeat='r in range(length)', ng-if='sRotate==0', style='display: flex;')
                div(style='text-align:center;')
                  .slot(ng-repeat='c in range(width)')
                    tile(template='judge' tile="mtiles[c+','+r+','+z]", ng-click='doScoring(c,r,z)')
              div(ng-repeat='r in range(length)', ng-if='sRotate==180', style='display: flex;')
                .slot(ng-repeat='c in range(width)')
                  tile(template='judge' tile="mtiles[width - c -1+','+(length - r -1)+','+z]", ng-click='doScoring(width - c -1,length - r -1,z)')
              div(ng-repeat='r in range(width)', ng-if='sRotate==270', style='display: flex;')
                .slot(ng-repeat='c in range(length)')
                  tile(template='judge' tile="mtiles[width - r -1+','+c+','+z]", ng-click='doScoring(width-r-1,c,z)')
              div(ng-repeat='r in range(width)', ng-if='sRotate==90', style='display: flex;')
                .slot(ng-repeat='c in range(length)')
                  tile(template='judge' tile="mtiles[r+','+ (length - c-1) +','+z]", ng-click='doScoring(r,length-c-1,z)')
              //- Over the evacuation zone's tiles (evacBox, from tile_size): tapped to register a rescue.
              //- It shows the rescues so far, in order: each victim in the colour of its zone
              button.rv-evac-hit(type='button' ng-if='evacBox && EvacuationAreaLoPIndex >= 0' ng-style='evacBox' ng-click='openRescue()')
                span.rv-evac-label
                  i.fas.fa-first-aid
                  |  {{'line.judge.rescue' | translate}}
                span.rv-evac-rescues(ng-if='victim_list.length')
                  span.rv-evac-victim(ng-repeat='v in victim_list track by $index' ng-class="v.zoneType == 'RED' ? 'is-red' : 'is-green'")
                    img(ng-src="{{v.victimType == 'LIVE' ? '/images/liveVictim.png' : '/images/deadVictim.png'}}" alt='{{v.victimType}} {{v.zoneType}}')

        .rv-judge-side
          //- LoPs: a counter for each section of the course, from one checkpoint to the next
          section.rv-card#rv-lops
            .rv-card-header
              i.fas.fa-step-forward
              | {{'common.lops' | translate}}
              span.rv-header-total {{sum(LoPs)}} {{'common.times' | translate}}
            ol.rv-lop-list
              li.rv-lop-row(ng-repeat='cp in range(LoPs.length) track by $index' ng-class="{'is-evac': $index == EvacuationAreaLoPIndex, 'is-skip': LoPs[$index] >= 3 && !$last && !pastSection($index)}")
                //- The section in three columns, the same in every row so the checkpoints line up:
                //- where it starts, the way (with the evacuation zone's icon on it), where it ends
                .rv-lop-section
                  span.rv-lop-end
                    span.rv-sec.rv-sec-start(ng-if='$first')
                      i.fas.fa-play
                      | {{'line.judge.start' | translate}}
                    span.rv-sec.rv-sec-cp(ng-if='!$first' title="{{'line.view.checkpoint' | translate}} {{$index}}") C{{$index}}
                  span.rv-lop-way
                    span.rv-sec.rv-sec-ez(ng-if='$index == EvacuationAreaLoPIndex' title="{{'line.view.evacuation' | translate}}" aria-label="{{'line.view.evacuation' | translate}}")
                      i.fas.fa-ambulance
                  span.rv-lop-end
                    span.rv-sec.rv-sec-cp(ng-if='!$last' title="{{'line.view.checkpoint' | translate}} {{$index + 1}}") C{{$index + 1}}
                    span.rv-sec.rv-sec-exit(ng-if='$last')
                      i.fas.fa-flag-checkered
                      | {{'line.view.goal' | translate}}
                .rv-stepper
                  button.rv-step.is-minus(type='button' ng-click='decrement($index,$last)' ng-disabled='!LoPs[$index]' title='−1')
                    i.fas.fa-minus
                  span.rv-step-count(ng-class="{'is-zero': !LoPs[$index]}") {{LoPs[$index] ? LoPs[$index] : 0}}
                  button.rv-step.is-plus(type='button' ng-click='increment($index,$last)' title='+1')
                    i.fas.fa-plus
                //- From the third LoP of a section the team may skip to its checkpoint, unless it has
                //- moved on already
                p.rv-lop-skip(ng-if='LoPs[$index] >= 3 && !$last && !pastSection($index)' role='status')
                  i.fas.fa-forward
                  |  {{'line.judge.maySkip' | translate:{cp: 'C' + ($index + 1)} }}

          //- Exit bonus: one tap to switch
          section.rv-card#rv-exit
            .rv-card-header
              i.fas.fa-door-open
              | {{'line.judge.exit' | translate}}
            button.rv-exit.rv-exit-toggle(type='button' ng-click='changeExitBonus()' ng-class="{'is-ng': !exitBonus}" aria-pressed='{{!!exitBonus}}')
              .rv-exit-head
                .rv-exit-image(ng-class="exitBonus ? 'is-ok' : 'is-ng'")
                  img(src='/images/line_bonus.png', alt='')
                  span.rv-exit-mark
                    i.fas(ng-class="exitBonus ? 'fa-check' : 'fa-times'")
                .rv-exit-status
                  .rv-exit-title(ng-class="exitBonus ? 'is-ok' : 'is-ng'")
                    | {{(exitBonus ? 'line.view.exitDone' : 'line.view.exitNotDone') | translate}}
                  .rv-exit-formula
                    i.fas.fa-hand-pointer
                    |  {{'line.judge.tapToggle' | translate}}

      //- The end: the time as the referee timed it, then on to the sign page
      section.rv-card#rv-finish
        .rv-card-header
          i.fas.fa-flag-checkered
          | {{'line.judge.finish' | translate}}
        .rv-card-body
          //- The time as the referee timed it, a clock, m:ss, with an arrow above and below each part
          //- (as a phone's time picker); typed or stepped, locked while the timer runs. Beside it,
          //- room allowing, on to the sign page
          .rv-finish-row
            .rv-time-edit(title="{{'line.judge.runTime' | translate}}" ng-class="{'is-locked': startedTime}")
              .rv-time-field
                button.rv-time-step(type='button' ng-click="stepTime(60)" ng-disabled='startedTime' aria-label='+1 min')
                  i.fas.fa-chevron-up
                input.rv-time-input(type='text' inputmode='numeric' aria-label='min' ng-model='minutes' ng-class="{'is-one': ('' + minutes).length < 2}" ng-blur='tidyTime()' ng-disabled='startedTime' maxlength='2')
                button.rv-time-step(type='button' ng-click="stepTime(-60)" ng-disabled='startedTime' aria-label='−1 min')
                  i.fas.fa-chevron-down
              span.rv-time-colon :
              .rv-time-field
                button.rv-time-step(type='button' ng-click="stepTime(1)" ng-disabled='startedTime' aria-label='+1 sec')
                  i.fas.fa-chevron-up
                input.rv-time-input(type='text' inputmode='numeric' aria-label='sec' ng-model='seconds' rv-two-digits ng-blur='tidyTime()' ng-disabled='startedTime' maxlength='2')
                button.rv-time-step(type='button' ng-click="stepTime(-1)" ng-disabled='startedTime' aria-label='−1 sec')
                  i.fas.fa-chevron-down
            button.rv-submit(type='button' ng-click='confirm()' ng-disabled='startedTime || networkError' ng-class="{'is-ready': !startedTime && !networkError}")
              i.fas.fa-arrow-right
              | {{'line.judge.toSign' | translate}}

    //- Rescue, opened from the evacuation zone on the map: the victims taken to a zone together are
    //- picked first, then the zone, which registers them and closes the sheet; below, the rescues so
    //- far, each of which can be taken back
    .rv-overlay.is-send(ng-cloak ng-show='rescueOpen' role='dialog' aria-modal='true' aria-labelledby='rv-rescue-title')
      .rv-send-sheet
        .rv-pad-head
          i.fas.fa-first-aid
          span#rv-rescue-title {{'line.judge.rescue' | translate}}
          button.rv-pad-close(type='button' title="{{'line.judge.close' | translate}}" ng-click='closeRescue()')
            i.fas.fa-times
        .rv-rescue-input.rv-rescue-sheet
          .rv-victim-picks
            button.rv-victim-pick(type='button' ng-click="addVictimTmp('LIVE')" ng-disabled='count_victim_list("L") + count_victim_tmp("L") >= maxLiveVictims')
              img(src='/images/liveVictim.png' alt='')
              span.rv-pick-name {{'line.judge.live' | translate}}
              span.rv-pick-left {{'line.judge.victimsLeft' | translate:{n: maxLiveVictims - count_victim_list('L') - count_victim_tmp('L')} }}
            button.rv-victim-pick(type='button' ng-click="addVictimTmp('DEAD')" ng-disabled='count_victim_list("D") + count_victim_tmp("D") >= maxDeadVictims')
              img(src='/images/deadVictim.png' alt='')
              span.rv-pick-name {{'line.judge.dead' | translate}}
              span.rv-pick-left {{'line.judge.victimsLeft' | translate:{n: maxDeadVictims - count_victim_list('D') - count_victim_tmp('D')} }}
          .rv-staged(ng-if='victim_tmp.length > 0')
            .rv-staged-head
              span {{'line.judge.staged' | translate}}
              button.rv-staged-clear(type='button' ng-click='victim_tmp_clear()' title="{{'common.delete' | translate}}")
                i.far.fa-trash-alt
            .rv-staged-list
              button.rv-staged-victim(type='button' ng-repeat='v in victim_tmp track by $index' ng-click='delete_victim_tmp($index)')
                img(ng-src="{{v == 'LIVE' ? '/images/liveVictim.png' : '/images/deadVictim.png'}}" alt='{{v}}')
                i.fas.fa-times
            .rv-staged-head
              span {{'line.judge.toZone' | translate}}
            .rv-zone-picks
              button.rv-zone-pick.is-red(type='button' ng-click='victimRegist("RED")')
                img(src='/images/evacZone/red_lv2_a.png' alt='RED')
              button.rv-zone-pick.is-green(type='button' ng-click='victimRegist("GREEN")')
                img(src='/images/evacZone/green_lv2_a.png' alt='GREEN')
          //- The rescues so far, in order; each can be taken back
          .rv-rescues
            .rv-rescues-title
              | {{'line.view.rescuedVictims' | translate}}
              span.rv-rescues-count {{victim_list.length}}
            ol.rv-rescue-list(ng-if='victim_list.length')
              li.rv-rescue-item(ng-repeat='v in victim_list track by $index')
                span.rv-rescue-order {{$index + 1}}
                img.rv-victim(ng-src="{{v.victimType == 'LIVE' ? '/images/liveVictim.png' : '/images/deadVictim.png'}}" alt="{{v.victimType}}")
                i.fas.fa-long-arrow-alt-right.rv-lop-arrow
                span.rv-zone(ng-class="v.zoneType == 'RED' ? 'is-red' : 'is-green'")
                  img(ng-src="{{v.zoneType == 'RED' ? '/images/evacZone/red_lv2.png' : '/images/evacZone/green_lv2.png'}}" alt="{{v.zoneType}}")
                button.rv-rescue-del(type='button' ng-click='delete_victim($index)' title="{{'common.delete' | translate}}")
                  i.fas.fa-times

    //- Stopping the timer: the time of the first tap is what is recorded; kept running, the timer
    //- goes on
    .rv-overlay.is-send(ng-cloak ng-show='stopAsked' role='alertdialog' aria-modal='true' aria-labelledby='rv-stop-title')
      .rv-send-sheet
        .rv-pad-head
          i.fas.fa-stopwatch
          span#rv-stop-title {{'line.judge.stopConfirm' | translate}}
        .rv-stop-actions
          button.rv-stop-keep(type='button' ng-click='askStop(false)')
            span.rv-stop-choice {{'line.judge.keepRunning' | translate}}
            span.rv-stop-clock
              span.rv-live
              | {{time | date:'m:ss'}}
          button.rv-stop-now(type='button' ng-click='confirmStop()')
            span.rv-stop-choice
              i.fas.fa-stop
              |  {{'line.judge.stopAt' | translate:{t: (stopAt | date:'m:ss')} }}
            span.rv-stop-caption {{'line.judge.recordedTime' | translate}}

    //- The time of the run is up: the time recorded, then on to the sign page, or closed to look
    //- over the run first
    .rv-overlay.is-send(ng-cloak ng-show='timeUp' role='alertdialog' aria-modal='true' aria-labelledby='rv-timeup-title')
      .rv-send-sheet.rv-timeup-sheet
        .rv-pad-head
          i.fas.fa-flag-checkered
          span#rv-timeup-title {{'line.judge.timeUp' | translate}}
        .rv-timeup
          span.rv-timeup-clock {{time | date:'m:ss'}}
          span.rv-timeup-caption {{'line.judge.recordedTime' | translate}}
        .rv-stop-actions
          button.rv-stop-keep.rv-timeup-review(type='button' ng-click='closeTimeUp()')
            span.rv-stop-choice
              i.fas.fa-search
              |  {{'line.judge.reviewRun' | translate}}
            span.rv-stop-caption {{'line.judge.reviewRunNote' | translate}}
          button.rv-stop-now.rv-timeup-go(type='button' ng-click='confirm()' ng-disabled='networkError')
            span.rv-stop-choice
              | {{'line.judge.toSign' | translate}}
              |  
              i.fas.fa-arrow-right

    script(src="/javascripts/line_view.js?v=" + assetVersion)
