//- -*- tab-width: 2 -*-
extends includes/modern_layout

block vars
  - var ngAppDef = 'AdminUser'

append scripts
  script.
    var competitionId = "#{id}"
  script(src='/javascripts/admin_user.js?v=' + assetVersion)

block hero_breadcrumb
  a.breadcrumb-item(ng-click="go('/home')")
    i.fas.fa-home.mr-1
    | Home
  a.breadcrumb-item(ng-click="go('/admin')") Admin
  span.breadcrumb-item.active Users

block hero_title
  | {{"admin.users.title" | translate}}

block hero_subtitle
  | Admin

block main_content
  .modern-card.mb-4
    .modern-card-header
      i.fas.fa-user-plus.mr-2
      | {{"admin.users.add" | translate}}
    .modern-card-body
      .row
        .col-md-4
          .form-group
            label {{"common.name" | translate}}
            input.form-control(ng-model='userName')
        .col-md-4
          .form-group
            label {{"admin.users.password" | translate}}
            input.form-control(ng-model='userPass')
        .col-md-4
          .form-group
            label {{"admin.users.email" | translate}}
            input.form-control(ng-model='userEmail')
      .d-flex.flex-wrap.align-items-center(style="gap: 1.5rem;")
        .custom-control.custom-switch
          input.custom-control-input(type='checkbox' ng-model='userAuthSuper' id="checkSuper")
          label.custom-control-label(for="checkSuper") {{"admin.users.authoritySuper" | translate}}
        .custom-control.custom-switch
          input.custom-control-input(type='checkbox' ng-model='userAuthAdmin' id="checkAdmin")
          label.custom-control-label(for="checkAdmin") {{"admin.users.authorityAdmin" | translate}}
        .custom-control.custom-switch
          input.custom-control-input(type='checkbox' ng-model='emailNotification' id="checkEmailNotification")
          label.custom-control-label(for="checkEmailNotification") {{"admin.users.emailNotification" | translate}}
        .ml-auto
          button.btn.btn-premium-primary(ng-click='addUser()')
            i.fas.fa-plus.mr-2
            | {{"admin.users.add" | translate}}

  .modern-card
    .modern-card-header
      i.fas.fa-users-cog.mr-2
      | {{"admin.users.title" | translate}}
    .modern-card-body.p-0
      .table-responsive(style="padding: 0 1.5rem 1.5rem;")
        table.table-modern.table-auto
          thead
            tr
              th {{"admin.users.name" | translate}}
              th {{"admin.users.email" | translate}}
              th.text-center {{"admin.users.super" | translate}}
              th.text-center {{"admin.users.admin" | translate}}
              th(style="width: 120px;") {{"common.operation" | translate}}
          tbody
            tr(ng-repeat='user in users')
              td.font-weight-bold(ng-bind='user.username')
              td(ng-bind='user.displayEmail')
              td.text-center
                i.fas.fa-check-circle.text-success(ng-if="user.superDuperAdmin")
                i.fas.fa-times-circle.text-muted(ng-if="!user.superDuperAdmin")
              td.text-center
                i.fas.fa-check-circle.text-success(ng-if="user.admin")
                i.fas.fa-times-circle.text-muted(ng-if="!user.admin")
              td
                .btn-table-group
                  .btn-table-action.danger(ng-click='removeUser(user)' uib-tooltip='{{"common.delete" | translate}}')
                    i.fas.fa-trash-alt
