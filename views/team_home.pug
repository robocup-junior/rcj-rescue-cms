//- -*- tab-width: 2 -*-
extends includes/modern_layout

block vars
  - var ngAppDef = 'TeamHome'

append scripts
  script.
    var competitionId = "#{id}"
  script(src='/javascripts/team_home.js')

block hero_breadcrumb
  a.breadcrumb-item(ng-click="go('/home')") Home
  a.breadcrumb-item(ng-click="go('/home/' + competition._id)") {{competition.name}}
  span.breadcrumb-item.active Teams

block hero_title
  | {{competition.name}}

block hero_subtitle
  i.fas.fa-users.mr-2
  | {{"team_home.title" | translate}}

block main_content
  h5.section-heading.mb-2
    i.fas.fa-search
    | {{'common.refine' | translate}}
  .modern-card
    .modern-card-body
      .row
        .col-md-4
          .settings-group
            label.settings-label {{"common.teamCode" | translate}}
            input.premium-input(type='text', ng-model='refineCode')
        .col-md-4
          .settings-group
            label.settings-label {{"common.team" | translate}}
            input.premium-input(type='text', ng-model='refineName')
        .col-md-4
          .settings-group
            label.settings-label {{"common.region" | translate}}
            input.premium-input(type='text', ng-model='refineRegion')
      .settings-group.mb-0
        label.settings-label {{"common.league" | translate}}
        .toolbar-actions(style="flex-wrap: wrap;")
          span(ng-repeat='(key, value) in Rleagues track by key')
            input(type='checkbox' ng-model='Rleagues[key]' id="checkL_{{key}}")
            label.checkbox(for="checkL_{{key}}") &nbsp;{{key}}

  .modern-table-card(ng-if="!isSmartPhone()")
    table.custom
      thead
        tr
          th {{"common.teamCode" | translate}}
          th {{"common.team" | translate}}
          th {{"common.region" | translate}}
          th {{"common.league" | translate}}
          th {{"common.inspected" | translate}}
          th {{'common.operation' | translate}}
      tbody
        tr(ng-repeat='team in teams | filter:list_filter | orderBy:"[teamCode, name]"')
          td(ng-bind='team.teamCode')
          td(ng-bind='team.name')
          td(ng-bind='team.country')
          td(ng-bind='team.league')
          td
            i(class="fa fa-2x fa-check" aria-hidden="true" style="color:#2ecc71;" ng-if="team.inspected")
            i(class="fa fa-2x fa-times" aria-hidden="true" style="color:#e74c3c;" ng-if="!team.inspected")
          td
            .toolbar-actions
              if judge
                button.btn-table-action(type='button', ng-click="go('/document/inspection/' + team._id)")
                  i.fas.fa-ruler-combined
                  | {{"common.inspection" | translate}}
              button.btn-table-action(type='button', ng-click="go('/document/public/' + team._id)", ng-if="team.document.public")
                i.fas.fa-file-alt
                | {{"team_home.document" | translate}}
              if view
                button.btn-table-action(type='button', ng-click="go('/document/reviewed/' + team._id + '?return=/home/' + team.competition + '/teams')")
                  i.fas.fa-file-alt
                  | {{"team_home.result" | translate}}

  .document-card(style='width: 100%;' ng-repeat='team in teams | filter:list_filter | orderBy:"[teamCode, name]"' ng-if="isSmartPhone()")
    .document-card-body
      h5.mb-1 {{team.teamCode}} {{team.name}}
      h6.mb-2.text-muted
        span.badge(style="margin:0 5px 0 5px;color:#444;" ng-style="{backgroundColor: leagueColor(team.league)}") {{team.league}}
        span.badge.badge-success(ng-if="team.inspected" style="margin:0 5px 0 5px;") {{"common.inspected" | translate}}&nbsp;
          i(class="fa fa-check" aria-hidden="true" style="color:#fff;")
        span.badge.badge-danger(ng-if="!team.inspected" style="margin:0 5px 0 5px;") {{"common.inspected" | translate}}&nbsp;
          i(class="fa fa-times" aria-hidden="true" style="color:#fff;")
        span(ng-show="team.country")
          i.fas.fa-globe-asia &nbsp;
          span {{team.country}}

      .toolbar-actions(style="flex-wrap: wrap;")
        button.btn-table-action(type='button', ng-click="go('/document/public/' + team._id)", ng-if="team.document.public")
          i.fas.fa-file-alt
          | {{"team_home.document" | translate}}
        if judge
          button.btn-table-action(type='button', ng-click="go('/document/review/' + team._id + '?return=/home/' + team.competition + '/teams')")
            i.fas.fa-file-alt
            | {{"team_home.review" | translate}}
        if view
          button.btn-table-action(type='button', ng-click="go('/document/reviewed/' + team._id + '?return=/home/' + team.competition + '/teams')")
            i.fas.fa-file-alt
            | {{"team_home.result" | translate}}
