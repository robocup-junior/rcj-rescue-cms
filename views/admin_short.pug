//- -*- tab-width: 2 -*-
extends includes/modern_layout

block vars
  - var ngAppDef = 'AdminShort'

append scripts
  script.
    var sigId = "#{id}"
  script(src="/javascripts/admin_short.js")

block hero_breadcrumb
  a.breadcrumb-item(ng-click="go('/home')")
    i.fas.fa-home.mr-1
    | Home
  a.breadcrumb-item(ng-click="go('/admin')") Admin
  span.breadcrumb-item.active URL Shorting Setting

block hero_title
  | {{"admin.shortURL.title" | translate}}

block hero_subtitle
  | {{"admin.shortURL.description" | translate}}

block main_content
  .modern-card.mb-4
    .modern-card-header
      i.fas.fa-plus-circle.mr-2
      | {{"admin.shortURL.title" | translate}}
    .modern-card-body
      .row
        .col-md-3
          .form-group
            label {{"admin.shortURL.name" | translate}}
            input.form-control(type='text' ng-model='name')
        .col-md-3
          .form-group
            label {{"admin.shortURL.short" | translate}}
            .input-group
              .input-group-prepend
                span.input-group-text {{urlHead}}
              input.form-control(type='text' ng-model='short')
        .col-md-5
          .form-group
            label {{"admin.shortURL.original" | translate}}
            input.form-control(type='text' ng-model='transfer')
        .col-md-1.d-flex.align-items-end
          .form-group.w-100
            button.btn.btn-premium-primary.w-100(type='button' ng-click='set()')
              i.fas.fa-check

  .modern-card
    .modern-card-header
      i.fas.fa-link.mr-2
      | {{"admin.shortURL.title" | translate}}
    .modern-card-body.p-0
      .table-responsive(style="padding: 0 1.5rem 1.5rem;")
        table.table-modern.table-auto
          thead
            tr
              th {{"admin.shortURL.name" | translate}}
              th {{"admin.shortURL.short" | translate}}
              th {{"admin.shortURL.original" | translate}}
              th(style="width: 120px;") {{"common.operation" | translate}}
          tbody
            tr(ng-repeat="content in list track by $index")
              td.font-weight-bold {{content.name}}
              td {{urlHead}}{{content.shorted}}
              td.small {{content.transfer}}
              td
                .btn-table-group
                  .btn-table-action.danger(ng-click='del(content._id)' uib-tooltip='{{"common.delete" | translate}}')
                    i.fas.fa-trash-alt
