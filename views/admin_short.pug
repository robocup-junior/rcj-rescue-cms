//- -*- tab-width: 2 -*-
extends includes/modern_layout

block vars
  - var ngAppDef = 'AdminShort'

append scripts
  script.
    var sigId = "#{id}"
  script(src="/javascripts/admin_short.js")

append css
  link(href='/stylesheets/common/modern_editor.css', rel='stylesheet')

block hero_breadcrumb
  a.breadcrumb-item(ng-click="go('/home')") Home
  a.breadcrumb-item(ng-click="go('/admin')") Admin
  span.breadcrumb-item.active URL Shorting Setting

block hero_title
  | {{"admin.shortURL.title" | translate}}

block main_content
  .modern-card
    .modern-card-body
      p.text-body-premium {{"admin.shortURL.description" | translate}}
      .row
        .col-md-4
          .settings-group
            label.settings-label {{"admin.shortURL.name" | translate}}
            input.premium-input(type='string', ng-model='name')
        .col-md-4
          .settings-group
            label.settings-label {{"admin.shortURL.short" | translate}}: {{urlHead}}
            input.premium-input(type='string', ng-model='short')
        .col-md-4
          .settings-group
            label.settings-label {{"admin.shortURL.original" | translate}}
            input.premium-input(type='text', ng-model='transfer')
      button.btn-premium.btn-premium-primary(type='button', ng-click='set()')
        i.fas.fa-check
        | {{"admin.settings.set" | translate}}

  h5.section-heading.section-gap.mb-2
    i.fas.fa-list
    | Existing URLs
  .modern-table-card
    table.custom
      thead
        tr
          th {{"admin.shortURL.name" | translate}}
          th {{"admin.shortURL.short" | translate}}
          th {{"admin.shortURL.original" | translate}}
          th {{"common.operation" | translate}}
      tbody
        tr(ng-repeat="content in list track by $index")
          td(ng-bind="content.name")
          td {{urlHead}}{{content.shorted}}
          td(ng-bind="content.transfer")
          td
            button.icon-btn-premium.danger(type='button', ng-click='del(content._id)')
              i.fas.fa-times
