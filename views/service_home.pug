//- -*- tab-width: 2 -*-
extends includes/layout

block vars
  - var ngAppDef = 'Home'
  - var hideLogin = true

append scripts
  script(src='/javascripts/home.js')
  script.
    navigator.serviceWorker.getRegistrations().then(function(registrations) {
      for(let registration of registrations) {
        registration.unregister()
      } 
    })

append css
  link(href="/stylesheets/fonts.css" rel="stylesheet")
  link(rel='stylesheet', href='/stylesheets/home_premium.css')
  link(rel='stylesheet', href='/stylesheets/competition_premium.css')

block bread
  // Breadcrumbs removed to match home page style

block content
  .home-hero
    .hero-content
      img.hero-logo(src="/images/logo.png", alt="RCJ Logo")
      .hero-text-wrapper
        h1.hero-title RoboCupJunior CMS 2026
      
      .hero-info-capsule(ng-cloak)
        p {{'service_home.about' | translate}}

  .comp-container
    .league-grid
      //- Line Map Editor 2025
      .league-card(ng-click="go('/service/editor/line/2025')")
        .card-accent(style="background-color: #2ecc71;")
        .league-image-area
          img(src="/images/lineEditor.png", alt='Line 2025')
        .league-body
          h3.league-name(style="color: #27ae60;") Line Map Editor 2025
          .btn-enter-premium
            i.fas.fa-arrow-right
            | {{'admin.lineMapEditor.title' | translate}}

      //- Line Map Editor 2026
      .league-card(ng-click="go('/service/editor/line/2026')")
        .card-accent(style="background-color: #2ecc71;")
        .league-image-area
