//- -*- tab-width: 2 -*-
extends ../includes/modern_layout

block vars
  - var ngAppDef = 'MyPage'

append scripts
  script(src='/javascripts/mypage.js')

block hero_title_container
  h1.hero-title
    | #{user.username}

block hero_subtitle
  | {{"common.mypage" | translate}}

block main_content
  h5.section-heading.mb-2
    i.fas.fa-id-card
    | {{"mypage.profile" | translate}}
  .modern-card
    .modern-card-body
      .row
        .col-md-6
          .settings-group.mb-0
            label.settings-label {{"admin.users.name" | translate}}
            p.text-heading-premium.mb-0 #{user.username}
        .col-md-6
          .settings-group.mb-0
            label.settings-label {{"admin.users.email" | translate}}
            p.text-heading-premium.mb-0 #{(user && user.email) ? user.email : 'N/A'}

  h5.section-heading.section-gap.mb-2
    i.fas.fa-shield-alt
    | {{"mypage.changePassword" | translate}}
  .modern-card
    .modern-card-body
      .settings-group(style="display: flex; align-items: center; gap: 0.75rem; background: #eff6ff; border-radius: 12px; padding: 1rem;")
        i.fas.fa-info-circle
        span {{"mypage.passwordRule" | translate}}

      form(ng-submit="changePassword()")
        .settings-group
          label.settings-label {{"mypage.currentPassword" | translate}}
          input.premium-input(type="password" ng-model="pass.current" placeholder="••••••••" required)

        .row
          .col-md-6
            .settings-group
              label.settings-label {{"mypage.newPassword" | translate}}
              input.premium-input(type="password" ng-model="pass.new" ng-change="checkPassword()" placeholder="••••••••" required)
              .mt-2(ng-if="pass.new")
                .progress(style="height: 6px; border-radius: 4px;")
                  .progress-bar(role="progressbar" ng-style="{'width': strengthWidth, 'background-color': strengthColor}")
                small.d-block.mt-1(ng-style="{'color': strengthColor}" ng-bind="strengthText")
          .col-md-6
            .settings-group
              label.settings-label {{"mypage.confirmPassword" | translate}}
              input.premium-input(type="password" ng-model="pass.confirm" ng-change="checkPassword()" placeholder="••••••••" required)
              small.text-danger.mt-2.d-block(ng-if="pass.new != pass.confirm && pass.confirm")
                i.fas.fa-exclamation-triangle.mr-1
                | {{"mypage.passwordMismatch" | translate}}

        .text-right
          button.btn-premium.btn-premium-primary(type="submit" ng-disabled="!validPassword || pass.new != pass.confirm")
            i.fas.fa-check-circle
            | {{"common.save" | translate}}
