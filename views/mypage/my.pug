//- -*- tab-width: 2 -*-
extends ../includes/layout

block vars
  - var ngAppDef = 'MyPage'

append scripts
  script.
    var competitionId = "#{competition}"
    var leagueId = "#{league}"
    var teamId = "#{team}"
    var token = "#{token}"
    var teamDocDeadline = "#{documentDeadline}"
  script(src='/components/angular-toastr/dist/angular-toastr.tpls.min.js')
  script(src='/javascripts/mypage/my.js')

append css
  link(rel='stylesheet', href='/components/angular-toastr/dist/angular-toastr.css')
  link(href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet")
  link(rel='stylesheet', href='/stylesheets/my_premium.css')
  style.
    /* Custom icon backgrounds to restore theme colors while staying premium */
    .bg-survey { background: rgba(5, 196, 107, 0.1); color: #05c46b; }
    .bg-document { background: rgba(10, 189, 227, 0.1); color: #0abde3; }
    .bg-reservation { background: rgba(255, 107, 107, 0.1); color: #ff6b6b; }
    .bg-cabinet { background: rgba(254, 202, 87, 0.1); color: #feca57; }

    /* Hide Login/User menu */
    .login-btn, .nav-user-link.dropdown-toggle {
      display: none !important;
    }

block bread
  // Breadcrumbs removed as requested

block content
  .mesh-header
    .premium-container
      .header-content
        .comp-logo-wrapper
          img.comp-logo(ng-src="{{competition.logo}}", alt='')
        h1.header-title {{competition.name}}
        p.header-subtitle {{leagueName}}
        .team-badge
          i.fas.fa-users
          span #{teamCode} #{teamName}

  .premium-container
    .dashboard-grid
      // Surveys
      a.glass-card(ng-repeat="surv in survey", ng-click="goSurv(surv._id)", target="_blank")
        span.card-status.status-editable(ng-if="surv.editable", title="{{'common.enable' | translate}}")
          i.fas.fa-pen
        span.card-status.status-locked(ng-if="!surv.editable", title="{{'mypage.locked' | translate}}")
          i.fas.fa-lock
        .card-icon-bg.bg-survey
          i.fas.fa-question-circle
        h3.card-title(ng-bind="surv.name")
        p.card-desc(ng-bind="surv.myDescription")

      // Documents
      if documentEnable
        a.glass-card(ng-if="competition.documents.enable", href=`/document/${team}/${token}`, target="_blank")
          span.card-status.status-editable(ng-if="docEditable", title="{{'common.enable' | translate}}")
            i.fas.fa-pen
          span.card-status.status-locked(ng-if="!docEditable", title="{{'mypage.locked' | translate}}")
            i.fas.fa-lock
          .card-icon-bg.bg-document
            i.fas.fa-book
          h3.card-title {{"document.admin.title" | translate}}
          p.card-desc {{"mypage.document" | translate}}

      // Reservations
      a.glass-card(ng-repeat="resv in reservations", ng-click="goResv(resv._id)", target="_blank")
        span.card-status.status-editable(ng-if="resv.editable", title="{{'common.enable' | translate}}")
          i.fas.fa-pen
        span.card-status.status-locked(ng-if="!resv.editable", title="{{'mypage.locked' | translate}}")
          i.fas.fa-lock
        .card-icon-bg.bg-reservation
          i.fas.fa-calendar-day
        h3.card-title(ng-bind="resv.name")
        p.card-desc(ng-bind="resv.myDescription")

      // Cabinet
      a.glass-card(href=`/mypage/${team}/${token}/cabinet`, target="_blank")
        .card-icon-bg.bg-cabinet
          i.fas.fa-archive
        h3.card-title {{"cabinet.title" | translate}}
        p.card-desc {{"mypage.cabinet" | translate}}

    // Messages Section
    .message-section(ng-show="mails.length>0")
      .message-header
        i.fas.fa-envelope-open-text
        h2 {{"mypage.message" | translate}}
      
      .message-list
        .message-item(ng-repeat='mail in mails', ng-click="mailView(mail)")
          .message-info
            .message-subject(ng-bind="mail.subject")
            .message-date(ng-bind="time(mail.time)")
          .message-arrow
            i.fas.fa-chevron-right