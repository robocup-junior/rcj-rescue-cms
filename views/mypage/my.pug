//- -*- tab-width: 2 -*-
extends ../includes/modern_layout

block vars
  - var ngAppDef = 'MyPage'

append scripts
  script.
    var competitionId = "#{competition}"
    var leagueId = "#{league}"
    var teamId = "#{team}"
    var token = "#{token}"
    var teamDocDeadline = "#{documentDeadline}"
  script(src='/components/angular-toastr/dist/angular-toastr.tpls.min.js')
  script(src='/javascripts/mypage/my.js')

append css
  link(rel='stylesheet', href='/components/angular-toastr/dist/angular-toastr.css')
  style.
    .login-btn, .nav-user-link.dropdown-toggle {
      display: none !important;
    }

block hero_title_container
  img.hero-logo(ng-if="competition.logo" ng-src="{{competition.logo}}" style="max-height: 60px; margin-bottom: 0.75rem;")
  h1.hero-title
    | {{competition.name}}

block hero_subtitle
  | {{leagueName}}

block hero_actions
  .team-badge(style="display: flex; align-items: center; gap: 0.5rem; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); border-radius: 1rem; padding: 0.6rem 1.1rem; color: white; font-weight: 700;")
    i.fas.fa-users
    span #{teamCode} #{teamName}

block main_content
  .row
    a.action-card-character.hover-lift.col-md-4.mb-2(ng-repeat="surv in survey", ng-click="goSurv(surv._id)" style="padding: 1rem; position: relative; overflow: hidden; display: block;")
      div(style="position: absolute; top: 0; left: 0; width: 100%; height: 6px; background: #05c46b;")
      span(ng-if="surv.editable" style="position: absolute; top: 1rem; right: 1rem; background: #dcfce7; color: #166534; width: 30px; height: 30px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.8rem;")
        i.fas.fa-pen
      span(ng-if="!surv.editable" style="position: absolute; top: 1rem; right: 1rem; background: #f1f5f9; color: #64748b; width: 30px; height: 30px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.8rem;")
        i.fas.fa-lock
      .icon-box-premium.mb-2(style="background: rgba(5, 196, 107, 0.1); color: #05c46b; width: 42px; height: 42px; border-radius: 10px;")
        i.fas.fa-question-circle(style="font-size: 1.2rem;")
      h6.text-heading-premium.mb-1(style="font-size: 1rem;") {{surv.name}}
      p.text-body-premium.mb-0(ng-bind="surv.myDescription" style="font-size: 0.8rem; line-height: 1.2;")

    if documentEnable
      a.action-card-character.hover-lift.col-md-4.mb-2(ng-if="competition.documents.enable", href=`/document/${team}/${token}`, target="_blank" style="padding: 1rem; position: relative; overflow: hidden; display: block;")
        div(style="position: absolute; top: 0; left: 0; width: 100%; height: 6px; background: #0abde3;")
        span(ng-if="docEditable" style="position: absolute; top: 1rem; right: 1rem; background: #dcfce7; color: #166534; width: 30px; height: 30px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.8rem;")
          i.fas.fa-pen
        span(ng-if="!docEditable" style="position: absolute; top: 1rem; right: 1rem; background: #f1f5f9; color: #64748b; width: 30px; height: 30px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.8rem;")
          i.fas.fa-lock
        .icon-box-premium.mb-2(style="background: rgba(10, 189, 227, 0.1); color: #0abde3; width: 42px; height: 42px; border-radius: 10px;")
          i.fas.fa-book(style="font-size: 1.2rem;")
        h6.text-heading-premium.mb-1(style="font-size: 1rem;") {{"document.admin.title" | translate}}
        p.text-body-premium.mb-0(style="font-size: 0.8rem; line-height: 1.2;") {{"mypage.document" | translate}}

    a.action-card-character.hover-lift.col-md-4.mb-2(ng-repeat="resv in reservations", ng-click="goResv(resv._id)" style="padding: 1rem; position: relative; overflow: hidden; display: block;")
      div(style="position: absolute; top: 0; left: 0; width: 100%; height: 6px; background: #ff6b6b;")
      span(ng-if="resv.editable" style="position: absolute; top: 1rem; right: 1rem; background: #dcfce7; color: #166534; width: 30px; height: 30px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.8rem;")
        i.fas.fa-pen
      span(ng-if="!resv.editable" style="position: absolute; top: 1rem; right: 1rem; background: #f1f5f9; color: #64748b; width: 30px; height: 30px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.8rem;")
        i.fas.fa-lock
      .icon-box-premium.mb-2(style="background: rgba(255, 107, 107, 0.1); color: #ff6b6b; width: 42px; height: 42px; border-radius: 10px;")
        i.fas.fa-calendar-day(style="font-size: 1.2rem;")
      h6.text-heading-premium.mb-1(style="font-size: 1rem;") {{resv.name}}
      p.text-body-premium.mb-0(ng-bind="resv.myDescription" style="font-size: 0.8rem; line-height: 1.2;")

    a.action-card-character.hover-lift.col-md-4.mb-2(href=`/mypage/${team}/${token}/cabinet`, target="_blank" style="padding: 1rem; position: relative; overflow: hidden; display: block;")
      div(style="position: absolute; top: 0; left: 0; width: 100%; height: 6px; background: #feca57;")
      .icon-box-premium.mb-2(style="background: rgba(254, 202, 87, 0.1); color: #feca57; width: 42px; height: 42px; border-radius: 10px;")
        i.fas.fa-archive(style="font-size: 1.2rem;")
      h6.text-heading-premium.mb-1(style="font-size: 1rem;") {{"cabinet.title" | translate}}
      p.text-body-premium.mb-0(style="font-size: 0.8rem; line-height: 1.2;") {{"mypage.cabinet" | translate}}

  div(ng-show="mails.length>0")
    h5.section-heading.section-gap.mb-2
      i.fas.fa-envelope-open-text
      | {{"mypage.message" | translate}}
    .modern-list
      .modern-item-card(ng-repeat='mail in mails', ng-click="mailView(mail)")
        .modern-item-info
          .modern-item-icon
            i.fas.fa-envelope
          .modern-item-details
            span.modern-item-name(ng-bind="mail.subject")
            span.text-body-premium(ng-bind="time(mail.time)")
        .modern-item-actions
          i.fas.fa-chevron-right
