//- -*- tab-width: 2 -*-
extends includes/modern_layout

block vars
  - var ngAppDef = 'MailTemplates'

append scripts
  script.
  script(src='/javascripts/mail_templates.js')

block hero_breadcrumb
  a.breadcrumb-item(ng-click="go('/home')") Home
  a.breadcrumb-item(ng-click="go('/admin')") Admin
  span.breadcrumb-item.active Mail Templates

block hero_title
  | {{"admin.mailTemplates.title" | translate}}

block hero_actions
  button.btn-premium.btn-premium-dark(onclick="location.href='/admin/mailTemplates/editor'")
    i.fas.fa-plus
    | {{"admin.mailTemplates.create" | translate}}

block main_content
  p.text-body-premium {{"admin.mailTemplates.4duplicate" | translate}}

  .modern-table-card
    table.custom
      thead
        tr
          th {{"admin.mailTemplates.subject" | translate}}
          th {{"common.operation" | translate}}
      tbody
        tr(ng-repeat='mail in mails')
          td
            a(ng-bind='mail.name')
          td
            button.btn-table-action(type='button', ng-click='go("/admin/mailTemplates/editor/"+mail.name)' style="margin-right:10px;")
              i.fas.fa-edit
              | {{"admin.mailTemplates.edit" | translate}}
            button.btn-table-action(type='button', ng-click='removeTemplate(mail)', ng-if="deleteable(mail.name)")
              i.fas.fa-trash
              | {{"common.delete" | translate}}
