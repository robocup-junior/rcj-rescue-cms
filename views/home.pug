//- -*- tab-width: 2 -*-
extends includes/layout

block vars
  - var ngAppDef = 'Home'

append scripts
  script(src='/javascripts/home.js')
  script.
    navigator.serviceWorker.getRegistrations().then(function(registrations) {
      for(let registration of registrations) {
        registration.unregister()
      } 
    })

append css
  link(href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800&display=swap" rel="stylesheet")
  link(rel='stylesheet', href='/stylesheets/home_premium.css')

block bread
  // Breadcrumbs removed as requested

block content
  .home-hero
    .hero-content
      img.hero-logo(src="/images/logo.png", alt="RCJ Logo")
      .hero-text-wrapper
        h1.hero-title RoboCupJunior CMS 2026
      
      .hero-info-capsule(ng-cloak)
        i.fas.fa-info-circle
        p {{'home.about' | translate}}

  .comp-container
    .comp-grid
      a.comp-card(ng-repeat='competition in competitions', ng-click="go('/home/' + competition._id)")
        //- Card top accent using competition theme color
        div(style="position: absolute; top: 0; left: 0; width: 100%; height: 6px; z-index: 10;" ng-style="{'backgroundColor': '#' + (competition.bkColor || '3b82f6')}")
        
        .comp-logo-area
          img.comp-logo(ng-src="{{competition.logo}}", alt='')
        
        .comp-body
          h3.comp-name(ng-style="{'color': '#' + (competition.bkColor || '0f172a')}" ng-cloak) {{competition.name}}
          p.comp-desc(ng-if="competition.description", ng-bind-html="competition.description")

    if typeof(user) != "undefined" && !user.admin
      .access-info
        i.fas.fa-user-shield.mr-2
        span(translate="home.access_level", translate-values='{account: "'+ user.username + '"}')
