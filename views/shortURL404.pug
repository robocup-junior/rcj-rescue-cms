//- -*- tab-width: 2 -*-
extends includes/layout

block vars
  - var ngAppDef = 'AD'

append scripts
  script(src='/javascripts/access_denied.js?v=' + assetVersion)

append css
  link(href="/stylesheets/fonts.css?v=" + assetVersion rel="stylesheet")
  link(rel='stylesheet', href='/stylesheets/error_premium.css?v=' + assetVersion)

block bread

block content
  .error-page(ng-cloak)
    .error-card.denied-card
      .robot-container.denied-robot.lost-robot(aria-hidden="true")
        .robot-question ?
        .robot
          .robot-head
            .robot-ear.ear-left
            .robot-ear.ear-right
            .eye
            .eye
          .robot-body
            .robot-lock
              i.fas.fa-link
            .robot-arm.arm-left
            .robot-arm.arm-right
              .stop-sign
                i.fas.fa-search
            .robot-leg.leg-left
            .robot-leg.leg-right

      .error-status 404
      h1.error-message-title {{"shortURL404.title" | translate}}
      p.error-message-detail
        | {{"shortURL404.description1" | translate}}
        br
        small {{"shortURL404.description2" | translate}}

      .error-actions
        button.btn-home.btn-secondary-action(type="button" ng-click="back()")
          i.fas.fa-undo
          | {{'common.back' | translate}}
        a.btn-home(href="/home")
          i.fas.fa-home
          | {{"common.backHome" | translate}}
