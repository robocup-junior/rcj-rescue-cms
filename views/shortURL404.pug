//- -*- tab-width: 2 -*-
extends includes/modern_layout

block vars
  - var ngAppDef = 'AD'

append scripts
  script(src='/javascripts/access_denied.js')

block hero_breadcrumb
  a.breadcrumb-item(ng-click="go('/home')") Home
  span.breadcrumb-item.active 404 Not Found

block hero_title
  | {{"shortURL404.title" | translate}}

block main_content
  .empty-state
    i.fas.fa-trash-alt
    h2 {{"shortURL404.description1" | translate}}
    p {{"shortURL404.description2" | translate}}
    button.btn-premium.btn-premium-dark(onclick="location.href=document.referrer")
      i.fas.fa-undo
      | {{'common.back' | translate}}
