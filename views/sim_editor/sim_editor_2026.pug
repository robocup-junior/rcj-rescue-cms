//- -*- tab-width: 2 -*-
extends ../includes/modern_layout

block vars
  - var ngAppDef = 'SimEditor'
  - var heroContainerStyle = "max-width: 100%;"
  - var contentContainerStyle = "max-width: 100%;"

append scripts
  script.
    var mapId = "#{mapid}"
    var competitionId = "#{compid}"
    var pubService = "#{pubService}"

  script(src="/javascripts/lvl-uuid.js")
  script(src="/javascripts/sim_editor/sim_editor.2026.js")
  script(src="/components/bootstrap-fileinput/js/fileinput.min.js")
  script(src="/components/bootstrap-fileinput/themes/fa/theme.min.js")
  script(src="/components/bootstrap-fileinput/js/locales/ja.js")
  script(src="/components/html2canvas/index.js")
  script(src="/javascripts/opencv.js")

block page_css
  link(href="/stylesheets/admin/mapEditor/maze_edit.css" rel="stylesheet")
  link(href="/stylesheets/admin/mapEditor/maze_modern.css" rel="stylesheet")
  link(href="/components/bootstrap-fileinput/css/fileinput.min.css" rel="stylesheet")

block hero_breadcrumb
  a.breadcrumb-item(ng-click="go('/home')") Home
  a.breadcrumb-item(ng-click="go('/service')") Public services
  span.breadcrumb-item.active Simulation world editor

block hero_title
  | {{"admin.simMapEditor.title" | translate}} 2026

block hero_subtitle
  | {{"admin.simMapEditor.desc" | translate}}

block hero_actions
  .action-group.flex-column.align-items-center
    span.action-label.mb-1 JSON
    .d-flex
      button.btn-hero-icon.mr-2(type='button', ng-click='export()', title='{{"admin.simMapEditor.export" | translate}}')
        i.fas.fa-file-export
      button.btn-hero-icon(type='button', onclick="$('#select').click()", title='{{"admin.simMapEditor.import" | translate}}')
        i.fas.fa-file-import
      input#select(type='file', name='select', style="display:none;")

block main_content
  .modern-toolbar.py-2.mb-3(style="background: #f8fafc; border-radius: 8px;")
    .row.no-gutters.w-100.align-items-center
      .col-auto.px-3
        .settings-group.mb-0
          label.settings-label {{"admin.simMapEditor.name" | translate}}
          input.premium-input(type='text', ng-model='name')
      .col-auto.px-3.border-left
        .dimension-spinner
          label.small.mb-0.mr-2.text-muted {{"admin.simMapEditor.width" | translate}}
          input.spinner-input(type='number', ng-model='width', min='1')
      .col-auto.px-3
        .dimension-spinner
          label.small.mb-0.mr-2.text-muted {{"admin.simMapEditor.length" | translate}}
          input.spinner-input(type='number', ng-model='length', min='1')
      .col-auto.px-3
        .dimension-spinner
          label.small.mb-0.mr-2.text-muted {{"admin.simMapEditor.timelimit" | translate}}
          input.spinner-input(type='number', ng-model='time', min = '1')
      .col.px-3.border-left.text-right
        button.btn-hero-action.btn-save(type='button', ng-click='exportW()')
          i.fas.fa-file-export.mr-2
          | {{"admin.simMapEditor.exportW" | translate}}

  .row.mb-3
    .col-12
      .option-tiles
        .option-tile(ng-class="{'active': selectRoom == 0}" ng-click="selectRoom2()")
          .option-visual
            i.fas.fa-square
          .option-label {{"admin.simMapEditor.select2" | translate}}
          .option-check
            i.fas.fa-check-circle
        .option-tile(ng-class="{'active': selectRoom == 1}" ng-click="selectRoom3()")
          .option-visual
            i.fas.fa-square
          .option-label {{"admin.simMapEditor.select3" | translate}}
          .option-check
            i.fas.fa-check-circle
        .option-tile(ng-class="{'active': selectRoom == 2}" ng-click="selectRoom4()")
          .option-visual
            i.fas.fa-square
          .option-label {{"admin.simMapEditor.select4" | translate}}
          .option-check
            i.fas.fa-check-circle
      .settings-group.mt-3(style="max-width: 400px;")
        label.settings-label {{"admin.simMapEditor.pick4" | translate}}
        select.premium-select(ng-model='area4Room', ng-options="room as room.value for room in area4", ng-init="area4Room=area4[0]", ng-change="updateRoom4Pick()")
        button.btn.btn-outline-dark#showRoom4Canvas(type='button', ng-click='openCustomRoom4()', style="margin:5px;display:none;")
          p Create Custom Room 4

  .row
    .col-11
      .modern-card
        .modern-card-body.p-0
          .map-container(style="overflow-x: auto;")
            table
              tbody
                tr(ng-repeat='r in range(2*length + 1)')
                  td(ng-repeat='c in range(2*width + 1)', ng-class="{'wallspot': $odd != $parent.$odd, 'tile': $odd && $parent.$odd, 'wall': cells[c+','+r+','+z].isWall}", ng-click='cellClick(c, r, z, $odd != $parent.$odd, $odd && $parent.$odd)', ng-style="tileColour(c,r,z)")
                    .tile-image-container(ng-show="$odd && $parent.$odd")
                      img.tile-image(ng-src='/images/start.png', ng-show='startTile.x == c && startTile.y == r && startTile.z == z')
                      img.tile-image(ng-src='/images/h_top.png', ng-show="cells[c+','+r+','+z].tile.victims.top == 'H' || cells[c+','+r+','+z].tile.halfWallVic[0] == 1 ||  cells[c+','+r+','+z].tile.halfWallVic[4] == 1 || cells[c+','+r+','+z].tile.halfWallVic[1] == 1 || cells[c+','+r+','+z].tile.halfWallVic[7] == 1")
