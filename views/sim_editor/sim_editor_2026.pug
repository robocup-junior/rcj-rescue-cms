//- -*- tab-width: 2 -*-
extends ./sim_editor_layout

append vars
  - var simYear = '2026'

block editor_script
  //- World export and room checks
  script(src="/javascripts/sim_editor/sim_world_2026.js?v=" + assetVersion)
  script(src="/javascripts/sim_editor/sim_room4_world_2026.js?v=" + assetVersion)
  script(src="/javascripts/cognitive_target.js?v=" + assetVersion)
  script(src="/javascripts/sim_editor/sim_editor.2026.js?v=" + assetVersion)
  script(src="/javascripts/sim_editor/rotation_dial.js?v=" + assetVersion)

block editor_notice
  a.sim-beta-link(href='https://world.erebus.rcj.cloud/')
    span.sim-beta-link-badge β
    span {{"admin.simMapEditor.newEditor" | translate}}
    i.fas.fa-arrow-right

block room_tools_extra
  button.btn.btn-sm.btn-outline-secondary.rounded-pill.ml-auto(type='button', ng-click='activateExteriorWalls()')
    i.fas.fa-border-style.mr-1
    | {{"admin.simMapEditor.extWalls" | translate}}

block map_legend
  .sim-map-legend
    span.sim-map-legend-item
      span.sim-map-legend-symbol.fake Φ
      | {{"admin.simMapEditor.fakeLegend" | translate}}
    span.sim-map-legend-item
      span.sim-map-legend-symbol.mixed Φ
      | {{"admin.simMapEditor.fakeLegendMixed" | translate}}

block map_table
  //- Insert (+) between and remove (x) rows / columns, as in the Maze editor
  table.grid-manage-table
      thead
          tr
              th.grid-manage-corner
              th.grid-manage-col(ng-repeat='c in range(2*width + 1)')
                  .btn-grid-manage-group
                      button.btn-grid-manage.btn-add(ng-if='$even', type='button', ng-click='addColumn(c)', title='{{"admin.simMapEditor.insertColumn" | translate}}')
                          i.fas.fa-plus-circle
                      button.btn-grid-manage.btn-remove(ng-if='$odd', type='button', ng-click='removeColumn(c)', title='{{"admin.simMapEditor.removeColumn" | translate}}')
                          i.fas.fa-times-circle
      tbody
          tr(ng-repeat='r in range(2*length + 1)')
              td.grid-manage-row
                  .btn-grid-manage-group
                      button.btn-grid-manage.btn-add(ng-if='$even', type='button', ng-click='addRow(r)', title='{{"admin.simMapEditor.insertRow" | translate}}')
                          i.fas.fa-plus-circle
                      button.btn-grid-manage.btn-remove(ng-if='$odd', type='button', ng-click='removeRow(r)', title='{{"admin.simMapEditor.removeRow" | translate}}')
                          i.fas.fa-times-circle
              td(ng-repeat='c in range(2*width + 1)', ng-class="{'wallspot': $odd != $parent.$odd, 'tile': $odd && $parent.$odd, 'wall': cells[c+','+r+','+z].isWall}", ng-click='cellClick(c, r, z, $odd != $parent.$odd, $odd && $parent.$odd)', ng-style="tileColour(c,r,z)")
                  .tile-image-container(ng-show="$odd && $parent.$odd")
                      img.tile-image(ng-src='/images/start.png', ng-show='startTile.x == c && startTile.y == r && startTile.z == z')
                      //- Room 4 preset preview: its footprint and where its passages go
                      .sim-area4-mark(ng-if="area4OverlayAt && z == 0 && area4OverlayAt(c, r)", ng-class="'is-' + area4OverlayAt(c, r).cls") {{area4OverlayAt(c, r).label}}
                      //- Passage tiles: where one can go, or one in the wrong place
                      .sim-conn-mark(ng-if="connMarkAt && z == 0 && connMarkAt(c, r)", ng-class="'is-' + connMarkAt(c, r).cls", ng-style="connMarkAt(c, r).style")

                      span(ng-show="cells[c+','+r+','+z].tile && cogTopLabel(cells[c+','+r+','+z].tile)", ng-bind="cogTopLabel(cells[c+','+r+','+z].tile)", style="position:absolute;top:1px;left:50%;transform:translateX(-50%);font-size:18px;font-weight:900;line-height:1;z-index:2;pointer-events:none;", ng-style="cogLetterStyle(cogTopLabel(cells[c+','+r+','+z].tile))")
                      img.tile-image(ng-src='/images/cog_top.png',    ng-show="cells[c+','+r+','+z].tile && cogTopIsFake(cells[c+','+r+','+z].tile)")
                      span(ng-show="cells[c+','+r+','+z].tile && cogRightLabel(cells[c+','+r+','+z].tile)", ng-bind="cogRightLabel(cells[c+','+r+','+z].tile)", style="position:absolute;right:1px;top:50%;transform:translateY(-50%);font-size:18px;font-weight:900;line-height:1;z-index:2;pointer-events:none;", ng-style="cogLetterStyle(cogRightLabel(cells[c+','+r+','+z].tile))")
                      img.tile-image(ng-src='/images/cog_right.png',  ng-show="cells[c+','+r+','+z].tile && cogRightIsFake(cells[c+','+r+','+z].tile)")
                      span(ng-show="cells[c+','+r+','+z].tile && cogBottomLabel(cells[c+','+r+','+z].tile)", ng-bind="cogBottomLabel(cells[c+','+r+','+z].tile)", style="position:absolute;bottom:1px;left:50%;transform:translateX(-50%);font-size:18px;font-weight:900;line-height:1;z-index:2;pointer-events:none;", ng-style="cogLetterStyle(cogBottomLabel(cells[c+','+r+','+z].tile))")
                      img.tile-image(ng-src='/images/cog_bottom.png', ng-show="cells[c+','+r+','+z].tile && cogBottomIsFake(cells[c+','+r+','+z].tile)")
                      span(ng-show="cells[c+','+r+','+z].tile && cogLeftLabel(cells[c+','+r+','+z].tile)", ng-bind="cogLeftLabel(cells[c+','+r+','+z].tile)", style="position:absolute;left:1px;top:50%;transform:translateY(-50%);font-size:18px;font-weight:900;line-height:1;z-index:2;pointer-events:none;", ng-style="cogLetterStyle(cogLeftLabel(cells[c+','+r+','+z].tile))")
