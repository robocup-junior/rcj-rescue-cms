//- -*- tab-width: 2 -*-
//- Shared page for the Rescue Simulation world editors (public service).
//- A year page sets `simYear`, appends its editor script and fills `map_table`.
extends ../includes/modern_layout

block vars
  - var ngAppDef = 'SimEditor'
  - var contentContainerClass = "mt-n4"
  - var hideLogin = pubService

append scripts
  script.
    var mapId = "#{mapid}"
    var competitionId = "#{compid}"
    var pubService = "#{pubService}"

  script(src="/javascripts/lvl-uuid.js?v=" + assetVersion)
  script(src="/components/html2canvas/index.js?v=" + assetVersion)
  script(src="/javascripts/opencv.js?v=" + assetVersion)
  block editor_script
  //- Needs `app` from the year's editor script
  script(src="/javascripts/sim_editor/sim_icons.js?v=" + assetVersion)
  script(src="/javascripts/sim_editor/room4_creator.js?v=" + assetVersion)

block page_css
  link(href="/stylesheets/admin/mapEditor/maze_edit.css?v=" + assetVersion rel="stylesheet")
  link(href="/stylesheets/admin/mapEditor/maze_modern.css?v=" + assetVersion rel="stylesheet")
  link(href="/stylesheets/sim_editor/sim_modern.css?v=" + assetVersion rel="stylesheet")

block hero_breadcrumb
  a.breadcrumb-item(ng-click="go('/home')")
    i.fas.fa-home.mr-1
    | Home
  a.breadcrumb-item(ng-click="go('/service')") Public services
  span.breadcrumb-item.active Simulation world editor #{simYear}

block hero_title_container
  .hero-title-container
    input.hero-title-input(type='text', ng-model='name', placeholder='{{"admin.simMapEditor.name" | translate}}')
    i.fas.fa-pen.title-edit-icon

block hero_subtitle
  | {{"admin.simMapEditor.title" | translate}} #{simYear}

block hero_actions
  .action-group.flex-column.align-items-center
    span.action-label.mb-1 JSON
    .d-flex
      button.btn-hero-icon.mr-2(type='button', ng-click='export()', title='{{"admin.simMapEditor.export" | translate}}')
        i.fas.fa-file-export
      button.btn-hero-icon(type='button', onclick="$('#select').click()", title='{{"admin.simMapEditor.import" | translate}}')
        i.fas.fa-file-import
      input#select(type='file', name='select', accept='.json,application/json', onclick='this.value=null', style="display:none;")

  .action-divider

  .action-group.flex-column.align-items-center
    span.action-label.mb-1 EREBUS
    button.btn-hero-action(type='button', ng-click='exportW()', title='{{"admin.simMapEditor.exportW" | translate}}')
      i.fas.fa-globe
      | .wbt

block main_content
  block editor_notice
  p.sim-editor-desc
    i.fas.fa-info-circle.mr-2
    | {{"admin.simMapEditor.desc" | translate}}

  .modern-toolbar.sim-toolbar
    .sim-toolbar-group
      span.sim-toolbar-label
        i.fas.fa-ruler-combined.mr-2
      .d-flex.align-items-center.mr-3(title='{{"admin.simMapEditor.width" | translate}}')
        label.small.mb-0.mr-2.text-muted
          i.fas.fa-arrows-alt-h
        .dimension-spinner
          button.btn-spin(type='button', ng-click="width = width > 1 ? width - 1 : 1")
            i.fas.fa-minus
          input.spinner-input(type='number', ng-model='width', min='1')
          button.btn-spin(type='button', ng-click="width = width + 1")
            i.fas.fa-plus
      .d-flex.align-items-center(title='{{"admin.simMapEditor.length" | translate}}')
        label.small.mb-0.mr-2.text-muted
          i.fas.fa-arrows-alt-v
        .dimension-spinner
          button.btn-spin(type='button', ng-click="length = length > 1 ? length - 1 : 1")
            i.fas.fa-minus
          input.spinner-input(type='number', ng-model='length', min='1')
          button.btn-spin(type='button', ng-click="length = length + 1")
            i.fas.fa-plus

    .sim-toolbar-group(title='{{"admin.simMapEditor.timelimit" | translate}}')
      span.sim-toolbar-label
        i.fas.fa-clock.mr-2
        | {{"admin.simMapEditor.timelimit" | translate}}
      .dimension-spinner
        button.btn-spin(type='button', ng-click="time = time > 30 ? time - 30 : 1")
          i.fas.fa-minus
        input.spinner-input.spinner-input-wide(type='number', ng-model='time', min='1')
        button.btn-spin(type='button', ng-click="time = (time || 0) + 30")
          i.fas.fa-plus

    .sim-toolbar-group.ml-auto
      button.calc-btn-premium(type='button', ng-click='openMaxScore()', title='Calculate Max Score')
        i.fas.fa-calculator

  .modern-card.mb-3
    .modern-card-header
      i.fas.fa-door-open.mr-2
      | {{"admin.simMapEditor.rooms" | translate}}
    .modern-card-body.sim-room-tools
      .sim-room-toggles
        button.sim-room-toggle.room2(type='button', ng-click='selectRoom2()', ng-class="{'active': selectRoom == 0}")
          i.far(ng-class="selectRoom == 0 ? 'fa-check-square' : 'fa-square'")
          | {{"admin.simMapEditor.select2" | translate}}
        button.sim-room-toggle.room3(type='button', ng-click='selectRoom3()', ng-class="{'active': selectRoom == 1}")
          i.far(ng-class="selectRoom == 1 ? 'fa-check-square' : 'fa-square'")
          | {{"admin.simMapEditor.select3" | translate}}
        button.sim-room-toggle.room4(type='button', ng-click='selectRoom4()', ng-class="{'active': selectRoom == 2}")
          i.far(ng-class="selectRoom == 2 ? 'fa-check-square' : 'fa-square'")
          | {{"admin.simMapEditor.select4" | translate}}

        block room_tools_extra

      //- Only relevant once the map has a room 4 (or while its tiles are being picked)
      .sim-room4(ng-if="selectRoom == 2 || roomTiles[2].length > 0 || (area4Room && area4Room.type !== 0)")
        .sim-room4-head
          span.sim-room4-title
            i.fas.fa-shapes.mr-2
            | {{"admin.simMapEditor.pick4" | translate}}
          span.sim-room4-hint {{"admin.simMapEditor.room4Hint" | translate}}
        .sim-room4-options
          button.sim-room4-option(type='button', ng-repeat="room in area4", ng-class="{'active': isArea4Room(room), 'unavailable': presetAvailable && !presetAvailable(room)}", ng-click="pickArea4Room(room)", ng-disabled="presetAvailable && !presetAvailable(room) && !isArea4Room(room)")
            span.sim-room4-icon
              i.fas(ng-class="room.type === 0 ? 'fa-ban' : (room.type === 1 ? 'fa-paint-brush' : 'fa-th-large')")
            span.sim-room4-text
              span.sim-room4-name(ng-if="room.type === 0") {{"admin.simMapEditor.room4None" | translate}}
              span.sim-room4-name(ng-if="room.type === 1") {{"admin.simMapEditor.room4Custom" | translate}}
              span.sim-room4-name(ng-if="room.type >= 2") {{"admin.simMapEditor.room4Preset" | translate}} {{room.type - 1}}
              span.sim-room4-meta(ng-if="room.type === 0") {{"admin.simMapEditor.room4NoneHint" | translate}}
              span.sim-room4-meta(ng-if="room.type === 1") {{"admin.simMapEditor.room4CustomHint" | translate}}
              span.sim-room4-meta(ng-if="room.type >= 2")
                span.sim-room4-size {{room.width}} × {{room.height}}
                span
                  i.fas.fa-user-injured.mr-1
                  | {{room.humans.length}}
                span
                  i.fas.fa-bullseye.mr-1
                  | {{room.hazards.length}}
              //- Whether the preset fits the room 4 area (only where the editor checks it)
              span.sim-room4-fit(ng-if="room.type >= 2 && presetStatusOf && presetStatusOf(room)", ng-class="presetStatusOf(room).ok ? 'ok' : (presetStatusOf(room).sizeOk ? 'warn' : 'off')")
                span(ng-if="presetStatusOf(room).ok")
                  i.fas.fa-check-circle.mr-1
                  | {{"admin.simMapEditor.area4Check.ok" | translate}}
                span(ng-if="presetStatusOf(room).sizeOk && !presetStatusOf(room).ok")
                  i.fas.fa-exclamation-triangle.mr-1
                  | {{"admin.simMapEditor.area4Check.check" | translate}}
                span(ng-if="!presetStatusOf(room).sizeOk")
                  i.fas.fa-lock.mr-1
                  | {{"admin.simMapEditor.area4Check.needSize" | translate:{size: room.width + ' × ' + room.height} }}
                  span.sim-room4-now {{"admin.simMapEditor.area4Check.now" | translate:{now: presetStatusOf(room).region || ("admin.simMapEditor.area4Check.none" | translate)} }}
            i.fas.fa-check-circle.sim-room4-check
        //- Placement check for the chosen preset
        .sim-room4-status(ng-if="area4Room && area4Room.type >= 2 && presetStatusOf && presetStatusOf(area4Room)", ng-class="presetStatusOf(area4Room).ok ? 'ok' : 'warn'")
          .sim-room4-status-title
            i.fas(ng-class="presetStatusOf(area4Room).ok ? 'fa-check-circle' : 'fa-exclamation-triangle'")
            | {{"admin.simMapEditor.area4Check.title" | translate}}
          div(ng-if="presetStatusOf(area4Room).ok") {{"admin.simMapEditor.area4Check.ok" | translate}}
          ul(ng-if="!presetStatusOf(area4Room).ok")
            li(ng-repeat="issue in presetStatusOf(area4Room).issues") {{("admin.simMapEditor.area4Check." + issue) | translate}}
          .sim-room4-hint(ng-if="!presetStatusOf(area4Room).ok") {{"admin.simMapEditor.area4Check.mapHint" | translate}}
          .sim-room4-hint(ng-if="presetStatusOf(area4Room).ok") {{"admin.simMapEditor.area4Check.mapHintOk" | translate}}
        .sim-room4-custom(ng-show="area4Room && area4Room.type === 1")
          button.btn.btn-sm.btn-primary.rounded-pill(type='button', ng-click='openCustomRoom4()')
            i.fas.fa-paint-brush.mr-1
            | {{"admin.simMapEditor.room4Creator.open" | translate}}
          span.sim-room4-hint {{"admin.simMapEditor.room4CustomSteps" | translate}}

      //- How the rooms are joined: a passage tile (floor colour) for each gap between rooms.
      //- The check can be switched off for the map; then nothing is checked or blocked.
      .sim-conn-status(ng-if="connCheckOff || (connStatus && connStatus.show)", ng-class="connCheckOff ? 'off' : (connStatus.ok ? 'ok' : 'warn')")
        .sim-conn-head
          span.sim-conn-title
            i.fas(ng-class="connCheckOff ? 'fa-power-off' : (connStatus.ok ? 'fa-check-circle' : 'fa-info-circle')")
            | {{"admin.simMapEditor.connCheck.title" | translate}}
          label.sim-conn-switch(title="{{'admin.simMapEditor.connCheck.switchHint' | translate}}")
            input(type='checkbox', ng-checked='!connCheckOff', ng-click='toggleConnCheck()')
            span.sim-conn-switch-track
            span.sim-conn-switch-label {{(connCheckOff ? "admin.simMapEditor.connCheck.off" : "admin.simMapEditor.connCheck.on") | translate}}
        div.sim-conn-offnote(ng-if="connCheckOff") {{"admin.simMapEditor.connCheck.offNote" | translate}}
        div(ng-if="!connCheckOff")
          .sim-conn-summary(ng-if="connStatus.ok") {{"admin.simMapEditor.connCheck.ok" | translate}}
          .sim-conn-room(ng-repeat="entry in connStatus.rooms", ng-class="entry.reached && !entry.gap ? 'ok' : 'warn'")
            .sim-conn-room-head
              i.fas(ng-class="entry.reached && !entry.gap ? 'fa-check-circle' : 'fa-circle'")
              span.sim-conn-room-name {{"admin.simMapEditor.connCheck.room" | translate:{room: entry.room} }}
              span.sim-conn-chip(ng-repeat="pass in entry.linked")
                span.sim-conn-swatch(ng-style="{'background-color': pass.color}")
                | {{pass.from}} ⇄ {{pass.to}}
            .sim-conn-room-body(ng-if="!entry.reached")
              div(ng-if="!entry.options.length") {{"admin.simMapEditor.connCheck.isolated" | translate}}
              div(ng-if="entry.options.length")
                div {{(entry.linked.length ? "admin.simMapEditor.connCheck.notReached" : "admin.simMapEditor.connCheck.notLinked") | translate}}
                .sim-conn-options
                  span.sim-conn-chip.option(ng-repeat="o in entry.options")
                    span.sim-conn-swatch(ng-style="{'background-color': o.pass.color}")
                    | {{"admin.simMapEditor.connCheck.option" | translate:{from: o.pass.from, to: o.pass.to, name: (o.pass.name | translate)} }}
                .sim-room4-hint(ng-if="entry.room === 4 && area4Room && area4Room.type >= 2") {{"admin.simMapEditor.connCheck.presetNote" | translate}}
          ul.sim-conn-issues(ng-if="connStatus.issues.length")
            li(ng-repeat="issue in connStatus.issues") {{("admin.simMapEditor.connCheck." + issue.key) | translate:{name: (issue.pass.name | translate), from: issue.pass.from, to: issue.pass.to, room: issue.room, count: issue.count} }}
          .sim-conn-foot(ng-if="!connStatus.ok")
            div {{"admin.simMapEditor.connCheck.mapHint" | translate}}
            div
              i.fas.fa-lock.mr-1
              | {{"admin.simMapEditor.connCheck.exportNote" | translate}}

  .modern-card.mb-4.overflow-hidden
    .modern-card-body.p-0
      .map-container
        block map_table
    block map_legend
