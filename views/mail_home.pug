//- -*- tab-width: 2 -*-
extends includes/modern_layout

block vars
  - var ngAppDef = 'MailHome'

append scripts
  script.
    var competitionId = "#{id}"
    var mailEnable = #{!!mailEnable}
  script(src='/javascripts/mail_home.js?v=' + assetVersion)
  script(src='/components/quill-dist/index.js?v=' + assetVersion)
  script(src='/components/ngQuill/src/ng-quill.js?v=' + assetVersion)
  script(src='/components/quill-image-resize-module/image-resize.min.js?v=' + assetVersion)
  script(src='/components/quill-image-drop-and-paste/dist/quill-image-drop-and-paste.min.js?v=' + assetVersion)

append css
  link(rel='stylesheet', href='/components/quill.snow/index.css?v=' + assetVersion)

block hero_breadcrumb
  a.breadcrumb-item(ng-click="go('/home')")
    i.fas.fa-home.mr-1
    | Home
  a.breadcrumb-item(ng-click="go('/admin')") Admin
  a.breadcrumb-item(ng-click="go('/admin/' + competition._id)") {{competition.name}}
  span.breadcrumb-item.active Mails

block hero_title
  | {{competition.name}}

block hero_subtitle
  span(ng-show="mode=='select'") {{"mail.home.title" | translate}}
  span(ng-show="mode=='write'") {{"mail.home.writeMail" | translate}}
  span(ng-show="mode=='preview'") {{"mail.home.preview" | translate}}

block hero_actions
  if mailWebUi
    button.btn-action-icon(type='button' ng-click="open('" + mailWebUi + "')" uib-tooltip='{{"mail.home.devInbox" | translate}}' tooltip-placement="bottom")
      i.fas.fa-inbox
  button.btn-action-icon(type='button' ng-click="go('/admin/' + competition._id + '/mails/sent')" uib-tooltip='{{"mail.home.deliveryStatus" | translate}}' tooltip-placement="bottom")
    i.fas.fa-mail-bulk
  if user.superDuperAdmin
    button.btn-action-icon(type='button' ng-click="open('/admin/queues/queue/mail%20queue')" uib-tooltip='{{"mail.home.mailQueue" | translate}}' tooltip-placement="bottom")
      i.fas.fa-bullseye

block main_content
  if !mailEnable
    .alert.alert-warning.d-flex.align-items-start
      i.fas.fa-exclamation-triangle.mr-3.mt-1
      div
        b {{"mail.home.noSmtp" | translate}}
        div.small {{"mail.home.error" | translate}}

  //- The steps
  .mail-steps
    .mail-step(ng-class="{'active': mode=='select', 'done': mode!='select'}")
      span.step-number
        i.fas.fa-check(ng-if="mode!='select'")
        span(ng-if="mode=='select'") 1
      | {{"mail.home.deliveredTo" | translate}}
    .mail-step-line
    .mail-step(ng-class="{'active': mode=='write', 'done': mode=='preview'}")
      span.step-number
        i.fas.fa-check(ng-if="mode=='preview'")
        span(ng-if="mode!='preview'") 2
      | {{"mail.home.writeMail" | translate}}
    .mail-step-line
    .mail-step(ng-class="{'active': mode=='preview'}")
      span.step-number 3
      | {{"mail.home.preview" | translate}}

  //- Step 1: select teams or staff
  .d-flex.justify-content-between.align-items-center.flex-wrap.mb-3(ng-show="mode=='select'" style="gap: 0.75rem;")
    .segmented(role="group")
      button(type='button' ng-click="switchTarget('team')" ng-class="{'active': target=='team'}")
        i.fas.fa-users.mr-1
        | {{"mail.home.toTeams" | translate}}
        span.count(ng-bind="(teams || []).length")
      button(type='button' ng-click="switchTarget('staff')" ng-class="{'active': target=='staff'}")
        i.fas.fa-user-tie.mr-1
        | {{"mail.home.toStaff" | translate}}
        span.count(ng-bind="(staff || []).length")
    .d-flex.align-items-center(style="gap: 0.75rem;")
      span.small.text-muted(ng-bind="'mail.home.selected' | translate:{n: selectedCount()}")
      button.btn.btn-sm.btn-premium-primary(type='button' ng-click="newEmail2SelectedTeam()" ng-disabled="selectedCount() == 0")
        i.fas.fa-envelope-open-text.mr-1
        | {{"mail.home.newMailBulk" | translate}}

  .modern-card(ng-show="mode=='select' && target=='team'")
    .modern-card-header
      .d-flex.justify-content-between.align-items-center.w-100
        div
          i.fas.fa-users.mr-2
          | {{"mail.home.toTeams" | translate}}
          span.small.text-muted.ml-2(ng-if="withoutEmail(teams) > 0" ng-bind="'mail.home.withoutEmail' | translate:{n: withoutEmail(teams)}")
        .btn-table-group
          .btn-table-action.primary(ng-click="showFilter = !showFilter" ng-class="showFilter ? 'active-blue' : ''" uib-tooltip="{{'common.refine' | translate}}" tooltip-append-to-body="true")
            i.fas.fa-filter
          .btn-table-action(ng-click="selectAll()" ng-class="selectedAll ? 'active-blue' : ''" uib-tooltip="{{'common.selectAll' | translate}}" tooltip-append-to-body="true")
            i.fas.fa-check-double

    .filter-collapse(ng-show="showFilter" style="background: #f8fafc; border-bottom: 1px solid #f1f5f9; padding: 1.5rem;")
      .row
        .col-md-3.mb-2
          h6.font-weight-bold.text-muted.small.text-uppercase.mb-2 {{"common.teamCode" | translate}}
          .input-group
            .input-group-prepend
              span.input-group-text
                i.fas.fa-hashtag
            input.form-control.form-control-sm(type='text' placeholder='{{"common.teamCode" | translate}}' ng-model='refineCode')
        .col-md-3.mb-2
          h6.font-weight-bold.text-muted.small.text-uppercase.mb-2 {{"common.team" | translate}}
          .input-group
            .input-group-prepend
              span.input-group-text
                i.fas.fa-users
            input.form-control.form-control-sm(type='text' placeholder='{{"common.team" | translate}}' ng-model='refineName')
        .col-md-3.mb-2
          h6.font-weight-bold.text-muted.small.text-uppercase.mb-2 {{"common.region" | translate}}
          .input-group
            .input-group-prepend
              span.input-group-text
                i.fas.fa-globe-asia
            input.form-control.form-control-sm(type='text' placeholder='{{"common.region" | translate}}' ng-model='refineRegion')
        .col-md-3.mb-2
          h6.font-weight-bold.text-muted.small.text-uppercase.mb-2 {{"common.league" | translate}}
          .filter-container
            span.filter-badge(ng-repeat='(key, value) in Rleagues track by key' ng-class="{'active': Rleagues[key]}" ng-click="Rleagues[key] = !Rleagues[key]") {{key}}

    .modern-card-body.p-0
      .empty-state.m-4(ng-if="teams && teams.length == 0")
        i.fas.fa-users.d-block
        | {{"mail.home.noTeams" | translate}}
      .table-responsive(ng-if="teams.length > 0" style="padding: 0 1.5rem 1.5rem;")
        table.table-modern.table-auto
          thead
            tr
              th(style="width: 50px;")
              th {{"common.teamCode" | translate}}
              th {{"common.team" | translate}}
              th {{"common.region" | translate}}
              th {{"common.league" | translate}}
              th {{'common.email' | translate}}
              th(style="width: 90px;") {{'common.operation' | translate}}
          tbody
            tr(ng-repeat='team in teams | filter:list_filter | orderBy:"[teamCode, name]"' ng-class="{'no-email': !validEmail(team.email)}")
              td
                .custom-checkbox(ng-if="validEmail(team.email)" ng-class="{'checked': team.checked}" ng-click="team.checked = !team.checked")
                  i.fas.fa-check(ng-if="team.checked")
              td(ng-bind='team.teamCode')
              td.font-weight-bold(ng-bind='team.name')
              td(ng-bind='team.country')
              td(ng-bind='team.league')
              td
                div.small(ng-repeat="em in team.email track by $index" ng-bind="em")
                span.small(ng-if="!validEmail(team.email)") {{"mail.home.noEmail" | translate}}
              td
                .btn-table-group(ng-if="validEmail(team.email)")
                  .btn-table-action.primary(ng-click="newMail(team)" uib-tooltip='{{"mail.home.newMail" | translate}}' tooltip-append-to-body="true")
                    i.fas.fa-envelope-open-text

  .modern-card(ng-show="mode=='select' && target=='staff'")
    .modern-card-header
      .d-flex.justify-content-between.align-items-center.w-100
        div
          i.fas.fa-user-tie.mr-2
          | {{"mail.home.toStaff" | translate}}
          span.small.text-muted.ml-2(ng-if="withoutEmail(staff) > 0" ng-bind="'mail.home.withoutEmail' | translate:{n: withoutEmail(staff)}")
        .btn-table-group
          .btn-table-action.primary(ng-click="showFilter = !showFilter" ng-class="showFilter ? 'active-blue' : ''" uib-tooltip="{{'common.refine' | translate}}" tooltip-append-to-body="true")
            i.fas.fa-filter
          .btn-table-action(ng-click="selectAll()" ng-class="selectedAll ? 'active-blue' : ''" uib-tooltip="{{'common.selectAll' | translate}}" tooltip-append-to-body="true")
            i.fas.fa-check-double

    .filter-collapse(ng-show="showFilter" style="background: #f8fafc; border-bottom: 1px solid #f1f5f9; padding: 1.5rem;")
      .row
        .col-md-3.mb-2
          h6.font-weight-bold.text-muted.small.text-uppercase.mb-2 {{"admin.authority.name" | translate}}
          .input-group
            .input-group-prepend
              span.input-group-text
                i.fas.fa-user
            input.form-control.form-control-sm(type='text' placeholder='{{"admin.authority.name" | translate}}' ng-model='refineUser')

    .modern-card-body.p-0
      p.text-muted.small.px-4.pt-3.mb-0 {{"mail.home.staffDescription" | translate}}
      .empty-state.m-4(ng-if="staff && staff.length == 0")
        i.fas.fa-user-tie.d-block
        | {{"mail.home.noStaff" | translate}}
        div.mt-3
          a.btn.btn-sm.btn-light(ng-href="/admin/{{competitionId}}/settings")
            i.fas.fa-user-shield.mr-1
            | {{"admin.authority.title" | translate}}
      .table-responsive(ng-if="staff.length > 0" style="padding: 0 1.5rem 1.5rem;")
        table.table-modern.table-auto
          thead
            tr
              th(style="width: 50px;")
              th {{"admin.authority.name" | translate}}
              th {{"admin.authority.nowLevel" | translate}}
              th {{"mail.home.role" | translate}}
              th {{'common.email' | translate}}
              th(style="width: 90px;") {{'common.operation' | translate}}
          tbody
            tr(ng-repeat='user in staff | filter:staff_filter | orderBy:"username"' ng-class="{'no-email': !user.hasEmail}")
              td
                .custom-checkbox(ng-if="user.hasEmail" ng-class="{'checked': user.checked}" ng-click="user.checked = !user.checked")
                  i.fas.fa-check(ng-if="user.checked")
              td.font-weight-bold(ng-bind='user.username')
              td(ng-bind='levelName(user.accessLevel)')
              td
                span.badge.badge-pill.badge-warning.mr-1(ng-repeat="r in user.role track by $index" ng-bind="r")
              td
                span.small(ng-if="user.email" ng-bind="user.email")
                i.fas.fa-check.text-success(ng-if="!user.email && user.hasEmail")
                span.small(ng-if="!user.hasEmail") {{"mail.home.noEmail" | translate}}
              td
                .btn-table-group(ng-if="user.hasEmail")
                  .btn-table-action.primary(ng-click="newMail(user)" uib-tooltip='{{"mail.home.newMail" | translate}}' tooltip-append-to-body="true")
                    i.fas.fa-envelope-open-text

  //- Step 2: write
  .modern-card(ng-show="mode=='write'")
    .modern-card-header
      .d-flex.justify-content-between.align-items-center.w-100
        div
          i.fas.fa-pen.mr-2
          | {{"mail.home.writeMail" | translate}}
        span.small.text-muted(ng-bind="'mail.home.recipients' | translate:{n: toTeam.length}")
    .modern-card-body
      .d-flex.justify-content-between.align-items-center
        label.small.text-muted.mb-0 {{"mail.home.deliveredTo" | translate}}
        button.btn.btn-sm.btn-link(type='button' ng-if="toTeam.length > 3" ng-click="showAllRecipients = !showAllRecipients")
          span(ng-if="!showAllRecipients") {{"mail.home.showAll" | translate}}
          span(ng-if="showAllRecipients") {{"mail.home.showLess" | translate}}
      .scroll-box
        table.table-modern.table-auto
          thead
            tr(ng-if="target=='team'")
              th {{"common.team" | translate}}
              th {{"common.league" | translate}}
              th {{"mail.home.deliveredTo" | translate}}
            tr(ng-if="target=='staff'")
              th {{"admin.authority.name" | translate}}
              th {{"admin.authority.nowLevel" | translate}}
              th {{"mail.home.deliveredTo" | translate}}
          tbody
            tr(ng-repeat="team in toTeam | limitTo:(showAllRecipients ? toTeam.length : 3) track by $index")
              td.font-weight-bold(ng-bind="target=='staff' ? team.username : team.name")
              td(ng-bind="target=='staff' ? levelName(team.accessLevel) : team.league")
              td
                div.small(ng-if="target=='team'" ng-repeat="em in team.email track by $index" ng-bind="em")
                div.small(ng-if="target=='staff'" ng-bind="team.email || team.username")
            tr(ng-if="!showAllRecipients && toTeam.length > 3")
              td.text-muted.small(colspan=3 ng-bind="'mail.home.andMore' | translate:{n: toTeam.length - 3}")

      .form-group.mt-3
        label.small.text-muted {{"mail.home.loadTemplate" | translate}}
        select.custom-select(ng-model='selectedTemplate' ng-options='template.path as template.name for template in templates' ng-change="changeTemplate()")
          option(value="") {{"mail.home.selectTemplate" | translate}}
      .form-group
        label.small.text-muted {{"mail.home.subject" | translate}}
        input.form-control(type='text' ng-model='mailTitle' ng-trim="false" ng-focus="focusField('subject')" id="mailTitle" ng-class="{'is-invalid': triedPreview && !mailTitle}")
        .invalid-feedback {{"mail.home.subjectRequired" | translate}}

      //- The variables, put where the cursor is (in the subject or the content)
      .mb-2
        label.small.text-muted.d-block.mb-1
          | {{"mail.home.variable" | translate}}
          span.ml-1 — {{"mail.home.variableHint" | translate}}
        span.var-chip(ng-repeat="key in variableKeys()" ng-mousedown="$event.preventDefault()" ng-click="insertVariable(key)" uib-tooltip="{{toTeam[0].variable[key]}}" tooltip-append-to-body="true" ng-bind="'${' + key + '}'")

      ng-quill-editor(ng-model="mailContent" on-editor-created="editorCreated(editor)" on-selection-changed="contentSelected(range)")
      .invalid-feedback.d-block(ng-if="triedPreview && !hasContent()") {{"mail.home.contentRequired" | translate}}

      .form-group.mt-3
        label.small.text-muted
          i.fas.fa-clock.mr-1
          | {{"mail.home.reservation" | translate}}
        .d-flex.align-items-center(style="gap: 0.5rem;")
          input.form-control(type='datetime-local' step=1 ng-model='reservation' style="max-width: 320px;")
          button.btn.btn-sm.btn-light(type='button' ng-if="reservation" ng-click="reservation = undefined")
            i.fas.fa-times.mr-1
            | {{"mail.home.now" | translate}}
        small.text-muted {{"mail.home.reservationHint" | translate}}
      .d-flex.justify-content-between.mt-4
        button.btn.btn-light(type='button' ng-click="back2TeamSelect()")
          i.fas.fa-arrow-left.mr-2
          | {{"mail.home.back2select" | translate}}
        button.btn.btn-premium-primary(type='button' ng-click="preview()")
          | {{"mail.home.preview" | translate}}
          i.fas.fa-arrow-right.ml-2

  //- Step 3: preview and send
  .modern-card(ng-show="mode=='preview'")
    .modern-card-header
      i.fas.fa-eye.mr-2
      | {{"mail.home.preview" | translate}}
    .modern-card-body
      .row.mb-3
        .col-md-4.mb-3
          label.small.text-muted.d-block {{"mail.home.deliverNo" | translate}}
          .preview-stepper
            button.btn.btn-sm.btn-light(type='button' ng-click="changePreviewNo(-1)" ng-disabled="previewNo<=0")
              i.fas.fa-chevron-left
            span.preview-number {{previewNo + 1}} / {{toTeam.length}}
            button.btn.btn-sm.btn-light(type='button' ng-click="changePreviewNo(1)" ng-disabled="(previewNo+1)>=toTeam.length")
              i.fas.fa-chevron-right
        .col-md-8
          label.small.text-muted.d-block {{"mail.home.deliveredTo" | translate}}
          table.table-modern.table-auto
            thead
              tr(ng-if="target=='team'")
                th {{"common.team" | translate}}
                th {{"common.league" | translate}}
                th {{"mail.home.deliveredTo" | translate}}
              tr(ng-if="target=='staff'")
                th {{"admin.authority.name" | translate}}
                th {{"admin.authority.nowLevel" | translate}}
                th {{"mail.home.deliveredTo" | translate}}
            tbody
              tr
                td.font-weight-bold(ng-bind="target=='staff' ? toTeam[previewNo].username : toTeam[previewNo].name")
                td(ng-bind="target=='staff' ? levelName(toTeam[previewNo].accessLevel) : toTeam[previewNo].league")
                td
                  div.small(ng-if="target=='team'" ng-repeat="em in toTeam[previewNo].email track by $index" ng-bind="em")
                  div.small(ng-if="target=='staff'" ng-bind="toTeam[previewNo].email || toTeam[previewNo].username")
      .form-group
        label.small.text-muted {{"mail.home.subject" | translate}}
        input.form-control(type='text' ng-model='toTeam[previewNo].mailData.title' disabled)
      .mail-preview-box(ng-bind-html="trust(toTeam[previewNo].mailData.content)")
      .d-flex.justify-content-between.align-items-center.flex-wrap.mt-4(style="gap: 0.75rem;")
        h5.mb-0
          i.fas.fa-clock.mr-2.text-muted
          span(ng-if="!reservation") {{"mail.home.sendTime" | translate}}: {{"mail.home.now" | translate}}
          span(ng-if="reservation") {{"mail.home.sendTime" | translate}}: {{time(reservation)}}
        button.btn.btn-sm.btn-light(type='button' ng-click="testSend()" ng-disabled="sending || !mailEnable")
          i.fas.fa-vial.mr-1
          | {{"mail.home.testSend" | translate}}
      .d-flex.justify-content-between.mt-4
        button.btn.btn-light(type='button' ng-click="back2Edit()")
          i.fas.fa-arrow-left.mr-2
          | {{"mail.home.back2Edit" | translate}}
        button.btn.btn-premium-primary(type='button' ng-click="mailSend()" ng-disabled="sending || !mailEnable")
          span(ng-if="!reservation") {{"mail.home.sendN" | translate:{n: toTeam.length} }}
          span(ng-if="reservation") {{"mail.home.reserveN" | translate:{n: toTeam.length} }}
          i.fas.ml-2(ng-class="reservation ? 'fa-clock' : 'fa-paper-plane'")
