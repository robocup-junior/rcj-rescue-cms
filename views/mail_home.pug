//- -*- tab-width: 2 -*-
extends includes/modern_layout

block vars
  - var ngAppDef = 'MailHome'

append scripts
  script.
    var competitionId = "#{id}"
  script(src='/javascripts/mail_home.js')
  script(src='/components/quill/index.js')
  script(src='/components/ngQuill/src/ng-quill.js')
  script(src='/components/quill-image-resize-module/image-resize.min.js')
  script(src='/components/quill-image-drop-and-paste/dist/quill-image-drop-and-paste.min.js')

append css
  link(rel='stylesheet', href='/components/quill.snow/index.css')
  link(href='/stylesheets/common/modern_editor.css', rel='stylesheet')

block hero_breadcrumb
  a.breadcrumb-item(ng-click="go('/home')") Home
  a.breadcrumb-item(ng-click="go('/admin')") Admin
  a.breadcrumb-item(ng-click="go('/admin/' + competition._id)") {{competition.name}}
  span.breadcrumb-item.active Mails

block hero_title
  | {{competition.name}}

block hero_subtitle
  i.fas.fa-envelope.mr-2
  | {{"mail.home.title" | translate}}

block main_content
  div(ng-show="mode=='select'")
    h5.section-heading.mb-2
      i.fas.fa-search
      | {{'common.refine' | translate}}
    .modern-card
      .modern-card-body
        .row
          .col-md-3
            .settings-group
              label.settings-label {{"common.teamCode" | translate}}
              input.premium-input(type='text', ng-model='refineCode')
          .col-md-3
            .settings-group
              label.settings-label {{"common.team" | translate}}
              input.premium-input(type='text', ng-model='refineName')
          .col-md-3
            .settings-group
              label.settings-label {{"common.region" | translate}}
              input.premium-input(type='text', ng-model='refineRegion')
          .col-md-3
            .settings-group.mb-0
              label.settings-label {{"common.league" | translate}}
              .toolbar-actions(style="flex-wrap: wrap;")
                span(ng-repeat='(key, value) in Rleagues track by key')
                  input(type='checkbox' ng-model='Rleagues[key]' id="checkL_{{key}}")
                  label.checkbox(for="checkL_{{key}}") &nbsp;{{key}}

    .add-item-row(style="text-align: left;")
      button.btn-premium(ng-click="selectAll()" ng-class="selectedAll ? 'btn-premium-primary':'btn-premium-dark'")
        i.far.fa-check-square(ng-if="selectedAll")
        i.far.fa-square(ng-if="!selectedAll")
        | {{"common.selectAll" | translate}}
      button.btn-premium.btn-premium-primary(type='button', ng-click="newEmail2SelectedTeam()")
        i.fas.fa-envelope-open-text
        | {{"mail.home.newMailBulk" | translate}}
      button.btn-premium.btn-premium-dark(type='button', ng-click="go('/admin/' + competition._id + '/mails/sent')")
        i.fas.fa-mail-bulk
        | {{"mail.home.deliveryStatus" | translate}}
      if user.superDuperAdmin
        button.btn-premium.btn-premium-dark(type='button', ng-click="open('/admin/queues/queue/mail%20queue')")
          i.fas.fa-bullseye
          | {{"mail.home.mailQueue" | translate}}

    .modern-table-card
      table.custom
        thead
          tr
            th
            th {{"common.teamCode" | translate}}
            th {{"common.team" | translate}}
            th {{"common.region" | translate}}
            th {{"common.league" | translate}}
            th {{'common.email' | translate}}
            th {{'common.operation' | translate}}
        tbody
          tr(ng-repeat='team in teams | filter:list_filter | orderBy:"[teamCode, name]"')
            td
              input(type='checkbox', ng-model='team.checked', style="display:initial;", ng-if="validEmail(team.email)")
            td(ng-bind='team.teamCode')
            td(ng-bind='team.name')
            td(ng-bind='team.country')
            td(ng-bind='team.league')
            td
              div(ng-repeat="em in team.email track by $index", ng-hide="team.edit")
                span(ng-bind="em")
                br
            td
              button.btn-table-action(type='button', ng-click="newMail(team)", ng-if="validEmail(team.email)")
                i.fas.fa-envelope-open-text
                | {{"mail.home.newMail" | translate}}

  div(ng-show="mode=='write'")
    h5.section-heading.mb-2
      i.fas.fa-edit
      | {{"mail.home.writeMail" | translate}}

    .settings-label {{"mail.home.deliveredTo" | translate}}
    .modern-table-card
      div(style="max-height:200px;overflow: auto;")
        table.custom
          thead
            tr
              th {{"common.team" | translate}}
              th {{"common.league" | translate}}
              th {{"mail.home.deliveredTo" | translate}}
              th {{"mail.home.variable" | translate}}
          tbody
            tr(ng-repeat="team in toTeam track by $index")
              td(ng-bind="team.name")
              td(ng-bind="team.league")
              td
                div(ng-repeat="em in team.email track by $index")
                  span(ng-bind="em")
                  br
              td
                button.btn-table-action(type='button', ng-click="showVariable(team.variable)")
                  i.fas.fa-box-open
                  | {{"mail.home.variable" | translate}}

    .modern-card
      .modern-card-body
        .settings-group
          label.settings-label {{"mail.home.loadTemplate" | translate}}
          select.premium-select(ng-model='selectedTemplate', ng-options='template.path as template.name for template in templates', ng-change="changeTemplate()")
            option(value="") {{"mail.home.selectTemplate" | translate}}

        .settings-group
          label.settings-label {{"mail.home.subject" | translate}}
          input.premium-input(type='text', ng-model='mailTitle')

        .settings-group
          label.settings-label {{"document.editor.content" | translate}}
          .quill-editor-wrapper
            ng-quill-editor(ng-model="mailContent" on-editor-created="quillHeight(editor)")

        .settings-group.mb-0
          label.settings-label
            i.fas.fa-clock
            | &nbsp;{{"mail.home.reservation" | translate}}
          input.premium-input(type='datetime-local', step=1, ng-model='reservation')

    .add-item-row
      button.btn-premium.btn-premium-dark(type='button', ng-click="back2TeamSelect()")
        i.fas.fa-arrow-left
        | {{"mail.home.back2select" | translate}}
      button.btn-premium.btn-premium-primary(type='button', ng-click="preview()")
        | {{"mail.home.preview" | translate}}
        i.fas.fa-arrow-right

  div(ng-show="mode=='preview'")
    h5.section-heading.mb-2
      i.fas.fa-eye
      | {{"mail.home.preview" | translate}}

    .modern-card
      .modern-card-body
        .row
          .col-md-4
            .settings-group.mb-0(style="text-align: center;")
              label.settings-label {{"mail.home.deliverNo" | translate}}
              .toolbar-actions(style="justify-content: center;")
                button.icon-btn-premium(type='button', ng-click="changePreviewNo(-1)", ng-disabled="previewNo<=0")
                  i.fas.fa-chevron-left
                span(style="font-size:1.8rem; font-weight: 800; min-width: 60px; text-align: center;" ng-bind="previewNo")
                button.icon-btn-premium(type='button', ng-click="changePreviewNo(1)", ng-disabled="(previewNo+1)>=toTeam.length")
                  i.fas.fa-chevron-right
          .col-md-8
            .settings-group.mb-0
              label.settings-label {{"mail.home.deliveredTo" | translate}}
              .modern-table-card
                div(style="max-height:200px;overflow: auto;")
                  table.custom
                    thead
                      tr
                        th {{"common.team" | translate}}
                        th {{"common.league" | translate}}
                        th {{"mail.home.deliveredTo" | translate}}
                    tbody
                      tr
                        td(ng-bind="toTeam[previewNo].name")
                        td(ng-bind="toTeam[previewNo].league")
                        td
                          div(ng-repeat="em in toTeam[previewNo].email track by $index")
                            span(ng-bind="em")
                            br

        .settings-group
          label.settings-label {{"mail.home.subject" | translate}}
          input.premium-input(type='text', ng-model='toTeam[previewNo].mailData.title', disabled)

        .settings-group.mb-0
          label.settings-label {{"document.editor.content" | translate}}
          div(style="border: 1px solid #e2e8f0; border-radius: 12px; padding: 1rem; background: #f8fafc;" ng-bind-html="trust(toTeam[previewNo].mailData.content)")

    p.text-body-premium(ng-if="!reservation") {{"mail.home.sendTime" | translate}}: {{"mail.home.now" | translate}}
    p.text-body-premium(ng-if="reservation") {{"mail.home.sendTime" | translate}}: {{time(reservation)}}

    .add-item-row
      button.btn-premium.btn-premium-dark(type='button', ng-click="back2Edit()")
        i.fas.fa-arrow-left
        | {{"mail.home.back2Edit" | translate}}
      button.btn-premium.btn-premium-primary(type='button', ng-click="mailSend()", ng-disabled="sending", ng-if="!reservation")
        | {{"mail.home.send" | translate}}
        i.fas.fa-arrow-right
      button.btn-premium.btn-premium-primary(type='button', ng-click="mailSend()", ng-disabled="sending", ng-if="reservation")
        | {{"mail.home.reservation" | translate}}
        i.fas.fa-clock
