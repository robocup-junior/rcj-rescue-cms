//- -*- tab-width: 2 -*-
extends includes/modern_layout

block vars
  - var ngAppDef = 'AdminRestore'

append scripts
  script.
    var competitionId = "#{competition_id}"
  script(src='/javascripts/admin_restore.js')
  script(src="/components/bootstrap-fileinput/js/fileinput.min.js")
  script(src="/components/bootstrap-fileinput/themes/fa/theme.min.js")
  script(src="/components/bootstrap-fileinput/js/locales/ja.js")
  script(src="/components/ng-file-upload/ng-file-upload.min.js")

block hero_breadcrumb
  a.breadcrumb-item(ng-click="go('/home')")
    i.fas.fa-home.mr-1
    | Home
  a.breadcrumb-item(ng-click="go('/admin')") Admin
  span.breadcrumb-item.active Restore

block hero_title
  | {{"admin.restore.title" | translate}}

block hero_subtitle
  | Admin

block main_content
  .modern-card
    .modern-card-header
      i.fas.fa-file-upload.mr-2
      | {{"admin.restore.title" | translate}}
    .modern-card-body
      p {{"admin.restore.description" | translate}}
      button.btn.btn-premium-primary.btn-block.py-4(type='file' ngf-select='upload($file, $invalidFiles)' accept='*' ngf-max-size='5000MB' ng-hide="job")
        i.fas.fa-2x.fa-file-upload
        div.mt-2 {{'cabinet.upload' | translate}}
      .text-danger.mt-2(ng-if="errFile.$error") ERROR: {{errFile.$error}}
      .progress.mt-3(ng-show="f.progress > 0")
        .progress-bar(role='progressbar' style='width: {{f.progress}}%;' aria-valuenow='{{f.progress}}' aria-valuemin='0' aria-valuemax='100') {{f.progress}}%
      .text-danger.mt-2(ng-if="errorMsg") {{errorMsg}}

      .text-center.mt-4(ng-if="job.state")
        h4
          span.badge.badge-pill(ng-class="statusColour(job.state)")
            i.fas.mr-1(ng-class="statusIcon(job.state)")
            | {{firstUpper(job.state)}}
        .progress.mt-3
          .progress-bar(role='progressbar' style='width: {{job.progress}}%;' aria-valuenow='{{job.progress}}' aria-valuemin='0' aria-valuemax='100') {{job.progress}}%
      .text-danger.mt-2(ng-if="job.reason") {{job.reason}}
