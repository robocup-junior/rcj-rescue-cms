//- -*- tab-width: 2 -*-
extends ../includes/modern_layout

block vars
  - var ngAppDef = 'AdminBackup'

append scripts
  script.
    var competitionId = "#{competition_id}"
  script(src='/javascripts/admin/competition_backup.js?v=' + assetVersion)

block hero_breadcrumb
  a.breadcrumb-item(ng-click="go('/home')")
    i.fas.fa-home.mr-1
    | Home
  a.breadcrumb-item(ng-click="go('/admin')") Admin
  a.breadcrumb-item(ng-click="go('/admin/'+competitionId)") {{competition.name}}
  span.breadcrumb-item.active Backup

block hero_title
  | {{competition.name}}

block hero_subtitle
  | {{"admin.backup.title" | translate}}

block hero_actions
  if user.superDuperAdmin
    button.btn-action-icon(type='button' ng-click="open('/admin/queues/queue/backup')" uib-tooltip='{{"admin.backup.queue" | translate}}' tooltip-placement="bottom")
      i.fas.fa-bullseye

block main_content
  .row
    .col-lg-7
      .modern-card.mb-4
        .modern-card-header
          i.fas.fa-archive.mr-2
          | {{"admin.backup.title" | translate}}
        .modern-card-body
          p {{"admin.backup.description" | translate}}
          ul.text-muted.small
            li {{"admin.backup.item1" | translate}}
            li {{"admin.backup.item2" | translate}}
            li {{"admin.backup.item3" | translate}}
            li {{"admin.backup.item4" | translate}}
            li {{"admin.backup.item5" | translate}}
            li {{"admin.backup.item6" | translate}}
            li {{"admin.backup.item7" | translate}}
            li {{"admin.backup.item8" | translate}}
            li {{"admin.backup.item9" | translate}}
            li {{"admin.backup.item10" | translate}}
            li {{"admin.backup.item11" | translate}}
            li {{"admin.backup.item12" | translate}}
          p.small.text-muted {{"admin.backup.notInclude" | translate}}

          .d-flex.flex-wrap.justify-content-center.mt-4(ng-if="!job.state" style="gap: 0.75rem;")
            button.btn.btn-premium-dark(ng-click='exeBackup(false)' type="button")
              i.fas.fa-archive.mr-2
              | {{"admin.backup.exe" | translate}}
            button.btn.btn-premium-primary(ng-click='exeBackup(true)' type="button")
              i.fas.fa-archive.mr-2
              | FULL {{"admin.backup.exe" | translate}}

          .text-center.mt-4(ng-if="job.state")
            h4
              span.badge.badge-pill(ng-class="statusColour(job.state)")
                i.fas.mr-1(ng-class="statusIcon(job.state)")
                | {{firstUpper(job.state)}}
            .progress.mt-3(ng-if="job.progress > 0")
              .progress-bar(role='progressbar' style='width: {{job.progress}}%;' aria-valuenow='{{job.progress}}' aria-valuemin='0' aria-valuemax='100') {{job.progress}}%
            .text-danger.mt-2(ng-if="job.reason") {{job.reason}}

    .col-lg-5
      .modern-card.mb-4
        .modern-card-header
          i.fas.fa-history.mr-2
          | {{"admin.backup.backedup" | translate}}
        .modern-card-body.p-0
          .table-responsive(style="padding: 0 1.5rem 1.5rem;")
            table.table-modern.table-auto
              thead
                tr
                  th {{"admin.backup.time" | translate}}
                  th(style="width: 140px;") {{"common.operation" | translate}}
              tbody
                tr(ng-repeat='back in backedup | orderBy: "time"')
                  td
                    i.fas.fa-sync.mr-2.text-muted(ng-show="back.auto")
                    span.badge.badge-success.mr-2(ng-show="back.full") FULL
                    span(ng-bind='time(back.time)')
                  td
                    .btn-table-group
                      .btn-table-action.primary(ng-click="download(back.name)" uib-tooltip='Download')
                        i.fas.fa-download
                      .btn-table-action.danger(ng-click='delete(back.name)' uib-tooltip='{{"common.delete" | translate}}')
                        i.fas.fa-trash-alt
