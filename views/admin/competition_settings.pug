//- -*- tab-width: 2 -*-
extends ../includes/modern_layout

block vars
  - var ngAppDef = 'AdminSettings'

append scripts
  script.
    var competitionId = "#{competition_id}"
  script(src='/javascripts/admin/competition_settings.js')
  link(rel='stylesheet', href='/components/angular-color-picker/dist/angularjs-color-picker.min.css')
  script(src='/components/tinycolor/dist/tinycolor-min.js')
  script(src='/components/angular-color-picker/dist/angularjs-color-picker.min.js')

block hero_breadcrumb
  a.breadcrumb-item(ng-click="go('/home')")
    i.fas.fa-home.mr-1
    | Home
  a.breadcrumb-item(ng-click="go('/admin')") Admin
  a.breadcrumb-item(ng-click="go('/admin/'+competitionId)") {{competition.name}}
  span.breadcrumb-item.active Settings

block hero_title
  | {{competition.name}}

block hero_subtitle
  | {{"admin.settings.title" | translate}}

block hero_actions
  button.btn-hero-action(type='button' ng-click='set()')
    i.fas.fa-check
    | {{"admin.settings.set" | translate}}

block main_content
  //- Competition profile
  .row
    .col-lg-8
      .modern-card.mb-4
        .modern-card-header
          i.fas.fa-id-card.mr-2
          | {{"admin.settings.title" | translate}}
        .modern-card-body
          .form-group
            label {{"admin.settings.cname" | translate}}
            input.form-control(type='text' ng-model='cName')
          .row
            .col-md-6
              .form-group
                label {{"admin.settings.color" | translate}}
                color-picker(ng-model='cColor' options="{'format':'HEX'}")
            .col-md-6
              .form-group
                label {{"admin.settings.bkColor" | translate}}
                color-picker(ng-model='bColor' options="{'format':'HEX'}")
          .form-group
            label {{"admin.settings.description" | translate}}
            textarea.form-control(ng-model="description" rows=4)
          .row
            .col-md-6
              .form-group
                label {{"admin.settings.logo" | translate}}
                canvas#canvas(style="display:none;")
                input#select.form-control-file(type='file' name='select')
            .col-md-6
              .form-group
                label {{"admin.settings.preparation" | translate}}
                div
                  label.toggle-button-001
                    input(type='checkbox' ng-model="preparation")
          .form-group.mb-0
            label {{"admin.settings.mes" | translate}}
            textarea.form-control(ng-model="message" rows=5)

    .col-lg-4
      .modern-card.mb-4
        .modern-card-header
          i.fas.fa-eye.mr-2
          | {{"admin.settings.preview" | translate}}
        .modern-card-body
          .card(ng-click="go('/home/' + competition._id)" style="width:100%; text-align:center; border-radius: 1rem; overflow: hidden; cursor: pointer;" ng-style="{'backgroundColor': '#' + bColor}")
            img.card-img-top(ng-src="{{logo}}" alt='' style="max-height:300px; width:100%; object-fit: contain;")
            .card-body
              h3(style="text-align:center" ng-style="{'color': '#' + cColor}") {{cName}}
              p(ng-if="description" style="text-align:center" ng-style="{'color': '#' + cColor}" ng-bind-html="description")

  //- Ranking
  .modern-card.mb-4
    .modern-card-header
      .d-flex.justify-content-between.align-items-center.w-100
        div
          i.fas.fa-trophy.mr-2
          | {{"admin.settings.ranking" | translate}}
        button.btn.btn-sm.btn-premium-primary(type='button' ng-click='set()')
          i.fas.fa-check.mr-1
          | {{"admin.settings.set" | translate}}
    .modern-card-body.p-0
      .table-responsive(style="padding: 0 1.5rem 1.5rem;")
        table.table-modern.table-auto
          thead
            tr
              th {{"common.league" | translate}}
              th {{"admin.settings.discloseRanking" | translate}}
              th {{"admin.settings.rankingMode" | translate}}
              th(style="width: 110px;") {{"admin.settings.num" | translate}}
              th(style="width: 130px;") {{"common.rule" | translate}}
          tbody
            tr(ng-repeat="league in leagues track by $index")
              td.font-weight-bold {{allLeagues[league.league].name}}
              td
                label.toggle-button-001.mb-0
                  input(type='checkbox' ng-model="league.disclose")
              td
                select.form-control.form-control-sm(ng-model='league.mode')
                  option(value="SUM_OF_BEST_N_GAMES") SUM OF BEST N GAMES
                  option(value="MEAN_OF_NORMALIZED_BEST_N_GAMES") MEAN OF NORMALIZED BEST N GAMES
                  option(value="MEAN_OF_NORMALIZED_BEST_N_GAMES_NORMALIZED_DOCUMENT") 0.8 GAMES + 0.2 DOCUMENT
                  option(value="GAMES_DOCUMENT_CHALLENGE") 0.6 GAMES + 0.2 DOCUMENT + 0.2 TECHNICAL CHALLENGE
              td
                input.form-control.form-control-sm(type='number' ng-model='league.num')
              td
                select.form-control.form-control-sm(ng-model='league.rule' ng-options='rule for rule in allLeagues[league.league].rules')

  //- Authority
  .modern-card.mb-4
    .modern-card-header
      i.fas.fa-user-shield.mr-2
      | {{"admin.authority.title" | translate}}
    .modern-card-body.p-0
      p.text-muted.small.px-4.pt-3.mb-0 {{"admin.authority.description" | translate}}
      .table-responsive(style="padding: 0 1.5rem 1.5rem;")
        table.table-modern.table-auto
          thead
            tr
              th {{"admin.authority.name" | translate}}
              th {{"admin.authority.nowLevel" | translate}}
              th {{"common.operation" | translate}}
          tbody
            tr(ng-repeat='user in users')
              td
                i.fas.fa-user-tie.mr-2.text-muted(ng-if="!user.admin && !user.superDuperAdmin")
                i.fas.fa-user-shield.mr-2.text-primary(ng-if="user.admin")
                span.font-weight-bold {{user.username}}
              td
                span.badge.badge-pill.badge-dark(ng-if="user.superDuperAdmin") {{"admin.users.super" | translate}}
                span.badge.badge-pill.badge-secondary(ng-if="!user.superDuperAdmin && user.nowAuth <= 0") {{"admin.authority.level0" | translate}}
                span.badge.badge-pill.badge-info(ng-if="!user.superDuperAdmin && user.nowAuth == 1") {{"admin.authority.level1" | translate}}
                span.badge.badge-pill.badge-primary(ng-if="!user.superDuperAdmin && user.nowAuth == 5") {{"admin.authority.level5" | translate}}
                span.badge.badge-pill.badge-success(ng-if="!user.superDuperAdmin && user.nowAuth >= 10") {{"admin.authority.level10" | translate}}
              td
                .d-flex.flex-wrap(style="gap: 0.4rem;")
                  button.btn.btn-sm.btn-outline-secondary(ng-click='updateAuthority(user._id , 0)' type="button" ng-disabled="user.superDuperAdmin") {{"admin.authority.doLevel0" | translate}}
                  button.btn.btn-sm.btn-outline-info(ng-click='updateAuthority(user._id , 1)' type="button" ng-disabled="user.superDuperAdmin") {{"admin.authority.doLevel1" | translate}}
                  button.btn.btn-sm.btn-outline-primary(ng-click='updateAuthority(user._id , 5)' type="button" ng-disabled="user.superDuperAdmin") {{"admin.authority.doLevel5" | translate}}
                  button.btn.btn-sm.btn-outline-success(ng-click='updateAuthority(user._id , 10)' type="button" ng-disabled="user.superDuperAdmin || !user.admin") {{"admin.authority.doLevel10" | translate}}
                  button.btn.btn-sm.btn-outline-warning(ng-show='!hasRole(user, "INTERVIEW")' ng-click='grantRole(user , "INTERVIEW")' type="button")
                    i.far.fa-square.mr-1
                    | INTERVIEW
                  button.btn.btn-sm.btn-warning(ng-show='hasRole(user, "INTERVIEW")' ng-click='revokeRole(user , "INTERVIEW")' type="button")
                    i.fas.fa-check-square.mr-1
                    | INTERVIEW
