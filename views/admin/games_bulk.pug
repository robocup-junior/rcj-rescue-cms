//- -*- tab-width: 2 -*-
extends ../includes/modern_layout

block vars
  - var ngAppDef = 'RunAdmin'

append scripts
  script.
    var competitionId = "#{competitionId}"
    var leagueId = "#{leagueId}"
  script(src='/javascripts/admin/games_bulk.js')

append css
  link(href='/stylesheets/common/modern_editor.css', rel='stylesheet')
  style.
    .ui-select-bootstrap .dropdown-menu {
      display: initial;
    }
    .ui-select-bootstrap .ui-select-choices-row.active>span {
      color: initial;
      text-decoration: none;
      outline: 0;
      background-color: initial;
    }
    .ui-select-bootstrap .ui-select-choices-row > span {
      color: black !important;
      display: block;
      padding: 5px;
    }

block hero_breadcrumb
  a.breadcrumb-item(ng-click="go('/home')") Home
  a.breadcrumb-item(ng-click="go('/admin')") Admin
  a.breadcrumb-item(ng-click="go('/admin/'+competitionId)") {{competition.name}}
  a.breadcrumb-item(ng-click="go('/admin/'+competitionId+'/' + leagueId + '/games')") {{leagueId}} Games
  span.breadcrumb-item.active Bulk Registration

block hero_title
  | {{competition.name}}

block hero_subtitle
  i.fas.fa-file-import.mr-2
  | {{league.name}} - {{"admin.lineRunBulk.title" | translate}}

block main_content
  .premium-btn-group.mb-3(role='group' style="display: inline-flex;")
    button.btn(type='button' ng-click="mode='csv'" ng-class="{'active': mode == 'csv'}") CSV Import
    button.btn(type='button' ng-click="mode='generator'" ng-class="{'active': mode == 'generator'}") Generator

  div(ng-if="mode == 'csv'")
    h5.section-heading.mb-2
      i.fas.fa-download
      | {{"admin.lineRunBulk.s1T" | translate}}
    .modern-card
      .modern-card-body
        p {{"admin.lineRunBulk.s1D" | translate}}
        a.btn-premium.btn-premium-dark(href="/tmp/run_bulk.csv")
          i.fas.fa-download
          | Download!

  div(ng-show="mode == 'generator'")
    h5.section-heading.mb-2
      i.fas.fa-magic
      | {{'admin.lineRunBulk.generatorTitle' | translate}}
    .modern-card
      .modern-card-body
        .alert.alert-info
          strong {{'admin.lineRunBulk.generatorInfoTitle' | translate}}
          br
          | {{'admin.lineRunBulk.generatorInfo1' | translate}}
          br
          | {{'admin.lineRunBulk.generatorInfo2' | translate}}
          br
          | {{'admin.lineRunBulk.generatorInfo3' | translate}}
          br
          | {{'admin.lineRunBulk.generatorInfo4' | translate}}
          br
          | {{'admin.lineRunBulk.generatorInfo5' | translate}}
          br
          | {{'admin.lineRunBulk.generatorInfo6' | translate}}
          br
          | {{'admin.lineRunBulk.generatorInfo7' | translate}}
          br
          | {{'admin.lineRunBulk.generatorInfo8' | translate}}
          br
          | {{'admin.lineRunBulk.generatorInfo9' | translate}}
        p.text-muted
          strong {{'admin.lineRunBulk.generatorExampleTitle' | translate}}
          |  {{'admin.lineRunBulk.generatorExampleText' | translate}}

        .settings-group
          label.settings-label {{'admin.lineRunBulk.generatorTeams' | translate}}
          ui-select(
            multiple=''
            ng-model='generator.selectedTeams'
            theme='bootstrap'
            sortable='true'
            close-on-select='false'
            reset-search-input='false'
            style='width:100%;'
          )
            ui-select-match(placeholder="{{'admin.lineRunBulk.generatorSearchTeams' | translate}}")
              | {{$item.name}}
            ui-select-choices(repeat='team in teams | filter: $select.search')
              span {{team.name}}

        .settings-group
          label.settings-label {{'admin.lineRunBulk.generatorRounds' | translate}}
          ui-select(
            multiple=''
            ng-model='generator.selectedRounds'
            theme='bootstrap'
            sortable='true'
            close-on-select='false'
            reset-search-input='false'
            style='width:100%;'
          )
            ui-select-match(placeholder="{{'admin.lineRunBulk.generatorSearchRounds' | translate}}")
              | {{$item.name}}
            ui-select-choices(repeat='round in rounds | filter: $select.search')
              span {{round.name}}

        .settings-group
          label.settings-label {{'admin.lineRunBulk.generatorFields' | translate}}
          ui-select(
            multiple=''
            ng-model='generator.selectedFields'
            theme='bootstrap'
            sortable='true'
            close-on-select='false'
            reset-search-input='false'
            style='width:100%;'
          )
            ui-select-match(placeholder="{{'admin.lineRunBulk.generatorSearchFields' | translate}}")
              | {{$item.name}}
            ui-select-choices(repeat='field in fields | filter: $select.search')
              span {{field.name}}

        .settings-group
          label.settings-label {{'admin.lineRunBulk.generatorMaps' | translate}}
          ui-select(
            multiple=''
            ng-model='generator.selectedMaps'
            theme='bootstrap'
            sortable='true'
            close-on-select='false'
            reset-search-input='false'
            style='width:100%;'
          )
            ui-select-match(placeholder="{{'admin.lineRunBulk.generatorSearchMaps' | translate}}")
              | {{$item.name}}
            ui-select-choices(repeat='map in maps | filter: $select.search')
              span {{map.name}}

        .row
          .col-md-2
            .settings-group
              label.settings-label {{'admin.lineRunBulk.generatorDays' | translate}}
              input.premium-input(type='number' ng-model='generator.totalDays')

          .col-md-2
            .settings-group
              label.settings-label {{'admin.lineRunBulk.generatorSlotMinutes' | translate}}
              input.premium-input(type='number' ng-model='generator.slotMinutes')

          .col-md-2
            .settings-group
              label.settings-label {{'admin.lineRunBulk.generatorSmallBreakMultiplier' | translate}}
              input.premium-input(type='number' ng-model='generator.smallBreakMultiplier')

          .col-md-2
            .settings-group
              label.settings-label {{'admin.lineRunBulk.generatorLunchMinutes' | translate}}
              input.premium-input(type='number' ng-model='generator.lunchBreakMinutes')

          .col-md-4
            .settings-group
              label.settings-label {{'admin.lineRunBulk.generatorStartTime' | translate}}
              input.premium-input(type='datetime-local' ng-model='generator.startTime')

        .settings-group.mb-0
          label.settings-label {{'admin.lineRunBulk.generatorScheduleMode' | translate}}
          select.premium-select(ng-model='generator.scheduleMode')
            option(value='scrambled') {{'admin.lineRunBulk.generatorModeScrambled' | translate}}
            option(value='fixedMap') {{'admin.lineRunBulk.generatorModeFixed' | translate}}

          small.form-text.text-muted(ng-if="generator.scheduleMode == 'fixedMap'")
            | {{'admin.lineRunBulk.generatorModeFixedDesc1' | translate}}
            br
            | {{'admin.lineRunBulk.generatorModeFixedDesc2' | translate}}
          small.form-text.text-muted(ng-if="generator.scheduleMode == 'scrambled'")
            | {{'admin.lineRunBulk.generatorModeScrambledDesc' | translate}}

        .add-item-row
          button.btn-premium.btn-premium-primary(ng-click='generateSchedule()')
            i.fas.fa-magic
            | {{'admin.lineRunBulk.generatorButton' | translate}}

        .alert.alert-warning.mb-0
          strong {{'admin.lineRunBulk.generatorDisclaimerTitle' | translate}}
          |  {{'admin.lineRunBulk.generatorDisclaimerText' | translate}}

  div(ng-show="mode == 'csv'")
    h5.section-heading.section-gap.mb-2
      i.fas.fa-info-circle
      | {{"admin.lineRunBulk.s2T" | translate}}
    .modern-card
      .modern-card-body
        p {{"admin.lineRunBulk.s2D1" | translate}}
        p {{"admin.lineRunBulk.s2D2" | translate}}

        .modern-table-card
          table.custom
            thead
              tr
                th {{"common.round" | translate}}
            tbody
              tr(ng-repeat='round in rounds')
                td(ng-bind='round.name')

        hr

        p {{"admin.lineRunBulk.s2D3" | translate}}
        .modern-table-card
          table.custom
            thead
              tr
                th {{"common.team" | translate}}
            tbody
              tr(ng-repeat='team in teams')
                td(ng-bind='team.name')

        hr

        div(ng-hide="league.type == 'simulation'")
          p {{"admin.lineRunBulk.s2D4" | translate}}
          .modern-table-card
            table.custom
              thead
                tr
                  th {{"common.map" | translate}}
              tbody
                tr(ng-repeat='map in maps')
                  td(ng-bind='map.name')
          hr

        p {{"admin.lineRunBulk.s2D5" | translate}}
        .modern-table-card
          table.custom
            thead
              tr
                th {{"common.field" | translate}}
            tbody
              tr(ng-repeat='field in fields')
                td(ng-bind='field.name')

        hr

        p {{"admin.lineRunBulk.s2D6" | translate}}
        p.mb-0 yyyy/mm/dd hh:ss
          | ex) 2017/07/27 10:35

    h5.section-heading.section-gap.mb-2
      i.fas.fa-upload
      | {{"admin.lineRunBulk.s3T" | translate}}
    .modern-card
      .modern-card-body.mb-0
        input#select(type="file" name="select")
        p.mb-0 {{"admin.lineRunBulk.s3D" | translate}}

  #result
  br
  center(ng-if="processing")
    img(src="/images/loader2.gif")
    p {{now}} / {{total}} {{"admin.lineRunBulk.inpro" | translate}}
  center(ng-if="completed" style="color:#2ecc71;")
    i.far.fa-check-circle.fa-5x(aria-hidden="true")
    p {{total}} {{"admin.lineRunBulk.complete" | translate}}
  center(ng-if="error" style="color:#e74c3c;")
    i.fas.fa-exclamation-circle.fa-5x(aria-hidden="true")
    p {{now}} / {{total}} ERROR

  .add-item-row
    button.btn-premium.btn-premium-primary(ng-click="addRun()")
      i.fas.fa-check
      | {{"admin.lineRunBulk.exe" | translate}}
