//- -*- tab-width: 2 -*-
extends ../../includes/layout

block vars
  - var ngAppDef = 'MazeEditor'

append scripts
  script.
    var mapId = "#{mapId}"
    var competitionId = "#{competitionId}"
    var pubService = "#{pubService}"
    var leagueId = "#{leagueId}"

  script(src="/javascripts/admin/mapEditor/maze_2026.js")
  
  script(src="/javascripts/lvl-uuid.js")
  script(src="/components/bootstrap-fileinput/js/fileinput.min.js")
  script(src="/components/bootstrap-fileinput/themes/fa/theme.min.js")
  script(src="/components/bootstrap-fileinput/js/locales/ja.js")
  script(src="/components/html2canvas/index.js")

append css
  link(href="/stylesheets/maze_edit.css" rel="stylesheet")
  link(href="/stylesheets/maze_modern.css" rel="stylesheet")
  link(href="/components/bootstrap-fileinput/css/fileinput.min.css" rel="stylesheet")

block location
    a.breadcrumb-item(ng-click="go('/home')") Home
    if !pubService
        a.breadcrumb-item(ng-click="go('/admin')") Admin
        a.breadcrumb-item(ng-click="go('/admin/'+competitionId)") {{competition.name}}
        a.breadcrumb-item(ng-click="go('/admin/'+competitionId + '/' + league.league + '/maps')") #{leagueId} maps
        span.breadcrumb-item.active Editor
    else
        a.breadcrumb-item(ng-click="go('/service')") Public services
        span.breadcrumb-item.active #{leagueId} editor

block content
    .modern-toolbar.mb-2
        .d-flex.align-items-center.w-100
            .fancy-input-group.mb-0.mr-2(style="flex-grow: 1; max-width: 300px;")
                .input-group.input-group-sm
                    .input-group-prepend
                        span.input-group-text
                            i.fas.fa-tag
                    input.form-control(type='text', ng-model='name', placeholder='{{"admin.mazeMapEditor.mapName" | translate}}')
            
            if !pubService
                .btn-group.mr-2
                    button.btn.btn-sm.btn-success.shadow-sm(type='button', ng-click='saveMap()')
                        i.fas.fa-save.mr-1
                        | {{"admin.mazeMapEditor.save" | translate}}
                    if !parent
                        button.btn.btn-sm.btn-outline-success(type='button', data-toggle="collapse", data-target="#saveAsCollapse")
                            i.fas.fa-copy
            
            .d-flex.align-items-center.mr-2
                span.small.font-weight-bold.text-muted.mr-2 JSON
                .btn-group
                    button.btn.btn-sm.btn-outline-dark(type='button', ng-click='export()', title='Export JSON')
                        i.fas.fa-file-export
                    button.btn.btn-sm.btn-outline-dark(type='button', onclick="$('#select').click()", title='Import JSON')
                        i.fas.fa-file-import
            
            div(style="display:none;")
                input#select(type='file', name='select')
            
            .ml-auto.d-flex.align-items-center
                if !pubService
                    .custom-control.custom-switch.mr-3(ng-show='(dice[0]&&dice[1]&&dice[2]&&dice[3]&&dice[4]&&dice[5]) || parent')
                        input#isFinished.custom-control-input(type='checkbox', ng-model='finished')
                        label.custom-control-label.small.font-weight-bold(for='isFinished') {{"admin.mazeMapEditor.finished" | translate}}
                    .d-flex.align-items-center.px-3.py-1.mr-3.rounded(ng-show='!(dice[0]&&dice[1]&&dice[2]&&dice[3]&&dice[4]&&dice[5])&&!parent', style="background-color: #fffbeb; color: #b45309; border: 1px solid #fde68a; font-size: 0.85rem; font-weight: 600;")
                        i.fas.fa-exclamation-triangle.mr-2
                        | {{"admin.mazeMapEditor.patYet" | translate}}
                if parent
                    button.btn.btn-sm.btn-light.shadow-sm(type='button', ng-click='saveMap(parent)')
                        i.fas.fa-chevron-left.mr-1
                        | {{"admin.mazeMapEditor.back" | translate}}
    
    #saveAsCollapse.collapse.mb-2
        .modern-card.bg-light.border-success.mb-0
            .modern-card-body.p-2
                .row.no-gutters.align-items-center
                    .col-md-4.px-1
                        input.form-control.form-control-sm(type='text', ng-model='asname', placeholder='New name')
                    .col-md-5.px-1
                        select.custom-select.custom-select-sm(ng-model='$parent.se_competition', ng-options='b_competitions._id as b_competitions.name for b_competitions in competitions')
                    .col-md-3.px-1
                        button.btn.btn-sm.btn-success.btn-block(type='button', ng-click='saveMapAs(asname)') Save As

    .row
        div(class=pubService ? 'col-12' : 'col-lg-9')
            .modern-toolbar.py-2.mb-3(style="background: #f8fafc; border-radius: 8px;")
                .row.no-gutters.w-100.align-items-center
                    .col-auto.px-3.border-right
                        span.small.text-muted.font-weight-bold
                            i.fas.fa-ruler-combined.mr-2
                            | {{"admin.mazeMapEditor.dimensions" | translate}}
                    .col.px-2
                        .d-flex.justify-content-start.ml-3.gap-4
                            .d-flex.align-items-center.mr-4(title='{{"admin.mazeMapEditor.height" | translate}}')
                                label.small.mb-0.mr-2.text-muted
                                    i.fas.fa-layer-group.mr-1
                                input.form-control.form-control-sm(type='number', ng-model='height', ng-change='sliderOptions.ceil = height - 1', min='1', style="width: 70px;")
                            .d-flex.align-items-center.mr-4(title='{{"admin.mazeMapEditor.width" | translate}}')
                                label.small.mb-0.mr-2.text-muted
                                    i.fas.fa-arrows-alt-h.mr-1
                                input.form-control.form-control-sm(type='number', ng-model='width', min='1', style="width: 70px;")
                            .d-flex.align-items-center(title='{{"admin.mazeMapEditor.length" | translate}}')
                                label.small.mb-0.mr-2.text-muted
                                    i.fas.fa-arrows-alt-v.mr-1
                                input.form-control.form-control-sm(type='number', ng-model='length', min='1', style="width: 70px;")
                    .col-auto.px-3.border-left
                        .d-flex.align-items-center(title='{{"admin.simMapEditor.timelimit" | translate}}')
                            label.small.mb-0.mr-2.text-muted
                                i.fas.fa-clock.mr-1
                                | {{"admin.mazeMapEditor.time" | translate}}
                            input.form-control.form-control-sm(type='number', ng-model='duration', min='1', style="width: 70px;")

            .d-flex.mb-3
                .floor-switcher-vertical.d-flex.flex-column-reverse.p-2.bg-dark.border-right(style="min-width: 60px; border-top-left-radius: 8px; border-bottom-left-radius: 8px;")
                    button.btn.btn-sm.btn-outline-light.mb-2.w-100(type='button', ng-click='changeFloor(zz)', ng-repeat='zz in range(height)', ng-class='{active: zz == z}', style="font-weight: bold;") F{{zz}}
                    .text-center.text-light.pb-2.mb-2.border-bottom.border-secondary(title='{{"admin.mazeMapEditor.height" | translate}}', style="opacity: 0.8;")
                        i.fas.fa-layer-group
                .modern-card.flex-grow-1.mb-0.overflow-hidden(style="border-top-left-radius: 0; border-bottom-left-radius: 0; border-left: none;")
                    .modern-card-body.p-0
                        .map-container(style="overflow-x: auto; border-top-left-radius: 0; border-bottom-left-radius: 0;")
                            table
                                tbody
                                    tr(ng-repeat='r in range(2*length + 1)')
                                        td(ng-repeat='c in range(2*width + 1)', ng-class="{'wallspot': $odd != $parent.$odd, 'tile': $odd && $parent.$odd, 'wall': cells[c+','+r+','+z].isWall, 'checkpoint': cells[c+','+r+','+z].tile.checkpoint, 'black': cells[c+','+r+','+z].tile.black, 'blue': cells[c+','+r+','+z].tile.blue, 'red': cells[c+','+r+','+z].tile.red, 'linear': cells[c+','+r+','+z].tile.reachable && cells[c+','+r+','+z].isLinear, 'floating': cells[c+','+r+','+z].tile.reachable && !cells[c+','+r+','+z].isLinear}", ng-click='cellClick(c, r, z, $odd != $parent.$odd, $odd && $parent.$odd)', ng-style="wallColor(c,r,z)")
                                            .tile-image-container(ng-show="$odd && $parent.$odd")
                                                img.tile-image(ng-src='/images/log.png', ng-show="cells[c+','+r+','+z].tile.speedbump")
                                                img.tile-image(ng-src='/images/start.png', ng-show='startTile.x == c && startTile.y == r && startTile.z == z')
                                                img.tile-image(ng-src='/images/elevator.png', ng-show="!isUndefined(cells[c+','+r+','+z].tile.changeFloorTo) && cells[c+','+r+','+z].tile.changeFloorTo != z")
                                                img.tile-image(ng-src='/images/ramp.png', ng-show="cells[c+','+r+','+z].tile.ramp")
                                                img.tile-image(ng-src='/images/steps.png', ng-show="cells[c+','+r+','+z].tile.steps")
                                                img.tile-image(ng-src='/images/phi_top.png', ng-show="cells[c+','+r+','+z].tile.victims.top == 'PHI'")
                                                img.tile-image(ng-src='/images/phi_right.png', ng-show="cells[c+','+r+','+z].tile.victims.right == 'PHI'")
                                                img.tile-image(ng-src='/images/phi_bottom.png', ng-show="cells[c+','+r+','+z].tile.victims.bottom == 'PHI'")
                                                img.tile-image(ng-src='/images/phi_left.png', ng-show="cells[c+','+r+','+z].tile.victims.left == 'PHI'")
                                                img.tile-image(ng-src='/images/psi_top.png', ng-show="cells[c+','+r+','+z].tile.victims.top == 'PSI'")
                                                img.tile-image(ng-src='/images/psi_right.png', ng-show="cells[c+','+r+','+z].tile.victims.right == 'PSI'")
                                                img.tile-image(ng-src='/images/psi_bottom.png', ng-show="cells[c+','+r+','+z].tile.victims.bottom == 'PSI'")
                                                img.tile-image(ng-src='/images/psi_left.png', ng-show="cells[c+','+r+','+z].tile.victims.left == 'PSI'")
                                                img.tile-image(ng-src='/images/omega_top.png', ng-show="cells[c+','+r+','+z].tile.victims.top == 'OMEGA'")
                                                img.tile-image(ng-src='/images/omega_right.png', ng-show="cells[c+','+r+','+z].tile.victims.right == 'OMEGA'")
                                                img.tile-image(ng-src='/images/omega_bottom.png', ng-show="cells[c+','+r+','+z].tile.victims.bottom == 'OMEGA'")
                                                img.tile-image(ng-src='/images/omega_left.png', ng-show="cells[c+','+r+','+z].tile.victims.left == 'OMEGA'")
                                                //- Cognitive Target displays
                                                .tile-image-container(ng-if="cells[c+','+r+','+z].tile.victims.top == 'Cognitive' && cells[c+','+r+','+z].tile.cognitiveTargets && cells[c+','+r+','+z].tile.cognitiveTargets.top && cells[c+','+r+','+z].tile.cognitiveTargets.top.rings", style="position: absolute; top: 0; left: 0; z-index: 1;")
                                                    img.tile-image(ng-src="{{'/images/cognitive_rings/top_ring1_' + cells[c+','+r+','+z].tile.cognitiveTargets.top.rings.ring1 + '.png'}}", style="position: absolute; top: 0; left: 0; z-index: 1;")
                                                    img.tile-image(ng-src="{{'/images/cognitive_rings/top_ring2_' + cells[c+','+r+','+z].tile.cognitiveTargets.top.rings.ring2 + '.png'}}", style="position: absolute; top: 0; left: 0; z-index: 2;")
                                                    img.tile-image(ng-src="{{'/images/cognitive_rings/top_ring3_' + cells[c+','+r+','+z].tile.cognitiveTargets.top.rings.ring3 + '.png'}}", style="position: absolute; top: 0; left: 0; z-index: 3;")
                                                    img.tile-image(ng-src="{{'/images/cognitive_rings/top_ring4_' + cells[c+','+r+','+z].tile.cognitiveTargets.top.rings.ring4 + '.png'}}", style="position: absolute; top: 0; left: 0; z-index: 4;")
                                                    img.tile-image(ng-src="{{'/images/cognitive_rings/top_ring5_' + cells[c+','+r+','+z].tile.cognitiveTargets.top.rings.ring5 + '.png'}}", style="position: absolute; top: 0; left: 0; z-index: 5;")
                                                .tile-image-container(ng-if="cells[c+','+r+','+z].tile.victims.right == 'Cognitive' && cells[c+','+r+','+z].tile.cognitiveTargets && cells[c+','+r+','+z].tile.cognitiveTargets.right && cells[c+','+r+','+z].tile.cognitiveTargets.right.rings", style="position: absolute; top: 0; left: 0; z-index: 2;")
                                                    img.tile-image(ng-src="{{'/images/cognitive_rings/right_ring1_' + cells[c+','+r+','+z].tile.cognitiveTargets.right.rings.ring1 + '.png'}}", style="position: absolute; top: 0; left: 0; z-index: 1;")
                                                    img.tile-image(ng-src="{{'/images/cognitive_rings/right_ring2_' + cells[c+','+r+','+z].tile.cognitiveTargets.right.rings.ring2 + '.png'}}", style="position: absolute; top: 0; left: 0; z-index: 2;")
                                                    img.tile-image(ng-src="{{'/images/cognitive_rings/right_ring3_' + cells[c+','+r+','+z].tile.cognitiveTargets.right.rings.ring3 + '.png'}}", style="position: absolute; top: 0; left: 0; z-index: 3;")
                                                    img.tile-image(ng-src="{{'/images/cognitive_rings/right_ring4_' + cells[c+','+r+','+z].tile.cognitiveTargets.right.rings.ring4 + '.png'}}", style="position: absolute; top: 0; left: 0; z-index: 4;")
                                                    img.tile-image(ng-src="{{'/images/cognitive_rings/right_ring5_' + cells[c+','+r+','+z].tile.cognitiveTargets.right.rings.ring5 + '.png'}}", style="position: absolute; top: 0; left: 0; z-index: 5;")
                                                .tile-image-container(ng-if="cells[c+','+r+','+z].tile.victims.bottom == 'Cognitive' && cells[c+','+r+','+z].tile.cognitiveTargets && cells[c+','+r+','+z].tile.cognitiveTargets.bottom && cells[c+','+r+','+z].tile.cognitiveTargets.bottom.rings", style="position: absolute; top: 0; left: 0; z-index: 3;")
                                                    img.tile-image(ng-src="{{'/images/cognitive_rings/bottom_ring1_' + cells[c+','+r+','+z].tile.cognitiveTargets.bottom.rings.ring1 + '.png'}}", style="position: absolute; top: 0; left: 0; z-index: 1;")
                                                    img.tile-image(ng-src="{{'/images/cognitive_rings/bottom_ring2_' + cells[c+','+r+','+z].tile.cognitiveTargets.bottom.rings.ring2 + '.png'}}", style="position: absolute; top: 0; left: 0; z-index: 2;")
                                                    img.tile-image(ng-src="{{'/images/cognitive_rings/bottom_ring3_' + cells[c+','+r+','+z].tile.cognitiveTargets.bottom.rings.ring3 + '.png'}}", style="position: absolute; top: 0; left: 0; z-index: 3;")
                                                    img.tile-image(ng-src="{{'/images/cognitive_rings/bottom_ring4_' + cells[c+','+r+','+z].tile.cognitiveTargets.bottom.rings.ring4 + '.png'}}", style="position: absolute; top: 0; left: 0; z-index: 4;")
                                                    img.tile-image(ng-src="{{'/images/cognitive_rings/bottom_ring5_' + cells[c+','+r+','+z].tile.cognitiveTargets.bottom.rings.ring5 + '.png'}}", style="position: absolute; top: 0; left: 0; z-index: 5;")
                                                .tile-image-container(ng-if="cells[c+','+r+','+z].tile.victims.left == 'Cognitive' && cells[c+','+r+','+z].tile.cognitiveTargets && cells[c+','+r+','+z].tile.cognitiveTargets.left && cells[c+','+r+','+z].tile.cognitiveTargets.left.rings", style="position: absolute; top: 0; left: 0; z-index: 4;")
                                                    img.tile-image(ng-src="{{'/images/cognitive_rings/left_ring1_' + cells[c+','+r+','+z].tile.cognitiveTargets.left.rings.ring1 + '.png'}}", style="position: absolute; top: 0; left: 0; z-index: 1;")
                                                    img.tile-image(ng-src="{{'/images/cognitive_rings/left_ring2_' + cells[c+','+r+','+z].tile.cognitiveTargets.left.rings.ring2 + '.png'}}", style="position: absolute; top: 0; left: 0; z-index: 2;")
                                                    img.tile-image(ng-src="{{'/images/cognitive_rings/left_ring3_' + cells[c+','+r+','+z].tile.cognitiveTargets.left.rings.ring3 + '.png'}}", style="position: absolute; top: 0; left: 0; z-index: 3;")
                                                    img.tile-image(ng-src="{{'/images/cognitive_rings/left_ring4_' + cells[c+','+r+','+z].tile.cognitiveTargets.left.rings.ring4 + '.png'}}", style="position: absolute; top: 0; left: 0; z-index: 4;")
                                                    img.tile-image(ng-src="{{'/images/cognitive_rings/left_ring5_' + cells[c+','+r+','+z].tile.cognitiveTargets.left.rings.ring5 + '.png'}}", style="position: absolute; top: 0; left: 0; z-index: 5;")
        
        if !pubService
            .col-lg-3
                .modern-card(ng-if='!parent')
                    .modern-card-header
                        i.fas.fa-dice.mr-2
                        | {{"admin.mazeMapEditor.pattern" | translate}}
                    .modern-card-body.p-2
                        p.text-muted.small.mb-2(ng-if="mapId == ''")
                            | {{"admin.mazeMapEditor.patSave" | translate}}
                        div(ng-if="mapId != ''")
                            .dice-slot.p-2.mb-1(ng-repeat='i in range(6)')
                                i.fas.fa-2x.text-secondary(ng-class="['fa-dice-one', 'fa-dice-two', 'fa-dice-three', 'fa-dice-four', 'fa-dice-five', 'fa-dice-six'][i]", style="width: 32px; text-align: center;")
                                .dice-select.flex-grow-1
                                    select.form-control.form-control-sm(ng-model='dice[i]', ng-options='b_maps._id as b_maps.name for b_maps in maps')
                                .btn-group
                                    button.btn.btn-xs.btn-outline-primary.px-2(type='button', ng-click='childNew(i+1)')
                                        i.fas.fa-plus
                                    button.btn.btn-xs.btn-outline-secondary.px-2(type='button', ng-click='saveMap(dice[i])')
                                        i.fas.fa-edit
                
                .alert.alert-danger.small.py-2(ng-if='startNotSet()')
                    i.fas.fa-exclamation-circle.mr-1
                    | {{"admin.mazeMapEditor.noStart" | translate}}

    //- Advanced Tools
    .modern-card
        .modern-card-header(data-toggle="collapse", data-target="#outputCollapse", style="cursor: pointer;")
            i.fas.fa-file-export.mr-2
            | {{"admin.mazeMapEditor.advancedTools" | translate}}
            .ml-auto
                i.fas.fa-chevron-down
            
        #outputCollapse.collapse
            .modern-card-body.bg-light
                .row.align-items-stretch
                    .col-md-6.mb-3.mb-md-0
                        .modern-card.h-100.mb-0
                            .modern-card-header.bg-white
                                i.fas.fa-print.mr-2
                                | {{"admin.mazeMapEditor.scoreSheetPreparation" | translate}}
                            .modern-card-body.d-flex.flex-column
                                p.small.text-muted.mb-3 {{"admin.mazeMapEditor.scoreSheetPreparationDesc" | translate}}
                                .row.no-gutters.mt-auto
                                    .col-6.pr-1
                                        button.btn.btn-sm.btn-outline-primary.btn-block(type='button', ng-click='makeImageDl()')
                                            i.fas.fa-download.mr-1
                                            | {{"admin.mazeMapEditor.downloadImage" | translate}}
                                    .col-6.pl-1
                                        button.btn.btn-sm.btn-outline-secondary.btn-block(type='button', ng-click='generateScoreSheet()')
                                            i.fas.fa-file-pdf.mr-1
                                            | {{"admin.mazeMapEditor.prepareSheets" | translate}}
                    
                    .col-md-6(ng-if='hasPrintableTargets()')
                        .modern-card.h-100.mb-0
                            .modern-card-header(style='background: var(--primary-gradient); color: white; border: none;')
                                i.fas.fa-print.mr-2(style='color: white;')
                                | {{"admin.mazeMapEditor.targetsPDF" | translate}}
                            .modern-card-body.d-flex.flex-column
                                .row.no-gutters.mb-auto
                                    .col-6.pr-1
                                        select.form-control.form-control-sm(ng-model='pdfSettings.paperSize', ng-change='onPaperSizeChange()')
                                            option(value='A4') A4
                                            option(value='Letter') Letter
                                    .col-6.pl-1
                                        button.btn.btn-sm.btn-primary.btn-block(type='button', ng-click='generateCompetitionTargetsPDF()')
                                            i.fas.fa-print.mr-1
                                            | {{"admin.mazeMapEditor.printPDF" | translate}}
                                .mt-3.px-1.d-flex.flex-wrap
                                    .custom-control.custom-checkbox.mr-3
                                        input#includeCognitiveTargetsCheckbox.custom-control-input(type='checkbox', ng-model='pdfSettings.includeCognitiveTargets')
                                        label.custom-control-label.small(for='includeCognitiveTargetsCheckbox') {{"admin.mazeMapEditor.cognitiveTargets" | translate}}
                                    .custom-control.custom-checkbox
                                        input#includeLetterVictimsCheckbox.custom-control-input(type='checkbox', ng-model='pdfSettings.includeLetterVictims')
                                        label.custom-control-label.small(for='includeLetterVictimsCheckbox') {{"admin.mazeMapEditor.letterVictims" | translate}}

        .row(style="position: absolute; top: -9999px; left: -9999px; opacity: 0; pointer-events: none;")
            #outputImageArea(style="padding-top:100px;padding-left:0px;padding-right:0px;padding-bottom:100px;")
                style.
                    .maru {
                        display: inline-flex;
                        justify-content: center;
                        align-items: center;
                        border-radius: 50%;
                        flex-flow: column;
                        vertical-align: top;
                    }
                    .size_normal{
                        width: 15px;
                        height: 15px;
                    }
                    .letter3 {
                        font-size: 1em;
                        line-height: 1.5em;
                        color: white;
                    }
                    .blue1 {
                        color: #3498db;
                        background-color: #3498db;
                    }
                    .pink1 {
                        color: #e84393;
                        background-color: #e84393;
                    }
                    .gray1 {
                        color: #95a5a6;
                        background-color: #95a5a6;
                    }
                div(ng-repeat='z in range(height)')
                    table
                        tbody
                            tr(ng-repeat='r in range(2*length + 1)')
                                td(ng-repeat='c in range(2*width + 1)', ng-show="showCellOutput(c,r,z)", ng-class="{'wallspot': $odd != $parent.$odd, 'tile': $odd && $parent.$odd, 'wall': cells[c+','+r+','+z].isWall, 'checkpoint': cells[c+','+r+','+z].tile.checkpoint, 'black': cells[c+','+r+','+z].tile.black, 'blue': cells[c+','+r+','+z].tile.blue, 'red': cells[c+','+r+','+z].tile.red, 'linear': cells[c+','+r+','+z].tile.reachable && cells[c+','+r+','+z].isLinear, 'floating': cells[c+','+r+','+z].tile.reachable && !cells[c+','+r+','+z].isLinear}" , ng-style="wallColor(c,r,z)")
                                    .tile-image-container(ng-show="$odd && $parent.$odd")
                                        div.maru.size_normal.blue1(style="left:1px;top:1px;position: absolute;border-radius:0%;z-index:3;" ng-if="cells[c+','+r+','+z].tile.checkpoint")
                                            div.letter3(ng-bind="itemNumber('checkpoint',c,r,z)")
                                        div(style="position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); background: white; color: #3498db; border-radius: 50%; width: 15px; height: 15px; display: flex; align-items: center; justify-content: center; font-size: 0.75em; font-weight: bold; z-index: 3;" ng-if="cells[c+','+r+','+z].tile.blue")
                                            span(ng-bind="itemNumber('blue',c,r,z)")
