//- -*- tab-width: 2 -*-
extends ../../includes/layout

block vars
  - var ngAppDef = 'MazeEditor'

append scripts
  script.
    var mapId = "#{mapId}"
    var competitionId = "#{competitionId}"
    var pubService = "#{pubService}"
    var leagueId = "#{leagueId}"

  script(src="/javascripts/admin/mapEditor/maze_2026.js")
  
  script(src="/javascripts/lvl-uuid.js")
  script(src="/components/bootstrap-fileinput/js/fileinput.min.js")
  script(src="/components/bootstrap-fileinput/themes/fa/theme.min.js")
  script(src="/components/bootstrap-fileinput/js/locales/ja.js")
  script(src="/components/html2canvas/index.js")

append css
  link(href="/stylesheets/maze_edit.css" rel="stylesheet")
  link(href="/components/bootstrap-fileinput/css/fileinput.min.css" rel="stylesheet")

block location
    a.breadcrumb-item(ng-click="go('/home')") Home
    if !pubService
        a.breadcrumb-item(ng-click="go('/admin')") Admin
        a.breadcrumb-item(ng-click="go('/admin/'+competitionId)") {{competition.name}}
        a.breadcrumb-item(ng-click="go('/admin/'+competitionId + '/' + league.league + '/maps')") #{leagueId} maps
        span.breadcrumb-item.active Editor
    else
        a.breadcrumb-item(ng-click="go('/service')") Public services
        span.breadcrumb-item.active #{leagueId} editor

block content
    if !pubService
        h3 {{competition.name}}
    h1 {{league.name}} {{"admin.mazeMapEditor.title" | translate}} 2026
    p {{"admin.mazeMapEditor.desc" | translate}}
    h2(ng-if='parent') {{"admin.mazeMapEditor.parent" | translate}}
    button.btn.btn-info(type='button', ng-click='saveMap(parent)', ng-if='parent') {{"admin.mazeMapEditor.backToParent" | translate}}
    div(style='margin-top:50px;')
        .row
            .col-md-4
                button.btn.btn-dark(type='button', ng-click='export()') {{"admin.mazeMapEditor.export" | translate}}
            .col-md-4
                input#select(type='file', name='select')
            .col-md-4(style="text-align:right;")
                if pubService
                    button.btn.btn-info(type='button', ng-click='makeImageDl()') {{"admin.lineMapEditor.generateImage" | translate}}
                else
                    button.btn.btn-info(type='button', ng-click='makeImage()') {{"admin.lineMapEditor.prepareScoresheets" | translate}}
        br
        .row
            .col-md-12
                if pubService
                    .input-group.mb-3
                        .input-group-prepend
                            span.input-group-text {{"admin.mazeMapEditor.name" | translate}}
                        input.form-control(type='text', ng-model='name')
                        .input-group-append
                            button.btn.btn-secondary(type='button', ng-click='export()') {{"admin.mazeMapEditor.export" | translate}}
                    hr
                if !pubService
                    .input-group.mb-3
                        .input-group-prepend
                            span.input-group-text {{"admin.mazeMapEditor.name" | translate}}
                        input.form-control(type='text', ng-model='name')
                        .input-group-append
                            button.btn.btn-secondary(type='button', ng-click='saveMap()') {{"admin.mazeMapEditor.save" | translate}}
                    hr
                    .input-group.mb-3(ng-if='!parent')
                        .input-group-prepend
                            span.input-group-text {{"admin.mazeMapEditor.name" | translate}}
                        input.form-control(type='text', ng-model='asname')
                        .input-group-append
                            span.input-group-text(for="selectComp") @
                        select.custom-select#selectComp(ng-model='$parent.se_competition', ng-options='b_competitions._id as b_competitions.name for b_competitions in competitions')
                        .input-group-append
                            button.btn.btn-secondary(type='button', ng-click='saveMapAs(asname)') {{"admin.mazeMapEditor.saveAs" | translate}}
                    hr
                .input-group.mb-3
                    .input-group-prepend
                        span.input-group-text {{"admin.mazeMapEditor.height" | translate}}
                    input.form-control(type='number', ng-model='height', ng-change='sliderOptions.ceil = height - 1', min='1')
                    .input-group-append
                        span.input-group-text {{"admin.mazeMapEditor.width" | translate}}
                    input.form-control(type='number', ng-model='width', min='1')
                    .input-group-append
                        span.input-group-text {{"admin.mazeMapEditor.length" | translate}}
                    input.form-control(type='number', ng-model='length', min='1')
                    .input-group-append
                        span.input-group-text {{"admin.simMapEditor.timelimit" | translate}}:
                    input.form-control(type='number', ng-model='duration', min = '1')
                hr
                if !pubService
                    div(ng-if='!parent')
                        i.fas.fa-dice.fa-2x(style="margin-bottom:10px;") {{"admin.mazeMapEditor.pattern" | translate}}
                        p(ng-if="mapId == ''")
                            | {{"admin.mazeMapEditor.patSave" | translate}}
                        table.custom(style='table-layout: auto;', ng-if="mapId != ''")
                            tbody
                                tr
                                    th No.
                                    th {{"common.map" | translate}}
                                    th {{"common.operation" | translate}}
                                    th {{"common.operation" | translate}}
                                tr(ng-repeat='i in range(6)')
                                    th(style="width:30px;") {{i+1}}
                                    td
                                        select(ng-model='dice[i]', ng-options='b_maps._id as b_maps.name for b_maps in maps')
                                    td
                                        button.btn.btn-primary(type='button', ng-click='childNew(i+1)') {{"admin.mazeMapEditor.create" | translate}}
                                    td
                                        button.btn.btn-secondary(type='button', ng-click='saveMap(dice[i])') {{"admin.mazeMapEditor.edit" | translate}}
                    br
                    div(ng-show='(dice[0]&&dice[1]&&dice[2]&&dice[3]&&dice[4]&&dice[5]) || parent')
                        input#isFinished(type='checkbox', ng-model='finished')
                        label.checkbox(for='isFinished') {{"admin.mazeMapEditor.finished" | translate}}
                    .error(ng-if='!(dice[0]&&dice[1]&&dice[2]&&dice[3]&&dice[4]&&dice[5])&&!parent') {{"admin.mazeMapEditor.patYet" | translate}}
                    br
                    .error(ng-if='startNotSet()') {{"admin.mazeMapEditor.noStart" | translate}}
        .row
            .col-11
                .btn-group(style='margin-bottom:5px;')
                    .input-group-prepend
                        span.input-group-text
                            i.fas.fa-arrows-alt-v(aria-hidden='true')
                    button.btn.btn-outline-dark(type='button', ng-click='changeFloor(zz)', ng-repeat='zz in range(height)', ng-class='{active: zz == z}')  {{zz}} 
                table
                    tbody
                        tr(ng-repeat='r in range(2*length + 1)')
                            td(ng-repeat='c in range(2*width + 1)', ng-class="{'wallspot': $odd != $parent.$odd, 'tile': $odd && $parent.$odd, 'wall': cells[c+','+r+','+z].isWall, 'checkpoint': cells[c+','+r+','+z].tile.checkpoint, 'black': cells[c+','+r+','+z].tile.black, 'blue': cells[c+','+r+','+z].tile.blue, 'red': cells[c+','+r+','+z].tile.red, 'linear': cells[c+','+r+','+z].tile.reachable && cells[c+','+r+','+z].isLinear, 'floating': cells[c+','+r+','+z].tile.reachable && !cells[c+','+r+','+z].isLinear}", ng-click='cellClick(c, r, z, $odd != $parent.$odd, $odd && $parent.$odd)', ng-style="wallColor(c,r,z)")
                                .tile-image-container(ng-show="$odd && $parent.$odd")
                                    img.tile-image(ng-src='/images/log.png', ng-show="cells[c+','+r+','+z].tile.speedbump")
                                    img.tile-image(ng-src='/images/start.png', ng-show='startTile.x == c && startTile.y == r && startTile.z == z')
                                    img.tile-image(ng-src='/images/elevator.png', ng-show="!isUndefined(cells[c+','+r+','+z].tile.changeFloorTo) && cells[c+','+r+','+z].tile.changeFloorTo != z")
                                    img.tile-image(ng-src='/images/ramp.png', ng-show="cells[c+','+r+','+z].tile.ramp")
                                    img.tile-image(ng-src='/images/steps.png', ng-show="cells[c+','+r+','+z].tile.steps")
                                    img.tile-image(ng-src='/images/phi_top.png', ng-show="cells[c+','+r+','+z].tile.victims.top == 'PHI'")
                                    img.tile-image(ng-src='/images/phi_right.png', ng-show="cells[c+','+r+','+z].tile.victims.right == 'PHI'")
                                    img.tile-image(ng-src='/images/phi_bottom.png', ng-show="cells[c+','+r+','+z].tile.victims.bottom == 'PHI'")
                                    img.tile-image(ng-src='/images/phi_left.png', ng-show="cells[c+','+r+','+z].tile.victims.left == 'PHI'")
                                    img.tile-image(ng-src='/images/psi_top.png', ng-show="cells[c+','+r+','+z].tile.victims.top == 'PSI'")
                                    img.tile-image(ng-src='/images/psi_right.png', ng-show="cells[c+','+r+','+z].tile.victims.right == 'PSI'")
                                    img.tile-image(ng-src='/images/psi_bottom.png', ng-show="cells[c+','+r+','+z].tile.victims.bottom == 'PSI'")
                                    img.tile-image(ng-src='/images/psi_left.png', ng-show="cells[c+','+r+','+z].tile.victims.left == 'PSI'")
                                    img.tile-image(ng-src='/images/omega_top.png', ng-show="cells[c+','+r+','+z].tile.victims.top == 'OMEGA'")
                                    img.tile-image(ng-src='/images/omega_right.png', ng-show="cells[c+','+r+','+z].tile.victims.right == 'OMEGA'")
                                    img.tile-image(ng-src='/images/omega_bottom.png', ng-show="cells[c+','+r+','+z].tile.victims.bottom == 'OMEGA'")
                                    img.tile-image(ng-src='/images/omega_left.png', ng-show="cells[c+','+r+','+z].tile.victims.left == 'OMEGA'")
                                    //- Cognitive Target displays
                                    .tile-image-container(ng-if="cells[c+','+r+','+z].tile.victims.top == 'Cognitive' && cells[c+','+r+','+z].tile.cognitiveTargets && cells[c+','+r+','+z].tile.cognitiveTargets.top && cells[c+','+r+','+z].tile.cognitiveTargets.top.rings", style="position: relative;")
                                        img.tile-image(ng-src="{{'/images/cognitive_rings/top_ring1_' + cells[c+','+r+','+z].tile.cognitiveTargets.top.rings.ring1 + '.png'}}", style="position: absolute; top: 0; left: 0; z-index: 1;")
                                        img.tile-image(ng-src="{{'/images/cognitive_rings/top_ring2_' + cells[c+','+r+','+z].tile.cognitiveTargets.top.rings.ring2 + '.png'}}", style="position: absolute; top: 0; left: 0; z-index: 2;")
                                        img.tile-image(ng-src="{{'/images/cognitive_rings/top_ring3_' + cells[c+','+r+','+z].tile.cognitiveTargets.top.rings.ring3 + '.png'}}", style="position: absolute; top: 0; left: 0; z-index: 3;")
                                        img.tile-image(ng-src="{{'/images/cognitive_rings/top_ring4_' + cells[c+','+r+','+z].tile.cognitiveTargets.top.rings.ring4 + '.png'}}", style="position: absolute; top: 0; left: 0; z-index: 4;")
                                        img.tile-image(ng-src="{{'/images/cognitive_rings/top_ring5_' + cells[c+','+r+','+z].tile.cognitiveTargets.top.rings.ring5 + '.png'}}", style="position: absolute; top: 0; left: 0; z-index: 5;")
                                    .tile-image-container(ng-if="cells[c+','+r+','+z].tile.victims.right == 'Cognitive' && cells[c+','+r+','+z].tile.cognitiveTargets && cells[c+','+r+','+z].tile.cognitiveTargets.right && cells[c+','+r+','+z].tile.cognitiveTargets.right.rings", style="position: relative;")
                                        img.tile-image(ng-src="{{'/images/cognitive_rings/right_ring1_' + cells[c+','+r+','+z].tile.cognitiveTargets.right.rings.ring1 + '.png'}}", style="position: absolute; top: 0; left: 0; z-index: 1;")
                                        img.tile-image(ng-src="{{'/images/cognitive_rings/right_ring2_' + cells[c+','+r+','+z].tile.cognitiveTargets.right.rings.ring2 + '.png'}}", style="position: absolute; top: 0; left: 0; z-index: 2;")
                                        img.tile-image(ng-src="{{'/images/cognitive_rings/right_ring3_' + cells[c+','+r+','+z].tile.cognitiveTargets.right.rings.ring3 + '.png'}}", style="position: absolute; top: 0; left: 0; z-index: 3;")
                                        img.tile-image(ng-src="{{'/images/cognitive_rings/right_ring4_' + cells[c+','+r+','+z].tile.cognitiveTargets.right.rings.ring4 + '.png'}}", style="position: absolute; top: 0; left: 0; z-index: 4;")
                                        img.tile-image(ng-src="{{'/images/cognitive_rings/right_ring5_' + cells[c+','+r+','+z].tile.cognitiveTargets.right.rings.ring5 + '.png'}}", style="position: absolute; top: 0; left: 0; z-index: 5;")
                                    .tile-image-container(ng-if="cells[c+','+r+','+z].tile.victims.bottom == 'Cognitive' && cells[c+','+r+','+z].tile.cognitiveTargets && cells[c+','+r+','+z].tile.cognitiveTargets.bottom && cells[c+','+r+','+z].tile.cognitiveTargets.bottom.rings", style="position: relative;")
                                        img.tile-image(ng-src="{{'/images/cognitive_rings/bottom_ring1_' + cells[c+','+r+','+z].tile.cognitiveTargets.bottom.rings.ring1 + '.png'}}", style="position: absolute; top: 0; left: 0; z-index: 1;")
                                        img.tile-image(ng-src="{{'/images/cognitive_rings/bottom_ring2_' + cells[c+','+r+','+z].tile.cognitiveTargets.bottom.rings.ring2 + '.png'}}", style="position: absolute; top: 0; left: 0; z-index: 2;")
                                        img.tile-image(ng-src="{{'/images/cognitive_rings/bottom_ring3_' + cells[c+','+r+','+z].tile.cognitiveTargets.bottom.rings.ring3 + '.png'}}", style="position: absolute; top: 0; left: 0; z-index: 3;")
                                        img.tile-image(ng-src="{{'/images/cognitive_rings/bottom_ring4_' + cells[c+','+r+','+z].tile.cognitiveTargets.bottom.rings.ring4 + '.png'}}", style="position: absolute; top: 0; left: 0; z-index: 4;")
                                        img.tile-image(ng-src="{{'/images/cognitive_rings/bottom_ring5_' + cells[c+','+r+','+z].tile.cognitiveTargets.bottom.rings.ring5 + '.png'}}", style="position: absolute; top: 0; left: 0; z-index: 5;")
                                    .tile-image-container(ng-if="cells[c+','+r+','+z].tile.victims.left == 'Cognitive' && cells[c+','+r+','+z].tile.cognitiveTargets && cells[c+','+r+','+z].tile.cognitiveTargets.left && cells[c+','+r+','+z].tile.cognitiveTargets.left.rings", style="position: relative;")
                                        img.tile-image(ng-src="{{'/images/cognitive_rings/left_ring1_' + cells[c+','+r+','+z].tile.cognitiveTargets.left.rings.ring1 + '.png'}}", style="position: absolute; top: 0; left: 0; z-index: 1;")
                                        img.tile-image(ng-src="{{'/images/cognitive_rings/left_ring2_' + cells[c+','+r+','+z].tile.cognitiveTargets.left.rings.ring2 + '.png'}}", style="position: absolute; top: 0; left: 0; z-index: 2;")
                                        img.tile-image(ng-src="{{'/images/cognitive_rings/left_ring3_' + cells[c+','+r+','+z].tile.cognitiveTargets.left.rings.ring3 + '.png'}}", style="position: absolute; top: 0; left: 0; z-index: 3;")
                                        img.tile-image(ng-src="{{'/images/cognitive_rings/left_ring4_' + cells[c+','+r+','+z].tile.cognitiveTargets.left.rings.ring4 + '.png'}}", style="position: absolute; top: 0; left: 0; z-index: 4;")
                                        img.tile-image(ng-src="{{'/images/cognitive_rings/left_ring5_' + cells[c+','+r+','+z].tile.cognitiveTargets.left.rings.ring5 + '.png'}}", style="position: absolute; top: 0; left: 0; z-index: 5;")

            .col-1 
                if !pubService
                    button.btn.btn-info(type='button', ng-click='openMaxScore()')
                        i.fas.fa-calculator
        hr
        .row.align-items-center.mb-3
            .col-md-6
                h4.mb-0
                    i.fas.fa-image.mr-2.text-secondary
                    | {{"admin.lineMapEditor.generateImage" | translate}}
            .col-md-6.text-md-right.mt-3.mt-md-0
                button.btn.btn-outline-primary(type='button', ng-click='makeImageDl()')
                    i.fas.fa-download.mr-2
                    | {{"admin.lineMapEditor.generateImage" | translate}}
                if !pubService
                    button.btn.btn-outline-secondary.ml-2(type='button', ng-click='makeImage()')
                        i.fas.fa-file-alt.mr-2
                        | {{"admin.lineMapEditor.prepareScoresheets" | translate}}
        
        .row(ng-if='hasCognitiveTargets()')
            .col-12
                .card.shadow-sm.border-0.mt-3
                    .card-header.bg-gradient-primary.text-white.d-flex.align-items-center.py-3(style='background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);')
                        i.fas.fa-bullseye.fa-lg.mr-3
                        .d-flex.flex-column
                            h5.mb-0.font-weight-bold {{"admin.mazeMapEditor.cognitiveTargetsPDF" | translate}}
                            small.opacity-75 {{"admin.mazeMapEditor.cognitiveTargetsPDFDesc" | translate}}
                    .card-body.bg-light.py-4
                        .row.align-items-center
                            .col-lg-3.col-md-4.mb-3.mb-lg-0
                                label.form-label.font-weight-bold.text-secondary.mb-2(for='paperSizeSelect')
                                    i.fas.fa-ruler.mr-2
                                    | {{"admin.mazeMapEditor.paperSize" | translate}}
                                select#paperSizeSelect.form-control.form-control-lg.shadow-sm(ng-model='pdfSettings.paperSize', ng-change='onPaperSizeChange()')
                                    option(value='A4') A4 (210 × 297 mm)
                                    option(value='Letter') Letter (8.5 × 11 in)
                            .col-lg-3.col-md-4.mb-3.mb-lg-0
                                label.form-label.font-weight-bold.text-secondary.mb-2(for='includeLetterVictimsCheckbox')
                                    i.fas.fa-envelope-open-text.mr-2
                                    | {{"admin.mazeMapEditor.includeLetterVictims" | translate}}
                                .custom-control.custom-checkbox.custom-control-lg
                                    input#includeLetterVictimsCheckbox.custom-control-input(type='checkbox', ng-model='pdfSettings.includeLetterVictims')
                                    label.custom-control-label(for='includeLetterVictimsCheckbox') {{"common.yes" | translate}}
                            .col-lg-6.col-md-4.text-lg-right
                                .d-flex.flex-column.flex-sm-row.align-items-center.justify-content-lg-end
                                    .text-muted.small.mr-sm-3.mb-2.mb-sm-0(ng-if='pdfSettings.paperSize === "A4"')
                                        i.fas.fa-info-circle.mr-1
                                        | {{"admin.mazeMapEditor.a4Description" | translate}}
                                    .text-muted.small.mr-sm-3.mb-2.mb-sm-0(ng-if='pdfSettings.paperSize === "Letter"')
                                        i.fas.fa-info-circle.mr-1
                                        | {{"admin.mazeMapEditor.letterDescription" | translate}}
                                    button.btn.btn-primary.btn-lg.shadow-sm(type='button', ng-click='generateCognitiveTargetsPDF()')
                                        i.fas.fa-print.mr-2
                                        | {{"admin.mazeMapEditor.printCognitiveTargets" | translate}}
        .row
            #outputImageArea(style="float:left;padding-top:100px;padding-left:0px;padding-right:0px;padding-bottom:100px;")
                style.
                    .maru {
                        display: inline-flex;
                        justify-content: center;
                        align-items: center;
                        border-radius: 50%;
                        flex-flow: column;
                        vertical-align: top;
                    }
                    .size_normal{
                        width: 15px;
                        height: 15px;
                    }
                    .letter3 {
                        font-size: 1em;
                        line-height: 1.5em;
                        color: white;
                    }
                    .blue1 {
                        color: #3498db;
                        background-color: #3498db;
                    }
                    .pink1 {
                        color: #e84393;
                        background-color: #e84393;
                    }
                div(ng-repeat='z in range(height)')
                    table
                        tbody
                            tr(ng-repeat='r in range(2*length + 1)')
                                td(ng-repeat='c in range(2*width + 1)', ng-show="showCellOutput(c,r,z)", ng-class="{'wallspot': $odd != $parent.$odd, 'tile': $odd && $parent.$odd, 'wall': cells[c+','+r+','+z].isWall, 'checkpoint': cells[c+','+r+','+z].tile.checkpoint, 'black': cells[c+','+r+','+z].tile.black, 'blue': cells[c+','+r+','+z].tile.blue, 'red': cells[c+','+r+','+z].tile.red, 'linear': cells[c+','+r+','+z].tile.reachable && cells[c+','+r+','+z].isLinear, 'floating': cells[c+','+r+','+z].tile.reachable && !cells[c+','+r+','+z].isLinear}" , ng-style="wallColor(c,r,z)")
                                    .tile-image-container(ng-show="$odd && $parent.$odd")
                                        div.maru.size_normal.blue1(style="left:1px;top:1px;position: absolute;border-radius:0%;z-index:3;" ng-if="cells[c+','+r+','+z].tile.checkpoint")
                                            div.letter3(ng-bind="itemNumber('checkpoint',c,r,z)")
                                        div(style="position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); background: white; color: #3498db; border-radius: 50%; width: 15px; height: 15px; display: flex; align-items: center; justify-content: center; font-size: 0.75em; font-weight: bold; z-index: 3;" ng-if="cells[c+','+r+','+z].tile.blue")
                                            span(ng-bind="itemNumber('blue',c,r,z)")
                                        img.tile-image(ng-src='/images/log.png', ng-show="cells[c+','+r+','+z].tile.speedbump")
                                        div.maru.size_normal.blue1(style="right:1px;bottom:1px;position: absolute;z-index:3;" ng-if="cells[c+','+r+','+z].tile.speedbump")
                                            div.letter3(ng-bind="itemNumber('speedbump',c,r,z)")
                                        img.tile-image(ng-src='/images/start.png', ng-show='startTile.x == c && startTile.y == r && startTile.z == z')
                                        img.tile-image(ng-src='/images/elevator.png', ng-show="!isUndefined(cells[c+','+r+','+z].tile.changeFloorTo) && cells[c+','+r+','+z].tile.changeFloorTo != z")
                                        img.tile-image(ng-src='/images/ramp.png', ng-show="cells[c+','+r+','+z].tile.ramp")
                                        div.maru.size_normal.blue1(style="right:13px;top:12px;position: absolute;z-index:3;border-radius:25%;" ng-if="cells[c+','+r+','+z].tile.ramp")
                                            div.letter3(ng-bind="itemNumber('ramp',c,r,z)")
                                        img.tile-image(ng-src='/images/steps.png', ng-show="cells[c+','+r+','+z].tile.steps")
                                        div.maru.size_normal.blue1(style="right:13px;top:12px;position: absolute;z-index:3;border-radius:25%;" ng-if="cells[c+','+r+','+z].tile.steps")
                                            div.letter3(ng-bind="itemNumber('steps',c,r,z)")

                                        div(ng-if="cells[c+','+r+','+z].tile.victims.top == 'PHI'")
                                            img.tile-image(ng-src='/images/phi_top.png')
                                            div.maru.size_normal.pink1(style="right:5px;top:-10px;position: absolute;z-index:3;")
                                                div.letter3(ng-bind="victimNumber('PHI',c,r,z,'top')")
                                        div(ng-if="cells[c+','+r+','+z].tile.victims.right == 'PHI'")
                                            img.tile-image(ng-src='/images/phi_right.png')
                                            div.maru.size_normal.pink1(style="right:-10px;bottom:5px;position: absolute;z-index:3;")
