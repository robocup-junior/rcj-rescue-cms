//- -*- tab-width: 2 -*-
html(ng-app="RunAdmin")
  head
    title Rescue Maze Runs Print
    script.
      var competitionId = "#{competitionId}"
      var leagueId = "#{leagueId}"

    include ../../includes/common_component

    script(src='/javascripts/admin/gamesPrint/maze_2026.js?v=' + assetVersion)
    script(src='/components/exceljs/index.js?v=' + assetVersion)
    script(src='/javascripts/admin/gamesPrint/xlsx_export.js?v=' + assetVersion)
    link(rel='stylesheet', href='/stylesheets/admin/live_ranking.css?v=' + assetVersion)
    link(rel='stylesheet', href='/stylesheets/admin/games_print.css?v=' + assetVersion)

    script(src = '/components/angular-bootstrap-datetimepicker/src/js/datetimepicker.js')
    script(src = '/components/angular-bootstrap-datetimepicker/src/js/datetimepicker.templates.js')
    script(src='/components/ng-file-upload/ng-file-upload-all.min.js?v=' + assetVersion)
    script(src="/javascripts/translate_config.js?v=" + assetVersion)
    style(type='text/css').
      .uib-time input {
        padding-left: 0;
        padding-right: 0;
        width: 2.5em;
        margin-right: 0;
      }

      .uib-timepicker .btn {
        padding-left: 6px;
        padding-right: 6px;
      }

  body(ng-controller="RunAdminController")
    .container-fluid.print-page
      -
        var columns = [
          {model: 'showCode', label: "{{'common.teamCode' | translate}}"},
          {model: 'showTeam', label: "{{'common.team' | translate}}"},
          {model: 'showField', label: "{{'common.field' | translate}}"},
          {model: 'showOriginalScore', label: "{{'admin.gamesPrint.originalScore' | translate}}"},
          {model: 'showAdjustment', label: "{{'admin.gamesPrint.adjustment' | translate}}"},
          {model: 'showScore', label: "{{'common.score' | translate}}"},
          {model: 'showNormalizedScore', label: "{{'common.normalizedScore' | translate}}"},
          {model: 'showTime', label: "{{'common.time' | translate}}"},
          {model: 'showLoPs', label: "{{'common.lops' | translate}}"},
          {model: 'showMisidentification', label: "{{'maze.view.misidentification' | translate}}"},
          {model: 'showVictim', label: "{{'maze.score.found' | translate}}"},
          {model: 'showExit', label: "{{'maze.score.exit' | translate}}"},
        ]
      include include/config

      table#run-table.custom
        thead
          +sheetHeader
          tr
            th {{"common.starttime" | translate}}
            th {{"common.round" | translate}}
            th(ng-if="showCode") {{'common.teamCode' | translate}}
            th(ng-if="showTeam") {{"common.team" | translate}}
            th(ng-if="showField") {{"common.field" | translate}}
            th(ng-if="showOriginalScore") {{'admin.gamesPrint.originalScore' | translate}}
            th(ng-if="showAdjustment") {{'admin.gamesPrint.adjustment' | translate}}
            th(ng-if="showScore") {{"common.score" | translate}}
            th(ng-if="showNormalizedScore") {{"common.normalizedScore" | translate}}
            th(ng-if="showTime") {{"common.time" | translate}}
            th(ng-if="showLoPs") {{"common.lops" | translate}}
            th(ng-if="showMisidentification") {{"maze.view.misidentification" | translate}}
            th(ng-if="showVictim") {{'maze.score.found' | translate}}
            th(ng-if="showExit") {{'maze.score.exit' | translate}}
        tbody
          tr(ng-repeat='run in runs | filter:list_filter | orderBy:"[startTime,round.name,team.name]"' runs-read-finished='')
            td(ng-bind='run.startTime | date:"dd / HH:mm"')
            td(ng-bind='run.round.name' )
            td(ng-bind='run.team.teamCode' ng-if="showCode")
            td.team-name(ng-bind='run.team.name' ng-if="showTeam")
            td(ng-bind='run.field.name' ng-if="showField")
            td(ng-bind='run.originalScore' ng-if="showOriginalScore")
            td(ng-if="showAdjustment") {{run.adjustment}}%
            td(ng-bind='run.score' ng-if="showScore")
            td(ng-bind='run.normalizedScore' ng-if="showNormalizedScore")
            td(ng-bind="run.time.minutes*60*1000+run.time.seconds*1000 | date:'mm:ss'"  ng-if="showTime")
            td(ng-bind='run.LoPs' ng-if="showLoPs")
            td(ng-bind='run.misidentification' ng-if="showMisidentification")
            td(data-xlsx="{{victimText(run)}}" ng-if="showVictim")
              .img-thumbnail(style="padding:0;display: inline-block;margin-right:5px;" ng-repeat="victim in run.foundVictims | orderBy:victimOrder" ng-style="{'background-color': (victim.type.endsWith(':H') || victim.type=='PHI' || victim.type=='H')?'#f8d7da':((victim.type.endsWith(':S') || victim.type=='PSI' || victim.type=='S')?'#fff3cd':((victim.type.endsWith(':U') || victim.type=='OMEGA' || victim.type=='U')?'#d4edda':'transparent'))}")
                img(ng-src="/images/{{victim.type.toLowerCase()}}.png", style="height:20px;", ng-if="!victim.type.startsWith('Cognitive')")
                i.fas.fa-bullseye(style="font-size:18px;vertical-align:middle;margin-left:2px;margin-right:2px;", ng-if="victim.type.startsWith('Cognitive')")
                span(style="font-size:15px; color:black;") ×{{victim.count}}
            td.text-center(data-xlsx="{{(run.exitBonus ? 'common.yes' : 'common.no') | translate}}" ng-if="showExit")
              i(class="fas fa-check" aria-hidden="true" style="color:#2ecc71;" ng-if="run.exitBonus")
              i(class="fas fa-times" aria-hidden="true" style="color:#e74c3c;" ng-if="!run.exitBonus")
