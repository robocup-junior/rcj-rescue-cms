//- -*- tab-width: 2 -*-
html(ng-app="RunAdmin")
  head
    title Rescue Line Runs Print

    include ../../includes/common_component
    script.
      var competitionId = "#{competitionId}"
      var leagueId = "#{leagueId}"
    script(src='https://cdn.jsdelivr.net/npm/xlsx-js-style@1.2.0/dist/xlsx.bundle.js')
    script(src='https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js')
    script(src='/javascripts/admin/gamesPrint/line_2025.js')

    script(src = '/components/angular-bootstrap-datetimepicker/src/js/datetimepicker.js')
    script(src = '/components/angular-bootstrap-datetimepicker/src/js/datetimepicker.templates.js')
    script(src='/components/ng-file-upload/ng-file-upload-all.min.js')
    script(src="/javascripts/translate_config.js")
    style(type='text/css').
      .uib-time input {
        padding-left: 0;
        padding-right: 0;
        width: 2.5em;
        margin-right: 0;
      }

      .uib-timepicker .btn {
        padding-left: 6px;
        padding-right: 6px;
      }

      @media print {
        .no_print {
          display: none;
        }

        @page {
          margin: 10mm;
        }

        body{
          overflow-y: visible;
          overflow-x: visible;
        }

        thead {
          display: table-header-group;
          break-inside: avoid;
        }
      }

  body(ng-controller="RunAdminController")
    #ranking-export
      .row
        .col-10(style="text-align:center;")
          h1 {{topComment}}
        .col-2(style="text-align:right;")
          img(ng-src="{{competition.logo}}" style="max-width:100%;max-height:50px;")
    .row
      .col-12
        .refine.no_print
          .card.border-dark.mb-3(style='width:100%;')
            .card-header.bg-transparent.border-dark.fa-2x
              .row 
                .col-md-6
                  i.fas.fa-cog(aria-hidden='true') Config
                .col-md-6(style="text-align:right;")
                  button.btn.btn-secondary(type='button' ng-click="displayMode = displayMode == DisplayMode.LIST ? DisplayMode.RANKING : DisplayMode.LIST" style="margin-right:10px;")
                    i.fas.fa-table(ng-if="displayMode == DisplayMode.LIST")
                    i.fas.fa-list(ng-if="displayMode == DisplayMode.RANKING")
                    span(ng-if="displayMode == DisplayMode.LIST") &nbsp;Ranking View
                    span(ng-if="displayMode == DisplayMode.RANKING") &nbsp;Run List
                  button.btn.btn-success(type='button' ng-if='displayMode == DisplayMode.RANKING' ng-click='exportRankingXlsx()' style='margin-right:10px;')
                    i.fas.fa-file-excel
                    |  Export XLSX
                  //button.btn.btn-danger(type='button' ng-if='displayMode == DisplayMode.RANKING' ng-click='exportRankingPdf()' style='margin-right:10px;')
                    i.fas.fa-file-pdf
                    |  Export PDF
                  button(onclick="window.print();" class='btn btn-info' style="text-align:right;")
                    i.fas.fa-print &nbsp;{{"common.print" | translate}}
            .card-body.text-dark
              p Please use Google Chrome to print this page.
              div(ng-if="displayMode == DisplayMode.LIST")
                hr
                h6.card-title {{'line.competition.refine.round' | translate}}
                span(ng-repeat='(key, value) in Rrounds track by key')
                  input(type='checkbox' ng-model='Rrounds[key]' id="checkR_{{key}}")
                  label.checkbox(for="checkR_{{key}}") {{key}}
              div(ng-if="displayMode == DisplayMode.RANKING")
                hr
                h6.card-title Rounds (Normalization Groups)
                span(ng-repeat='(key, value) in Rgroups track by key')
                  input(type='checkbox' ng-model='Rgroups[key]' id="checkG_{{key}}")
                  label.checkbox(for="checkG_{{key}}") Group {{key}}
              div(ng-if="displayMode == DisplayMode.LIST") 
                hr
                h6.card-title(ng-if="displayMode == DisplayMode.LIST") {{'line.competition.refine.field' | translate}}
                span(ng-repeat='(key, value) in Rfields track by key')
                  input(type='checkbox' ng-model='Rfields[key]' id="checkF_{{key}}")
                  label.checkbox(for="checkF_{{key}}") {{key}}
              div(ng-if="displayMode == DisplayMode.LIST")
                hr
                h6.card-title {{'line.competition.refine.team' | translate}}
                .input-group
                  .input-group-prepend
                    span.input-group-text
                      i.fas.fa-users(aria-hidden='true')
                  input.form-control(type='text', placeholder='Team name', aria-label='Username', aria-describedby='basic-addon1' ng-model='teamName')
              hr

              div(ng-if="displayMode == DisplayMode.RANKING")
                h6.card-title Ranking Table Settings

                input(type='checkbox' ng-model='tableOptions.showRaw' ng-change='$evalAsync()' id='tableShowRaw')
                label.checkbox(for='tableShowRaw') Show Raw Score

                input(type='checkbox' ng-model='tableOptions.showNorm' ng-change='$evalAsync()' id='tableShowNorm')
                label.checkbox(for='tableShowNorm') Show Normalized Score

                input(type='checkbox' ng-model='tableOptions.showTeamCode' ng-change='$evalAsync()' id='tableShowTeamCode')
                label.checkbox(for='tableShowTeamCode') Team Code

                input(type='checkbox' ng-model='tableOptions.showTeamName' ng-change='$evalAsync()' id='tableShowTeamName')
                label.checkbox(for='tableShowTeamName') Team Name

                input(type='checkbox' ng-model='tableOptions.showTime' ng-change='$evalAsync()' id='tableShowTime')
                label.checkbox(for='tableShowTime') Total Time

                input(type='checkbox' ng-model='tableOptions.showRuns' ng-change='$evalAsync()' id='tableShowRuns')
                label.checkbox(for='tableShowRuns') Number of Runs
                hr
              h6.card-title Comment
                .input-group
                  .input-group-prepend
                    span.input-group-text
                      i.fas.fa-pen(aria-hidden='true')
                  input.form-control(type='text', placeholder='', aria-label='Username', aria-describedby='basic-addon1' ng-model='topComment')


        center
          .loader
            img(src="/images/loader2.gif")
            p Now Loading...
        table(class="custom" style="margin-bottom:10px;" ng-if="displayMode == DisplayMode.LIST")
          thead
            tr
              th {{"common.starttime" | translate}}
              th {{"common.round" | translate}}
              th(ng-if="showCode") Team code
              th(ng-if="showTeam") {{"common.team" | translate}}
              th(ng-if="showField") {{"common.field" | translate}}
              th(ng-if="showOriginalScore") Original Score
              th(ng-if="showAdjustment") Adjustment
              th(ng-if="showScore") {{"common.score" | translate}}
              th(ng-if="showNormalizedScore") {{"common.normalizedScore" | translate}}
              th(ng-if="showTime") {{"common.time" | translate}}
              th(ng-if="showLoPs") {{"common.lops" | translate}}
              th(ng-if="showVictim") {{'common.rescued' | translate}}
              th(ng-if="showMultiplier") {{'common.multipliers' | translate}}
              th(ng-if="showExit") {{'maze.score.exit' | translate}}
          tbody
            tr(ng-repeat='run in runs | filter:list_filter | orderBy:"[startTime,round.name,team.name]"' runs-read-finished='')
              td(ng-bind='run.startTime | date:"dd / HH:mm"')
              td(ng-bind='run.round.name' )
              td(ng-bind='run.team.teamCode' ng-if="showCode")
              td(ng-bind='run.team.name' ng-if="showTeam")
              td(ng-bind='run.field.name' ng-if="showField")
              td(ng-bind='run.originalScore' ng-if="showOriginalScore")
              td(ng-if="showAdjustment") {{run.adjustment}}%
              td(ng-bind='run.score' ng-if="showScore")
              td(ng-bind='run.normalizedScore' ng-if="showNormalizedScore")
              td(ng-bind="run.time.minutes*60*1000+run.time.seconds*1000 | date:'mm:ss'"  ng-if="showTime")
              td(ng-bind='total(run.LoPs)' ng-if="showLoPs")
              td(ng-if="showVictim && run.team.league != 'LineNL'")
                span.badge.badge-warning(style="margin-right:5px;" ng-show='run.evacuationLevel == 1') Level 1
                span.badge.badge-danger(style="margin-right:5px;" ng-show='run.evacuationLevel == 2') Level 2
                .img-thumbnail(style="padding:0;display: inline-block;margin-right:5px;" ng-repeat="victim in run.rescueOrder" ng-style="{backgroundColor: evacZoneColor(victim), opacity: active_victim(run.rescueOrder, $index) ? '1.0':'0.3'}")
                  img(ng-src='/images/{{victimImgPath(victim)}}', style="height:20px;")                
              td.text-center(ng-style="run.isplaying && {'background-color': '#ffffa8'}" ng-if="showVictim && run.team.league=='LineNL'")
                .img-thumbnail(style="padding:0;display: inline-block;margin-right:5px;" ng-repeat="victim in range(run.nlUnknownVictimCount)")
                  img(src='/images/unknownVictim.png', style="height:20px;")
                  span(style="font-size:20px;")
                .img-thumbnail(style="padding:0;display: inline-block;margin-right:5px;" ng-repeat="victim in range(run.nlLiveVictimCount)")
                  img(src='/images/greenVictim.png', style="height:20px;")
                  span(style="font-size:20px;")
                .img-thumbnail(style="padding:0;display: inline-block;margin-right:5px;" ng-repeat="victim in range(run.nlDeadVictimCount)")
                  img(src='/images/blackVictim.png', style="height:20px;")
                  span(style="font-size:20px;")       
              td(ng-if="showMultiplier")
                span ×{{run.multiplier}}
              td(ng-if="showExit")
                i(class="fas fa-check" aria-hidden="true" style="color:#2ecc71;" ng-if="run.exitBonus")
                i(class="fas fa-times" aria-hidden="true" style="color:#e74c3c;" ng-if="!run.exitBonus")

      table(class="custom" style="margin-bottom:10px;" ng-if="displayMode == DisplayMode.RANKING")
        thead
          tr
            th Rank
            th(ng-if='tableOptions.showTeamCode') Team Code
            th(ng-if='tableOptions.showTeamName') Team
            th(ng-repeat-start='group in selectedRankingGroups' ng-if='tableOptions.showRaw') Round {{group}}
            th(ng-repeat-end ng-if='tableOptions.showNorm') Normalized
             br
             | Round {{group}}
            th(ng-if='tableOptions.showRaw && !tableOptions.showNorm') TOTAL
            th(ng-if='tableOptions.showNorm') Mean of 
              br
              | Normalized
              br
              | TOTAL
            th(ng-if='tableOptions.showTime') Total Time
            th(ng-if='tableOptions.showRuns') Runs
        tbody
          tr(ng-repeat='team in rankingTable')
            td {{$index + 1}}
            td(ng-if='tableOptions.showTeamCode') {{team.teamCode}}
            td(ng-if='tableOptions.showTeamName') {{team.name}}
            td(ng-repeat-start='group in selectedRankingGroups' ng-if='tableOptions.showRaw')
              span(ng-if='team.groupScores[group]') {{team.groupScores[group].rawScore}}
              span(ng-if='!team.groupScores[group]') -
            td(ng-repeat-end ng-if='tableOptions.showNorm')
              span(ng-if='team.groupScores[group]') {{team.groupScores[group].normalizedScore | number:3}}
              span(ng-if='!team.groupScores[group]') -
            td(ng-if='tableOptions.showRaw && !tableOptions.showNorm') {{team.totalRawScore}}
            td(ng-if='tableOptions.showNorm') {{team.totalNormalizedScore | number:3}}
            td(ng-if='tableOptions.showTime') {{team.totalTime || '-'}}
            td(ng-if='tableOptions.showRuns') {{team.runCount}}
