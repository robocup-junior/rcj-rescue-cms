//- Toolbar and config panel of the games print pages.
//- Expects `columns` ([{model, label}]) from the including page.
include ../../../includes/print_page
- var allColumns = columns.map((c) => `${c.model} = true`).join('; ')
- var noColumns = columns.map((c) => `${c.model} = false`).join('; ')

+printToolbar(`/admin/${competitionId}/${leagueId}/games`, '(runs | filter:list_filter).length', 'admin.print.runs', '#run-table')

.config-panel.no_print
  section.config-section
    h2.config-section-title
      i.fas.fa-filter
      |  {{'admin.print.filter' | translate}}
    .config-field
      .config-label {{'line.competition.refine.round' | translate}}
      .chips
        button.chip(type='button' ng-class='{active: noneSelected(Rrounds)}' ng-click='clearSelection(Rrounds)') {{'admin.print.all' | translate}}
        button.chip(type='button' ng-repeat='(key, value) in Rrounds track by key' ng-class='{active: Rrounds[key]}' ng-click='Rrounds[key] = !Rrounds[key]')
          i.fas.fa-check
          | {{key}}
    .config-field
      .config-label {{'line.competition.refine.field' | translate}}
      .chips
        button.chip(type='button' ng-class='{active: noneSelected(Rfields)}' ng-click='clearSelection(Rfields)') {{'admin.print.all' | translate}}
        button.chip(type='button' ng-repeat='(key, value) in Rfields track by key' ng-class='{active: Rfields[key]}' ng-click='Rfields[key] = !Rfields[key]')
          i.fas.fa-check
          | {{key}}
    .config-field
      .config-label {{'line.competition.refine.team' | translate}}
      .input-group.input-group-sm.team-search
        .input-group-prepend
          span.input-group-text
            i.fas.fa-search
        input.form-control(type='search' placeholder="{{'line.competition.refine.team' | translate}}" aria-label="{{'line.competition.refine.team' | translate}}" ng-model='teamName')

  section.config-section
    h2.config-section-title
      i.fas.fa-columns
      |  {{'admin.print.columns' | translate}}
      span.config-section-actions
        button.btn.btn-link.btn-sm(type='button' ng-click=allColumns) {{'admin.print.all' | translate}}
        button.btn.btn-link.btn-sm(type='button' ng-click=noColumns) {{'admin.print.none' | translate}}
    .config-field
      .chips
        each c in columns
          +chip(c.model, c.label)
    .config-field
      .config-label {{'admin.print.sheetTitle' | translate}}
      input.form-control.form-control-sm(type='text' aria-label="{{'admin.print.sheetTitle' | translate}}" ng-model='list.comment')

.loader.no_print
  img(src="/images/loader2.gif")
  p {{'common.loading' | translate}}
