//- -*- tab-width: 2 -*-
extends ../includes/modern_layout

block vars
  - var ngAppDef = 'FieldAdmin'

append scripts
  script.
    var competitionId = "#{id}"
  script(src='/javascripts/admin/field.js')

append css
  link(href='/stylesheets/common/modern_editor.css', rel='stylesheet')
  style.
    .fields-base-table .base-table-header,
    .fields-base-table .base-table-row {
      grid-template-columns: 36px 1fr auto;
    }

block hero_breadcrumb
  a.breadcrumb-item(ng-click="go('/home')") Home
  a.breadcrumb-item(ng-click="go('/admin')") Admin
  a.breadcrumb-item(ng-click="go('/admin/'+competitionId)") {{competition.name}}
  span.breadcrumb-item.active Fields

block hero_title
  | {{competition.name}}

block hero_subtitle
  i.fas.fa-map-marker-alt.mr-2
  | {{"admin.fields.title" | translate}}

block main_content
  h5.section-heading.mb-2
    i.fas.fa-plus
    | {{"admin.fields.add" | translate}}
  .modern-card
    .modern-card-body
      .toolbar-actions
        input.premium-input(ng-model='fieldName' style="max-width: 320px;")
        button.btn-premium.btn-premium-primary(ng-click='addField()')
          i.fas.fa-check
          | {{"admin.fields.add" | translate}}

  .modern-card.section-gap
    .modern-card-header
      i.fas.fa-map-marker-alt
      | {{"admin.fields.title" | translate}}
    .modern-card-body.p-0
      .base-table.fields-base-table
        .base-table-header
          .base-table-cell
          .base-table-cell {{"common.name" | translate}}
          .base-table-cell.text-right {{"common.operation" | translate}}
        .base-table-row(ng-repeat='field in fields')
          .base-table-icon
            i.fas.fa-map-marker-alt
          .base-table-cell
            span.base-table-name(ng-bind='field.name')
          .base-table-actions
            button.btn-table-action(type='button' ng-click='removeField(field)')
              i.fas.fa-trash-alt
              | {{"common.delete" | translate}}
