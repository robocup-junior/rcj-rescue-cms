//- -*- tab-width: 2 -*-
extends ../includes/modern_layout

block vars
  - var ngAppDef = 'FieldAdmin'

append scripts
  script.
    var competitionId = "#{id}"
  script(src='/javascripts/admin/field.js?v=' + assetVersion)

block hero_breadcrumb
  a.breadcrumb-item(ng-click="go('/home')")
    i.fas.fa-home.mr-1
    | Home
  a.breadcrumb-item(ng-click="go('/admin')") Admin
  a.breadcrumb-item(ng-click="go('/admin/'+competitionId)") {{competition.name}}
  span.breadcrumb-item.active Fields

block hero_title
  | {{competition.name}}

block hero_subtitle
  | {{"admin.fields.title" | translate}}

block main_content
  .modern-card.mb-4
    .modern-card-header
      i.fas.fa-plus-circle.mr-2
      | {{"admin.fields.add" | translate}}
    .modern-card-body
      .row
        .col-md-9
          .form-group.mb-md-0
            label {{"common.name" | translate}}
            input.form-control(ng-model='fieldName' ng-keyup="$event.keyCode == 13 && addField()")
        .col-md-3.d-flex.align-items-end
          button.btn.btn-premium-primary.w-100(ng-click='addField()')
            i.fas.fa-plus.mr-2
            | {{"admin.fields.add" | translate}}

  .modern-card
    .modern-card-header
      i.fas.fa-map-marker-alt.mr-2
      | {{"admin.fields.title" | translate}}
    .modern-card-body.p-0
      .table-responsive(style="padding: 0 1.5rem 1.5rem;")
        table.table-modern
          thead
            tr
              th {{"common.name" | translate}}
              th(style="width: 120px;") {{"common.operation" | translate}}
          tbody
            tr(ng-repeat='field in fields')
              td(ng-bind='field.name')
              td
                .btn-table-group
                  .btn-table-action.danger(ng-click='removeField(field)' uib-tooltip='{{"common.delete" | translate}}')
                    i.fas.fa-trash-alt
