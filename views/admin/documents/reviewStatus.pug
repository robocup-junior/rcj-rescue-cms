//- -*- tab-width: 2 -*-
extends ../../includes/modern_layout

block vars
  - var ngAppDef = 'ReviewStatus'

append scripts
  script.
    var competitionId = "#{id}"
  script(src='/javascripts/admin/documents/reviewStatus.js?v=' + assetVersion)

block hero_breadcrumb
  a.breadcrumb-item(ng-click="go('/home')")
    i.fas.fa-home.mr-1
    | Home
  a.breadcrumb-item(ng-click="go('/admin')") Admin
  a.breadcrumb-item(ng-click="go('/admin/' + competitionId)") {{reviewStatus.competitonName}}
  a.breadcrumb-item(ng-click="go('/admin/' + competitionId + '/documents')") Document settings
  span.breadcrumb-item.active ReviewStatus

block hero_title
  | {{reviewStatus.competitonName}}

block hero_subtitle
  | Review Status

block hero_actions
  button.btn-hero-action(type='button' ng-click="sendReminder()")
    i.fas.fa-envelope
    | Send a reminder

block main_content
  .modern-card
    .modern-card-header
      i.fas.fa-tasks.mr-2
      | Review Status
    .modern-card-body.p-0
      .table-responsive(style="padding: 0 1.5rem 1.5rem;")
        table.table-modern.table-auto
          thead
            tr
              th {{"admin.users.name" | translate}}
              th(ng-repeat="league in leagues") {{league.name}}
          tbody
            tr(ng-repeat='user in reviewStatus.reviewStatus | orderBy:"[userName]"')
              td.font-weight-bold(ng-bind='user.userName')
              td(ng-repeat="league in leagues")
                div(ng-repeat='team in user.assignedTeams[league.id] | orderBy:"[code, name]"')
                  span.badge.text-left(ng-click="goReviewed(team._id)" ng-class="getBadgeColor(team)" style="font-size: 12px; margin: 2px 0; cursor: pointer; white-space: normal;") {{team.code}} {{team.name}}
                    br
                    | {{team.reviewItems.join(" / ")}}
                    br
                    i.fas.fa-tasks.mr-1
                    | {{team.answeredQuestionsNum}} / {{team.assienedQuestionsNum}}
