//- -*- tab-width: 2 -*-
extends ../includes/modern_layout

block vars
  - var ngAppDef = 'MazeScore'

append scripts
  script.
    var competitionId = "#{competitionId}"
    var leagueId = "#{leagueId}"

  script(src='/javascripts/ranking/maze_2026E.js')
  script(src = '/components/datatables/media/js/jquery.dataTables.min.js')
  script(src = '/components/angular-datatables/demo/src/archives/dist/angular-datatables.min.js')

block hero_breadcrumb
  a.breadcrumb-item(ng-click="go('/home')") Home
  a.breadcrumb-item(ng-click='go("/home/"+ competitionId )') {{competition.name}}
  a.breadcrumb-item(ng-click="go('/maze/'+ competitionId + '/' + league.league)") {{league.name}}
  span.breadcrumb-item.active Ranking

block hero_title
  | {{league.name}}

block hero_subtitle
  i.fas.fa-trophy.mr-2
  | Ranking

block hero_actions
  button.btn-premium.btn-premium-secondary(type='button', ng-click="go('/maze/' + competitionId + '/' + league.league)")
    i.fa.fa-undo
    | {{'common.back' | translate}}

block main_content
  .alert.alert-success(role='alert' ng-if="competition.message")
    h4.alert-heading {{'common.message' | translate}}
    p(ng-bind-html="competition.message")
  include include/maze_2026E
