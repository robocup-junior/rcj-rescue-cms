//- -*- tab-width: 2 -*-
extends ../includes/modern_layout

block vars
  - var ngAppDef = 'ReservationAdmin'

append scripts
  script.
    var competitionId = "#{id}"
    var resvId = "#{resvId}"
  script(src='/javascripts/reservation/admin.js')
  script(src='/components/quill/index.js')
  script(src='/components/ngQuill/src/ng-quill.js')
  script(src='/components/quill-image-resize-module/image-resize.min.js')
  script(src='/components/quill-image-drop-and-paste/dist/quill-image-drop-and-paste.min.js')

append css 
  link(rel='stylesheet', href='/components/quill.snow/index.css')
  style.
    .ui-select-bootstrap .dropdown-menu {
      display: initial;
    }
    .btn-default {
      background-color: #3498db;
      color: #fff;
      font-size: 10px;
    }
    .ui-select-bootstrap .ui-select-choices-row.active>span {
        color: initial;
        text-decoration: none;
        outline: 0;
        background-color: initial;
    }

block hero_breadcrumb
  a.breadcrumb-item(ng-click="go('/home')")
    i.fas.fa-home.mr-1
    | Home
  a.breadcrumb-item(ng-click="go('/admin')") Admin
  a.breadcrumb-item(ng-click="go('/admin/' + competitionId)") {{competition.name}}
  a.breadcrumb-item(ng-click="go('/admin/' + competitionId + '/reservation')") Reservation
  span.breadcrumb-item.active Admin

block hero_title_container
  h1.hero-title(ng-bind-html="langContent(resv.i18n, 'name')")

block hero_subtitle
  span(ng-bind-html="langContent(resv.i18n, 'description')")

block main_content
  .modern-card
    .modern-card-header
      i.fas.fa-list.mr-2
      | {{"reservation.status" | translate}}
    .modern-card-body.p-0
      .table-responsive(style="padding: 0 1.5rem 1.5rem;")
        table.table-modern.table-auto
          thead
            tr
              th {{"reservation.start" | translate}}
              th {{"reservation.duration" | translate}}
              th {{"reservation.total" | translate}}
              th {{"reservation.remaining" | translate}}
              th {{"reservation.status" | translate}}
              th(style="width: 90px;") {{"reservation.edit" | translate}}
          tbody
            tr(ng-repeat="slot in resv.slot | orderBy: 'start' track by $index")
              td.text-nowrap(ng-bind="time(slot.start)")
              td(ng-bind='slot.duration')
              td(ng-bind='slot.max')
              td.font-weight-bold(ng-bind='slot.max - slot.booked.length' ng-class="(slot.max - slot.booked.length) >= 0 ? '' : 'text-danger'")
              td(ng-if="!slot.edit")
                span.badge.badge-pill.badge-dark.mr-1.mb-1(ng-repeat="team in slot.booked" style="font-size: 0.8rem;") {{team.teamCode}} {{team.name}}
              td(ng-if="slot.edit")
                ui-select(multiple='' ng-model='slot.booked' theme='bootstrap' sortable='true' close-on-select='false' style='width: 100%;')
                  ui-select-match(placeholder='Select team...') {{$item.code}} {{$item.name}}
                  ui-select-choices(repeat='team in teams | filter: teamFilter')
                    span {{team.teamCode}} {{team.name}}
              td
                .btn-table-group
                  .btn-table-action.primary(ng-if="!slot.edit" ng-click='edit(slot)' uib-tooltip='{{"common.edit" | translate}}')
                    i.fas.fa-edit
                  .btn-table-action(ng-if="slot.edit" ng-click='save(slot)' style="color: #10b981;" uib-tooltip='{{"common.save" | translate}}')
                    i.fas.fa-save
