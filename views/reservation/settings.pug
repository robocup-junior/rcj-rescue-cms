//- -*- tab-width: 2 -*-
extends ../includes/modern_layout

block vars
  - var ngAppDef = 'ReservationSettings'

append scripts
  script.
    var competitionId = "#{id}"
    var resvId = "#{resvId}"
  script(src='/javascripts/reservation/settings.js?v=' + assetVersion)
  script(src='/components/quill/index.js?v=' + assetVersion)
  script(src='/components/ngQuill/src/ng-quill.js?v=' + assetVersion)
  script(src='/components/quill-image-resize-module/image-resize.min.js?v=' + assetVersion)
  script(src='/components/quill-image-drop-and-paste/dist/quill-image-drop-and-paste.min.js?v=' + assetVersion)

append css 
  link(rel='stylesheet', href='/components/quill.snow/index.css?v=' + assetVersion)
  style.
    .ui-select-bootstrap .dropdown-menu {
      display: initial;
    }
    .btn-default {
      background-color: #3498db;
      color: #fff;
      font-size: 10px;
    }
    .ui-select-bootstrap .ui-select-choices-row.active>span {
        color: initial;
        text-decoration: none;
        outline: 0;
        background-color: initial;
    }

block hero_breadcrumb
  a.breadcrumb-item(ng-click="go('/home')")
    i.fas.fa-home.mr-1
    | Home
  a.breadcrumb-item(ng-click="go('/admin')") Admin
  a.breadcrumb-item(ng-click="go('/admin/' + competitionId)") {{competition.name}}
  a.breadcrumb-item(ng-click="go('/admin/' + competitionId + '/reservation')") Reservation
  span.breadcrumb-item.active Reservation Master

block hero_title
  | {{competition.name}}

block hero_subtitle
  | {{"reservation.master" | translate}}

block hero_actions
  button.btn-hero-action(type='button' ng-click='save()')
    i.fas.fa-save
    | {{"admin.settings.set" | translate}}

block main_content
  .modern-card.mb-4
    .modern-card-header
      i.fas.fa-globe.mr-2
      | {{"reservation.name" | translate}} / {{"reservation.description" | translate}}
    .modern-card-body
      ul.nav.nav-tabs.mb-3(role='tablist')
        li.nav-item(ng-repeat="i18n in resv.i18n track by $index" style="margin-right:5px;")
          a.nav-link(ng-class="{active:$first}" ng-attr-id="{{'common_lang'+ $index + '_tab'}}" data-toggle='pill' ng-href="{{'#common_lang'+ $index}}" role='tab' aria-controls="{{'common_lang'+ $index}}" aria-selected='true') {{"language." + i18n.language | translate}}
      .tab-content
        .tab-pane.fade.show(ng-class="{active:$first}" ng-attr-id="{{'common_lang'+ $index}}" role='tabpanel' aria-labelledby="'common_lang'+ $index + '_tab'" ng-repeat="i18n in resv.i18n track by $index")
          .form-group
            label.small.text-muted {{"reservation.name" | translate}}
            input.form-control(type='text' ng-model='i18n.name')
          .form-group
            label.small.text-muted {{"reservation.description" | translate}}
            ng-quill-editor(ng-model="i18n.description")
          .form-group.mb-0
            label.small.text-muted {{"reservation.myDescription" | translate}}
            input.form-control(type='text' ng-model='i18n.myDescription')

  .row
    .col-lg-6
      .modern-card.mb-4
        .modern-card-header
          i.fas.fa-sliders-h.mr-2
          | {{"reservation.master" | translate}}
        .modern-card-body
          .form-group
            label.small.text-muted {{"reservation.deadline" | translate}}
            input.form-control(type='datetime-local' step=1 ng-model='resv.deadline' ng-style="{backgroundColor: deadlineColour(resv.deadline)}")
          .form-group
            label.small.text-muted {{"reservation.open" | translate}}
            select.custom-select(ng-model='resv.enable' ng-style="{backgroundColor: resv.enable ? '#bcffbc':'#ffcccc'}")
              option(ng-value='true') {{"common.enable" | translate}}
              option(ng-value='false') {{"common.disable" | translate}}
          label.small.text-muted {{"document.editor.language" | translate}}
          .input-group.mb-2(ng-repeat="lang in resv.languages")
            .input-group-prepend
              span.input-group-text {{"language." + lang.language | translate}}
            select.custom-select(ng-model='lang.enable' ng-style="{backgroundColor: lang.enable ? '#bcffbc':'#ffcccc'}")
              option(ng-value='true') {{"common.enable" | translate}}
              option(ng-value='false') {{"common.disable" | translate}}
    .col-lg-6
      .modern-card.mb-4
        .modern-card-header
          i.fas.fa-users.mr-2
          | {{"reservation.distribution" | translate}}
        .modern-card-body
          .form-group
            label.small.text-muted {{"reservation.league" | translate}}
            ui-select(multiple='' ng-model='resv.league' theme='bootstrap' sortable='true' close-on-select='false' style='width: 100%;')
              ui-select-match(placeholder='Select league...') {{$item.name}}
              ui-select-choices(repeat='league.id as league in leagues | filter: {id: $select.search}')
                div(ng-bind-html='league.name')
          .text-center.text-muted.font-weight-bold.my-2 OR
          .form-group.mb-0
            label.small.text-muted {{"reservation.team" | translate}}
            ui-select(multiple='' ng-model='resv.team' theme='bootstrap' sortable='true' close-on-select='false' style='width: 100%;')
              ui-select-match(placeholder='Select team...') {{$item.code}} {{$item.name}}
              ui-select-choices(repeat='team._id as team in teams | filter: {_id: $select.search}')
                span {{team.teamCode}} {{team.name}}

  .modern-card.mb-4
    .modern-card-header
      .d-flex.justify-content-between.align-items-center.w-100
        div
          i.fas.fa-clock.mr-2
          | {{"reservation.start" | translate}}
        button.btn.btn-sm.btn-premium-primary(type='button' ng-click='addSlot()')
          i.fas.fa-plus
    .modern-card-body.p-0
      .table-responsive(style="padding: 0 1.5rem 1.5rem;")
        table.table-modern.table-auto
          thead
            tr
              th {{"reservation.start" | translate}}
              th {{"reservation.duration" | translate}}
              th {{"reservation.total" | translate}}
              th(style="width: 90px;") {{"reservation.delete" | translate}}
          tbody
            tr(ng-repeat="slot in resv.slot | orderBy: 'start' track by $index")
              td
                input.form-control.form-control-sm(type='datetime-local' step=1 ng-model='slot.start')
              td
                input.form-control.form-control-sm(type='number' ng-model='slot.duration')
              td
                input.form-control.form-control-sm(type='number' ng-model='slot.max')
              td
                .btn-table-group
                  .btn-table-action.danger(ng-click='removeSlot(slot)' uib-tooltip='{{"common.delete" | translate}}')
                    i.fas.fa-trash-alt

  .text-center.mb-4
    button.btn.btn-premium-primary(type='button' ng-click='save()')
      i.fas.fa-save.mr-2
      | {{"admin.settings.set" | translate}}
