footer.footer(style="background-color: #000000; width: 100%;")
    .d-flex.justify-content-between.align-items-center.w-100.px-3.pt-1.pb-2.m-0
        .footer-text.text-truncate(style="text-align:left; font-size:max(12px, min(1vw, 25px)); white-space: nowrap; color: #aaaaaa;")
