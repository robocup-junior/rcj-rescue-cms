//- The parts of the Rescue Line and Maze sign pages (views/sign/line_2026*.pug, maze_2026*.pug)
//- around the run they show. The controllers are public/javascripts/sign/*_2026*.js, the styles
//- line_view.css.

//- kind: 'line' or 'maze', the path of the judge page
mixin signTopbar(kind)
  header.rv-topbar
    button.rv-back.rv-back-label(type='button' title="{{'line.sign.to_judge' | translate}}" ng-click="go('/" + (kind || 'line') + "/judge/' + runId + '?return=' + getParam('return'))")
      i.fas.fa-edit
      span {{'line.sign.to_judge' | translate}}
    .rv-team
      span.rv-live(title='Live')
      span.rv-team-name {{team}}
    //- Only the time: the score is summed up at the end of the page, after its parts are reviewed
    .rv-topbar-stats
      .rv-stat
        i.fas.fa-stopwatch
        span.rv-stat-value {{minutes*60*1000+seconds*1000 | date:'m:ss'}}

//- One signature: a button to sign, then the signature and a button to sign again
mixin signSlot(index, title)
  - var signed = 'signData[' + index + ']'
  .rv-sign-slot(ng-class="{'is-signed': " + signed + "}")
    .rv-sign-slot-head
      span.rv-sign-state
        i.fas.fa-check(ng-if=signed)
        span(ng-if="!" + signed)= index + 1
      .rv-sign-slot-title(translate=title)
      button.rv-sign-action(type='button' ng-show=signed ng-click='openSign(' + index + ')')
        i.fas.fa-redo
        |  {{'line.sign.clear' | translate}}
    button.rv-sign-start(type='button' ng-show="!" + signed ng-click='openSign(' + index + ')')
      i.fas.fa-signature
      | {{'line.sign.write' | translate}}
    .rv-sign-image(ng-show=signed)
      img(ng-src='{{signData[' + index + ']}}' alt='')

//- The pad over the whole screen, for the signature being written (signature_pad.js)
mixin signPad
  .rv-overlay.is-pad(ng-cloak ng-show='signing !== null' role='dialog' aria-modal='true' aria-labelledby='rv-pad-title')
    .rv-pad-sheet
      .rv-pad-head
        i.fas.fa-signature
        span#rv-pad-title(translate="{{['line.sign.cap_sign', 'line.sign.ref_sign', 'line.sign.cref_sign'][signing]}}")
        button.rv-pad-close(type='button' title="{{'common.cancel' | translate}}" ng-click='closeSign(false)')
          i.fas.fa-times
      .rv-pad-area
        //- Where to sign: a line with a cross, like on paper
        .rv-pad-baseline
        .rv-pad-hint(ng-show='padEmpty')
          | {{'line.sign.padHint' | translate}}
          .rv-pad-rotate
            i.fas.fa-mobile-alt
            |  {{'line.sign.padRotate' | translate}}
        canvas#rv-pad
      .rv-pad-foot
        button.rv-pad-btn(type='button' ng-click='undoSign()' ng-disabled='padEmpty' title="{{'line.sign.undo' | translate}}")
          i.fas.fa-undo
          span {{'line.sign.undo' | translate}}
        button.rv-pad-btn(type='button' ng-click='eraseSign()' ng-disabled='padEmpty' title="{{'line.sign.erase' | translate}}")
          i.fas.fa-eraser
          span {{'line.sign.erase' | translate}}
        button.rv-pad-btn.is-cancel(type='button' ng-click='closeSign(false)') {{'common.cancel' | translate}}
        button.rv-pad-btn.is-done(type='button' ng-click='closeSign(true)' ng-disabled='padEmpty')
          i.fas.fa-check
          |  {{'line.sign.comp' | translate}}

//- Comment, the three signatures and sending the run
mixin signForm
  section.rv-card#rv-comment
    .rv-card-header
      i.fas.fa-comment
      | {{'line.sign.comment' | translate}}
    .rv-card-body
      p.rv-note {{'line.sign.comment_e' | translate}}
      textarea.form-control(ng-model='comment' rows='3')

  section.rv-card#rv-signatures
    .rv-card-header
      i.fas.fa-pencil-alt
      | {{'line.sign.sign' | translate}}
      span.rv-header-total {{signedCount()}} / 3
    .rv-card-body
      p.rv-note.rv-note-warning(translate='line.sign.sign_e')
      .rv-sign-slots
        +signSlot(0, 'line.sign.cap_sign')
        +signSlot(1, 'line.sign.ref_sign')
        +signSlot(2, 'line.sign.cref_sign')

  //- Says what is still missing; once all have signed it opens the sheet to check and send
  button.rv-submit(type='button' ng-click='send_sign()' ng-class="{'is-ready': signedCount() == 3}")
    i.fas(ng-class="signedCount() == 3 ? 'fa-paper-plane' : 'fa-signature'")
    span(ng-if='signedCount() == 3') {{'line.sign.submit' | translate}}
    span(ng-if='signedCount() < 3') {{'line.sign.needSigns' | translate:{n: 3 - signedCount()} }}

  +signPad
  +sendSheet

//- Checking the run once more before sending it, then sending, an error to retry, the end
mixin sendSheet
  .rv-overlay.is-send(ng-cloak ng-show='sendState' role='dialog' aria-modal='true' aria-labelledby='rv-send-title')
    .rv-send-sheet
      //- Done: the run is final
      .rv-send-done(ng-if="sendState == 'done'")
        .rv-send-done-mark
          i.fas.fa-check
        #rv-send-title.rv-send-title {{'line.sign.sent' | translate}}
        p {{'line.sign.complete' | translate}}
        button.rv-pad-btn.is-done(type='button' ng-click='leaveSign()')
          | {{'line.sign.backToList' | translate}}
      div(ng-if="sendState != 'done'")
        .rv-pad-head
          i.fas.fa-paper-plane
          span#rv-send-title {{'line.sign.confirmTitle' | translate}}
        .rv-send-body
          //- What is being sent: the team, the score and time, the signatures and the comment
          .rv-send-run
            .rv-send-team {{team}}
            .rv-send-stats
              span
                b {{score}}
                |  {{'common.point' | translate}}
              span
                i.fas.fa-stopwatch
                |  {{minutes*60*1000+seconds*1000 | date:'m:ss'}}
          .rv-send-signs
            figure(ng-repeat="title in ['line.sign.cap_sign', 'line.sign.ref_sign', 'line.sign.cref_sign']")
              img(ng-src='{{signData[$index]}}' alt='')
              figcaption {{title | translate}}
          .rv-send-comment(ng-if='comment')
            i.fas.fa-comment
            | {{comment}}
          p.rv-send-warning
            i.fas.fa-exclamation-triangle
            | {{'line.sign.sendNote' | translate}}
          p.rv-send-error(ng-if="sendState == 'error'" role='alert')
            i.fas.fa-wifi
            | {{'line.sign.sendError' | translate}}
        .rv-pad-foot
          button.rv-pad-btn.is-cancel(type='button' ng-click='cancelSend()' ng-disabled="sendState == 'sending'") {{'common.cancel' | translate}}
          button.rv-pad-btn.is-done.is-send(type='button' ng-click='confirmSend()' ng-disabled="sendState == 'sending'")
            i.fas(ng-class="sendState == 'sending' ? 'fa-spinner fa-spin' : (sendState == 'error' ? 'fa-redo' : 'fa-paper-plane')")
            |  {{(sendState == 'sending' ? 'line.sign.sending' : (sendState == 'error' ? 'line.sign.retry' : 'line.sign.send')) | translate}}
