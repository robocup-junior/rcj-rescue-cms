    link(rel='stylesheet',href='/components/bootstrap/dist/css/bootstrap.min.css?v=' + assetVersion)
    link(rel='stylesheet',href='/stylesheets/style.css?v=' + assetVersion)
    if !noNavbar
        link(rel='stylesheet',href='/stylesheets/navbar_premium.css?v=' + assetVersion)
    link(href="/components/font-awesome-5/css/all.min.css?v=" + assetVersion rel="stylesheet")
    link(rel='stylesheet' href='/components/angular-bootstrap/dist/ui-bootstrap-csp.css?v=' + assetVersion)
    link(rel='stylesheet' href='/components/angular-ui-select/dist/select.min.css?v=' + assetVersion)
    if process.env.ENVIRONMENT == "STG"
        link(rel='stylesheet',href='/stylesheets/stg.css?v=' + assetVersion)