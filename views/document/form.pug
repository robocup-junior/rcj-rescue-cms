    .driver-popover.driver-premium-theme .driver-popover-next-btn {
      background: #3b82f6 !important;
      color: white !important;
      box-shadow: 0 4px 12px rgba(59, 130, 246, 0.25) !important;
    }
    .driver-popover.driver-premium-theme .driver-popover-next-btn:hover {
      background: #2563eb !important;
      box-shadow: 0 6px 15px rgba(59, 130, 246, 0.35) !important;
    }
    .driver-popover.driver-premium-theme .driver-popover-prev-btn {
      background: #f1f5f9 !important;
      color: #64748b !important;
    }
    .driver-popover.driver-premium-theme .driver-popover-prev-btn:hover {
      background: #e2e8f0 !important;
      color: #1e293b !important;
    }
    .driver-popover.driver-premium-theme .driver-popover-close-btn {
