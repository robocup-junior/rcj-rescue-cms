      background: #f8fafc;
      border-bottom: 1px solid #e2e8f0;
    }
    .document-card-title {
      font-size: 1.1rem;
      font-weight: 600;
      color: #1e293b;
      margin: 0;
      display: flex;
      align-items: center;
    }
    .document-card-body {
      padding: 1.5rem;
    }
    .question-container {
      margin-bottom: 2.5rem;
    }
    .question-title {
      font-size: 1.2rem;
      font-weight: 700;
      color: #334155;
      margin-bottom: 0.75rem;
      display: flex;
      align-items: center;
      flex-wrap: wrap;
