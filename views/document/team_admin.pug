//- -*- tab-width: 2 -*-
extends ../includes/modern_layout

block vars
  - var ngAppDef = 'TeamAdmin'

append scripts
  script.
    var competitionId = "#{id}"
  script(src='/javascripts/document/team_admin.js?v=' + assetVersion)

block hero_breadcrumb
  a.breadcrumb-item(ng-click="go('/home')")
    i.fas.fa-home.mr-1
    | Home
  a.breadcrumb-item(ng-click="go('/admin')") Admin
  a.breadcrumb-item(ng-click="go('/admin/' + competition._id)") {{competition.name}}
  a.breadcrumb-item(ng-click="go('/admin/' + competition._id + '/documents')") Document settings
  span.breadcrumb-item.active Team settings

block hero_title
  | {{competition.name}}

block hero_subtitle
  | {{'document.teamAdmin.title' | translate}}

block main_content
  .modern-card
    .modern-card-header
      .d-flex.justify-content-between.align-items-center.w-100
        div
          i.fas.fa-users.mr-2
          | {{'document.teamAdmin.title' | translate}}
        .btn-table-group
          .btn-table-action.primary(ng-click="showFilter = !showFilter" ng-class="showFilter ? 'active-blue' : ''" uib-tooltip="{{'common.refine' | translate}}")
            i.fas.fa-filter
    .filter-collapse(ng-show="showFilter" style="background: #f8fafc; border-bottom: 1px solid #f1f5f9; padding: 1.5rem;")
      .row
        .col-md-3.mb-2
          h6.font-weight-bold.text-muted.small.text-uppercase.mb-2 {{"common.teamCode" | translate}}
          .input-group
            .input-group-prepend
              span.input-group-text
                i.fas.fa-hashtag
            input.form-control.form-control-sm(type='text' placeholder='{{"common.teamCode" | translate}}' ng-model='refineCode')
        .col-md-3.mb-2
          h6.font-weight-bold.text-muted.small.text-uppercase.mb-2 {{"common.team" | translate}}
          .input-group
            .input-group-prepend
              span.input-group-text
                i.fas.fa-users
            input.form-control.form-control-sm(type='text' placeholder='{{"common.team" | translate}}' ng-model='refineName')
        .col-md-3.mb-2
          h6.font-weight-bold.text-muted.small.text-uppercase.mb-2 {{"common.region" | translate}}
          .input-group
            .input-group-prepend
              span.input-group-text
                i.fas.fa-globe-asia
            input.form-control.form-control-sm(type='text' placeholder='{{"common.region" | translate}}' ng-model='refineRegion')
        .col-md-3.mb-2
          h6.font-weight-bold.text-muted.small.text-uppercase.mb-2 {{"common.league" | translate}}
          .filter-container
            span.filter-badge(ng-repeat='(key, value) in Rleagues track by key' ng-class="{'active': Rleagues[key]}" ng-click="Rleagues[key] = !Rleagues[key]") {{key}}
    .modern-card-body.p-0
      .table-responsive(style="padding: 0 1.5rem 1.5rem;")
        table.table-modern.table-auto
          thead
            tr
              th {{"common.teamCode" | translate}}
              th {{"common.team" | translate}}
              th {{"common.region" | translate}}
              th {{"common.league" | translate}}
              th {{'document.teamAdmin.access' | translate}}
              th {{'document.deadline' | translate}}
              th {{'document.teamAdmin.penalty' | translate}}
              th {{'document.teamAdmin.public' | translate}}
              th(style="width: 140px;") {{'common.operation' | translate}}
          tbody
            tr(ng-repeat='team in teams | filter:list_filter | orderBy:"[teamCode, name]"')
              td(ng-bind='team.teamCode')
              td.font-weight-bold(ng-bind='team.name')
              td(ng-bind='team.country')
              td(ng-bind='team.league')
              td
                select.custom-select.custom-select-sm(ng-model='team.document.enabled' ng-change="save(team)" ng-style="{backgroundColor: team.document.enabled ? '#bcffbc':'#ffcccc'}")
                  option(ng-value='true') {{'common.enable' | translate}}
                  option(ng-value='false') {{'common.disable' | translate}}
              td
                input.form-control.form-control-sm(type='datetime-local' step=1 ng-model='team.document.deadline' ng-blur="save(team)" ng-style="{backgroundColor: deadlineColour(team.document.deadline)}")
              td
                .input-group.input-group-sm(style="max-width: 110px;")
                  input.form-control(type="number" ng-model='team.document.penalty' ng-blur="save(team)" ng-style="{backgroundColor: penaltyColor(team.document.penalty)}")
                  .input-group-append
                    span.input-group-text %
              td
                select.custom-select.custom-select-sm(ng-model='team.document.public' ng-change="save(team)" ng-style="{backgroundColor: team.document.public ? '#bcffbc':'#ffcccc'}")
                  option(ng-value='true') {{'common.enable' | translate}}
                  option(ng-value='false') {{'common.disable' | translate}}
              td
                .btn-table-group
                  .btn-table-action(ng-click="openLog(team)" uib-tooltip="{{'document.teamAdmin.log' | translate}}")
                    i.fas.fa-file-alt
                  .btn-table-action(ng-click="copy(team)" uib-tooltip="{{'common.copy' | translate}}")
                    i.fas.fa-clipboard
