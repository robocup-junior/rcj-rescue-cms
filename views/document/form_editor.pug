//- -*- tab-width: 2 -*-
extends ../includes/modern_layout

block vars
  - var ngAppDef = 'FormEditor'

append scripts
  script.
    var competitionId = "#{id}"
    var leagueId = "#{lid}"
  script(src="/javascripts/document/form_editor.js")
  script(src='/components/tinycolor/dist/tinycolor-min.js')
  script(src='/components/angular-color-picker/dist/angularjs-color-picker.min.js')
  script(src='/components/quill/index.js')
  script(src='/components/ngQuill/src/ng-quill.js')
  script(src='/components/quill-image-resize-module/image-resize.min.js')
  script(src='/components/quill-image-drop-and-paste/dist/quill-image-drop-and-paste.min.js')
  script(src="/components/bootstrap-fileinput/js/fileinput.min.js")
  script(src="/components/bootstrap-fileinput/themes/fa/theme.min.js")
  script(src="/components/bootstrap-fileinput/js/locales/ja.js")

append css
  link(rel='stylesheet', href='/components/angular-color-picker/dist/angularjs-color-picker.min.css')
  link(rel='stylesheet', href='/components/quill.snow/index.css')
  link(href="/components/bootstrap-fileinput/css/fileinput.min.css" rel="stylesheet")
  link(href='/stylesheets/common/modern_editor.css', rel='stylesheet')
  style.
    .notification-card {
      border-radius: 14px;
      padding: 1.25rem 1.5rem;
      margin-bottom: 1.25rem;
      border: 2px solid;
    }

block hero_breadcrumb
  a.breadcrumb-item(ng-click="go('/home')") Home
  a.breadcrumb-item(ng-click="go('/admin')") Admin
  a.breadcrumb-item(ng-click="go('/admin/' + competition._id)") {{competition.name}}
  a.breadcrumb-item(ng-click="go('/admin/' + competition._id + '/documents')") Document settings
  span.breadcrumb-item.active {{league.name}}

block hero_title
  | {{league.name}}

block hero_subtitle
  i.fas.fa-edit.mr-2
  | {{"document.editor.title" | translate}}

block hero_actions
  button.btn-premium.btn-premium-secondary(type='button', ng-click='preview()')
    i.fas.fa-eye
    | {{"document.editor.preview" | translate}}
  button.btn-premium.btn-premium-dark(type='button', ng-click='save()')
    i.fas.fa-save
    | {{"common.save" | translate}}

block main_content
  h5.section-heading.mb-2
    i.fas.fa-file-export
    | Templates
  .modern-card
    .modern-card-body
      .row
        .col-md-6
          .settings-group
            button.btn-premium.btn-premium-dark(type='button', ng-click='export()')
              i.fas.fa-file-export
              | {{"document.editor.export" | translate}}
        .col-md-6
          .settings-group
            label.settings-label {{"document.editor.import" | translate}}
            input#select(type='file', name='select')
      .settings-group.mb-0
        label.settings-label {{"mail.home.loadTemplate" | translate}}
        select.premium-select(ng-model='selectedTemplate', ng-options='template.path as template.name for template in templates', ng-change="changeTemplate()")
          option(value="") {{"mail.home.selectTemplate" | translate}}

  h5.section-heading.section-gap.mb-2
    i.fas.fa-sliders-h
    | {{"document.editor.language" | translate}}
  .modern-card
    .modern-card-body
      .settings-group(ng-repeat="lang in languages")
        label.settings-label {{"language." + lang.language | translate}}
        select.premium-select(ng-model='lang.enable', ng-blur="save()")
          option(ng-value='true') {{"common.enable" | translate}}
          option(ng-value='false') {{"common.disable" | translate}}
      .settings-group.mb-0
        label.settings-label {{"document.editor.maxLength" | translate}}
        input.premium-input(type='number', ng-model='maxLength', ng-blur="save()")

  h5.section-heading.section-gap.mb-2
    i.fas.fa-bullhorn
    | {{"document.editor.notification" | translate}}
  .add-item-row
    button.btn-premium.btn-premium-primary(type='button', ng-click='addNotice(0)')
      i.fas.fa-plus
      | {{"document.editor.addNotification" | translate}}
  div(style="margin: 20px;" ng-repeat="notification in notifications track by $index")
    .notification-card(role="alert", ng-style="{color: '#'+ notification.color, backgroundColor: '#'+ notification.bkColor, borderColor: '#'+ notification.color}")
      .row
        .col-md-4
          .settings-group.mb-0
            span {{"document.editor.letterColour" | translate}}:
            color-picker(ng-model='notification.color' options="{'format':'HEX'}" ng-blur="save()")
        .col-md-4
          .settings-group.mb-0
            span {{"document.editor.backgroundColour" | translate}}:
            color-picker(ng-model='notification.bkColor' options="{'format':'HEX'}" ng-blur="save()")
        .col-md-4.toolbar-actions(style="justify-content: flex-end;")
          button.icon-btn-premium(type='button', ng-click='moveNotice($index,$index-1)', ng-disabled="$first")
            i.fas.fa-chevron-up
          button.icon-btn-premium(type='button', ng-click='moveNotice($index,$index+1)', ng-disabled="$last")
            i.fas.fa-chevron-down
          button.icon-btn-premium.danger(type='button', ng-click='removeNotice($index)')
            i.fas.fa-trash-alt
      ul.nav.premium-tabs.nav-tabs.mb-3(role='tablist')
        i.fas.fa-globe.fa-2x &nbsp;
        li.nav-item(ng-repeat="i18n in notification.i18n track by $index", style="margin-right:5px;")
          a.nav-link(ng-class="{active:$first}",ng-attr-id="{{'notification' + $parent.$index + '_lang'+ $index + '_tab'}}", data-toggle='pill',ng-href="{{'#notification' + $parent.$index + '_lang'+ $index}}", role='tab', aria-controls="{{'notification' + $parent.$index + '_lang'+ $index}}", aria-selected='true') {{"language." + i18n.language | translate}}
      .tab-content(style="margin-bottom:10px;")
        .tab-pane.fade.show(ng-class="{active:$first}", ng-attr-id="{{'notification' + $parent.$index + '_lang'+ $index}}", role='tabpanel', aria-labelledby="'notification' + $parent.$index + '_lang'+ $index + '_tab'", ng-repeat="i18n in notification.i18n track by $index")
          .settings-group
            label.settings-label {{"document.editor.cTitle" | translate}}
            input.premium-input(type='text', ng-model='i18n.title', ng-blur="save()")
          .settings-group.mb-0
            label.settings-label {{"document.editor.content" | translate}}
            .quill-editor-wrapper
              ng-quill-editor(ng-model="i18n.description", ng-blur="save()")

    .add-item-row
      button.btn-premium.btn-premium-primary(type='button', ng-click='addNotice($index+1)')
        i.fas.fa-plus
        | {{"document.editor.addNotification" | translate}}

  h5.section-heading.section-gap.mb-2
    i.fas.fa-question-circle
    | {{"document.editor.question" | translate}}
  .add-item-row
    button.btn-premium.btn-premium-primary(type='button', ng-click='addBlock(0)')
      i.fas.fa-plus
      | {{"document.editor.addBlock" | translate}}

  div(ng-repeat="block in blocks track by $index")
    .document-card(ng-style="{borderLeft: '6px solid #' + block.color}")
      .document-card-header.d-flex.justify-content-between.align-items-center
        span
          i.fas.fa-layer-group
          | {{"document.editor.block" | translate}}
        .toolbar-actions
          button.icon-btn-premium(type='button', ng-click='moveBlock($index,$index-1)', ng-disabled="$first")
            i.fas.fa-chevron-up
          button.icon-btn-premium(type='button', ng-click='moveBlock($index,$index+1)', ng-disabled="$last")
            i.fas.fa-chevron-down
          button.icon-btn-premium.danger(type='button', ng-click='removeBlock($index)')
            i.fas.fa-trash-alt
      .document-card-body
        ul.nav.premium-tabs.nav-tabs.mb-3(role='tablist')
          i.fas.fa-globe.fa-2x &nbsp;
          li.nav-item(ng-repeat="i18n in block.i18n track by $index", style="margin-right:5px;")
            a.nav-link(ng-class="{active:$first}",ng-attr-id="{{'block' + $parent.$index + '_lang'+ $index + '_tab'}}", data-toggle='pill',ng-href="{{'#block' + $parent.$index + '_lang'+ $index}}", role='tab', aria-controls="{{'block' + $parent.$index + '_lang'+ $index}}", aria-selected='true')  {{"language." + i18n.language | translate}}
        .tab-content(style="margin-bottom:10px;")
          .tab-pane.fade.show(ng-class="{active:$first}", ng-attr-id="{{'block' + $parent.$index + '_lang'+ $index}}", role='tabpanel', aria-labelledby="'block' + $parent.$index + '_lang'+ $index + '_tab'", ng-repeat="i18n in block.i18n track by $index")
            .settings-group.mb-0
              label.settings-label {{"document.editor.blockTitle" | translate}}
              input.premium-input(type='text', ng-model='i18n.title', ng-blur="save()")
        .settings-group.mb-0(style="max-width: 260px;")
          label.settings-label {{"document.editor.blockColour" | translate}}
          color-picker(ng-model='block.color', options="{'format':'HEX'}", ng-blur="save()")
        hr
        .add-item-row
          button.btn-premium.btn-premium-primary(type='button', ng-click="addQuestion($index,0,'input')")
            i.fas.fa-plus
            | {{"document.editor.addQuestion" | translate}}

        div(ng-repeat="question in block.questions track by $index")
          .question-editor-card
            .row(style="margin-bottom: 1rem;")
              .col-md-3
                .settings-group.mb-0
                  label.settings-label {{"document.editor.questionType" | translate}}:
                  select.premium-select(ng-model='question.type', ng-blur="save()")
                    option(value='input') {{"document.editor.writing" | translate}}
                    option(value='select') {{"document.editor.select" | translate}}
                    option(value='scale') {{"document.editor.scale" | translate}}
                    option(value='pdf') {{"document.editor.pdf" | translate}}
                    option(value='picture') {{"document.editor.picture" | translate}}
                    option(value='movie') {{"document.editor.video" | translate}}
                    option(value='zip') {{"document.editor.archive" | translate}}
              .col-md-3
                .settings-group.mb-0
                  label.settings-label {{"document.editor.requiredOrNot" | translate}}
                  select.premium-select(ng-model='question.required', ng-blur="save()")
                    option(ng-value='true') {{"document.editor.required" | translate}}
                    option(ng-value='false') {{"document.editor.optional" | translate}}
              .col-md-3
                .settings-group.mb-0
                  label.settings-label Make public
                  select.premium-select(ng-model='question.public', ng-blur="save()")
                    option(ng-value='false') {{"common.disable" | translate}}
                    option(ng-value='true') {{"common.enable" | translate}}
              .col-md-3.toolbar-actions(style="justify-content: flex-end; align-items: flex-end; height: 100%;")
                button.icon-btn-premium(type='button', ng-click='moveQuestion($parent.$index,$index,$index-1)', ng-disabled="$first")
                  i.fas.fa-chevron-up
                button.icon-btn-premium(type='button', ng-click='moveQuestion($parent.$index,$index,$index+1)', ng-disabled="$last")
                  i.fas.fa-chevron-down
                button.icon-btn-premium.danger(type='button', ng-click='removeQuestion($parent.$index,$index)')
                  i.fas.fa-trash-alt

            ul.nav.premium-tabs.nav-tabs.mb-3(role='tablist')
              i.fas.fa-globe.fa-2x &nbsp;
              li.nav-item(ng-repeat="i18n in question.i18n track by $index", style="margin-right:5px;")
                a.nav-link(ng-class="{active:$first}",ng-attr-id="{{'block' + $parent.$parent.$index + '_question' + $parent.$index + '_lang'+ $index + '_tab'}}", data-toggle='pill',ng-href="{{'#block' + $parent.$parent.$index + '_question' + $parent.$index + '_lang'+ $index}}", role='tab', aria-controls="{{'block' + $parent.$parent.$index + '_question' + $parent.$index + '_lang'+ $index}}", aria-selected='true') {{"language." + i18n.language | translate}}
            .tab-content
              .tab-pane.fade.show(ng-class="{active:$first}", ng-attr-id="{{'block' + $parent.$parent.$index + '_question' + $parent.$index + '_lang'+ $index}}", role='tabpanel', aria-labelledby="'block' + $parent.$parent.$index + '_question' + $parent.$index + '_lang'+ $index + '_tab'", ng-repeat="i18n in question.i18n track by $index")
                .settings-group
                  label.settings-label {{"document.editor.questionTitle" | translate}}
                  input.premium-input(type='text', ng-model='i18n.question', ng-blur="save()")
                .settings-group
                  label.settings-label {{"document.editor.description" | translate}}
                  .quill-editor-wrapper
                    ng-quill-editor(ng-model="i18n.description", ng-blur="save()")
                div(ng-if="question.type == 'input'")
                  .settings-group
                    label.settings-label {{"document.editor.maxLength" | translate}}
                    input.premium-input(type='number', ng-model='question.maxLength', ng-blur="save()")
                  .settings-group.mb-0
                    label.settings-label {{"document.editor.hints" | translate}}
                    .quill-editor-wrapper
                      ng-quill-editor(ng-model="i18n.example", ng-blur="save()")
                div(ng-if="question.type == 'select'")
                  label.settings-label {{"document.editor.choices" | translate}}
                  div(ng-repeat="option in i18n.options track by $index", style="margin:10px 0px;")
                    .toolbar-actions
                      span.text-muted(style="min-width: 30px;") {{option.value}}
                      input.premium-input(type='text', ng-model='option.text', ng-blur="save()")
                      button.icon-btn-premium(type='button', ng-disabled="$first", ng-click='moveOption($parent.$parent.$parent.$parent.$index, $parent.$parent.$parent.$index, $parent.$index, $index, $index-1)')
                        i.fas.fa-chevron-up
                      button.icon-btn-premium(type='button', ng-disabled="$last", ng-click='moveOption($parent.$parent.$parent.$parent.$index, $parent.$parent.$parent.$index, $parent.$index, $index, $index+1)')
                        i.fas.fa-chevron-down
                      button.icon-btn-premium.danger(type='button', ng-click='removeOption($parent.$parent.$parent.$parent.$index, $parent.$parent.$parent.$index, $parent.$index, $index)')
                        i.fas.fa-trash-alt
                  .add-item-row
                    button.btn-premium.btn-premium-dark(type='button', ng-click='addOption($parent.$parent.$parent.$index, $parent.$parent.$index, $parent.$index)')
                      i.fas.fa-plus
                div(ng-if="question.type == 'scale'")
                  .settings-group
                    label.settings-label {{"document.editor.least" | translate}}
                    input.premium-input(type='number', ng-model='question.scale.least', ng-blur="save()")
                  .settings-group.mb-0
                    label.settings-label {{"document.editor.most" | translate}}
                    input.premium-input(type='number', ng-model='question.scale.most', ng-blur="save()")
                div(ng-if="question.type == 'pdf' || question.type == 'picture' || question.type == 'movie' || question.type == 'zip'")
                  .settings-group.mb-0
                    label.settings-label {{"document.editor.fileName" | translate}}
                    input.premium-input(type='text', ng-model='question.fileName', ng-blur="save()")
                    small.text-muted {{"document.editor.extension" | translate}}

          .add-item-row
            button.btn-premium.btn-premium-dark(type='button', ng-click="addQuestion($parent.$index,$index+1,'input')")
              i.fas.fa-plus
              | {{"document.editor.addQuestion" | translate}}

    .add-item-row
      button.btn-premium.btn-premium-primary(type='button', ng-click='addBlock($index+1)')
        i.fas.fa-plus
        | {{"document.editor.addBlock" | translate}}
