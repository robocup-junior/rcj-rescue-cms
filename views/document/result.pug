//- -*- tab-width: 2 -*-
extends ../includes/modern_layout

block vars
  - var heroContainerStyle = 'max-width: 1600px;'
  - var contentContainerStyle = 'max-width: 1600px;'
  - var ngAppDef = 'DocumentResult'

append scripts
  script.
    var competitionId = "#{id}"
    var leagueId = "#{lid}"
  script(src='/javascripts/document/result.js')
  script(src='/components/exceljs/index.js')


block hero_breadcrumb
  a.breadcrumb-item(ng-click="go('/home')")
    i.fas.fa-home.mr-1
    | Home
  a.breadcrumb-item(ng-click="go('/admin')") Admin
  a.breadcrumb-item(ng-click="go('/admin/' + competition._id)") {{competition.name}}
  a.breadcrumb-item(ng-click="go('/admin/' + competition._id + '/documents')") Document settings
  span.breadcrumb-item.active Results

block hero_title
  | {{competition.name}}

block hero_subtitle
  | {{'document.result.title' | translate}}

block hero_actions
  button.btn-action-icon(type='button' ng-click="downloadExcel()" uib-tooltip='Export' tooltip-placement="bottom")
    i.fas.fa-file-excel

block main_content
  .modern-card
    .modern-card-header
      .d-flex.justify-content-between.align-items-center.w-100
        div
          i.fas.fa-chart-bar.mr-2
          | {{'document.result.title' | translate}}
        .btn-table-group
          .btn-table-action.primary(ng-click="showFilter = !showFilter" ng-class="showFilter ? 'active-blue' : ''" uib-tooltip="{{'common.refine' | translate}}")
            i.fas.fa-filter
    .filter-collapse(ng-show="showFilter" style="background: #f8fafc; border-bottom: 1px solid #f1f5f9; padding: 1.5rem;")
      .row
        .col-md-3.mb-2
          h6.font-weight-bold.text-muted.small.text-uppercase.mb-2 {{"common.teamCode" | translate}}
          .input-group
            .input-group-prepend
              span.input-group-text
                i.fas.fa-hashtag
            input.form-control.form-control-sm(type='text' placeholder='{{"common.teamCode" | translate}}' ng-model='refineCode')
        .col-md-3.mb-2
          h6.font-weight-bold.text-muted.small.text-uppercase.mb-2 {{"common.team" | translate}}
          .input-group
            .input-group-prepend
              span.input-group-text
                i.fas.fa-users
            input.form-control.form-control-sm(type='text' placeholder='{{"common.team" | translate}}' ng-model='refineName')
        .col-md-3.mb-2
          h6.font-weight-bold.text-muted.small.text-uppercase.mb-2 {{"common.region" | translate}}
          .input-group
            .input-group-prepend
              span.input-group-text
                i.fas.fa-globe-asia
            input.form-control.form-control-sm(type='text' placeholder='{{"common.region" | translate}}' ng-model='refineRegion')
        .col-md-3.mb-2
          h6.font-weight-bold.text-muted.small.text-uppercase.mb-2 {{"common.sort" | translate}}
          .filter-container
            span.filter-badge(ng-repeat="b in teams[0].details track by $index" ng-class="{'active': activeSortKey == b.blockId}" ng-click="changeSort(b.blockId)" ng-bind="blockTitle[b.blockId]")
            span.filter-badge(ng-class="{'active': activeSortKey == -1}" ng-click="changeSort(-1)")
              i.fas.fa-calculator.mr-1
              | {{"common.totalScore" | translate}}
    .modern-card-body.p-0
      .table-responsive(style="padding: 0 1.5rem 1.5rem;")
        table.table-modern.table-auto
          thead
            tr
              th {{"common.teamCode" | translate}}
              th {{"common.team" | translate}}
              th {{"common.region" | translate}}
              th {{"document.teamAdmin.penalty" | translate}}
              th(ng-repeat="b in teams[0].details track by $index" ng-bind="blockTitle[b.blockId]" ng-style="activeSortKey == b.blockId && {'color': '#d97706'}")
              th(ng-style="activeSortKey == -1 && {'color': '#d97706'}")
                i.fas.fa-calculator.mr-1
                | {{"common.totalScore" | translate}}
          tbody
            tr(ng-repeat='team in teams | filter:list_filter')
              td(ng-bind='team.teamCode')
              td
                a.font-weight-bold(href="" ng-click="go('/document/reviewed/' + team._id + '?return=/admin/' + competitionId + '/documents/' + leagueId + '/results')" ng-bind='team.name')
              td(ng-bind='team.country')
              td {{team.document.penalty}}%
              td(ng-repeat="b in team.details" ng-style="activeSortKey == b.blockId && {'background-color': '#fef3c7'}")
                .font-weight-bold {{b.score}}
                .small.text-muted
                  i.fa.fa-chart-bar.mr-1
                  | {{b.normalizedScore}}
                .small.text-muted
                  i.fas.fa-exclamation-triangle.mr-1(style='color: #f59e0b;' ng-show="b.warning")
                  i.fas.fa-user.mr-1
                  | {{b.reviewerNum}}
                  span(ng-show="b.reviewerNum != b.expectedReviewerNum") /{{b.expectedReviewerNum}}
              td(ng-style="activeSortKey == -1 && {'background-color': '#fef3c7'}")
                span.font-weight-bold(ng-if="team.details.length>0")
                  i.fa.fa-chart-bar.mr-1
                  | {{team.score}}
