//- -*- tab-width: 2 -*-
extends ../includes/modern_layout

block vars
  - var ngAppDef = 'SignageSetting'

append scripts
  script(src='/javascripts/signage/setting.js')

block hero_breadcrumb
  a.breadcrumb-item(ng-click="go('/home')")
    i.fas.fa-home.mr-1
    | Home
  a.breadcrumb-item(ng-click="go('/admin')") Admin
  span.breadcrumb-item.active Signage setting

block hero_title
  | {{"admin.home.signage" | translate}}

block hero_subtitle
  | Admin

block hero_actions
  button.btn-action-icon(type='button' onclick="location.href='/signage/setting/files'" uib-tooltip='Upload Files' tooltip-placement="bottom")
    i.fas.fa-file-upload
  a.btn-create-map(href='/signage/setting/editor')
    i.fas.fa-plus-circle
    span {{"signage.create" | translate}}

block main_content
  .modern-card
    .modern-card-header
      i.fas.fa-desktop.mr-2
      | {{"admin.home.signage" | translate}}
    .modern-card-body.p-0
      .table-responsive(style="padding: 0 1.5rem 1.5rem;")
        table.table-modern.table-auto
          thead
            tr
              th {{"common.name" | translate}}
              th(style="width: 210px;") {{"common.operation" | translate}}
          tbody
            tr(ng-repeat='sign in signs')
              td.font-weight-bold
                a(ng-bind='sign.name' ng-href="/signage/setting/editor/{{sign._id}}")
              td
                .btn-table-group
                  .btn-table-action.primary(ng-click='go("/signage/setting/editor/"+sign._id)' uib-tooltip='{{"common.edit" | translate}}')
                    i.fas.fa-edit
                  .btn-table-action(ng-click='go("/signage/display/"+sign._id+"/0")' uib-tooltip='{{"common.view" | translate}}')
                    i.fas.fa-eye
                  .btn-table-action.danger(ng-click='removeSig(sign)' uib-tooltip='{{"common.delete" | translate}}')
                    i.fas.fa-trash-alt
