# db vars see more at http://mongoosejs.com/docs/connections.html
DB_CONNECT_STR=mongodb://localhost/rcj-cms

# Session Secret: the key the session cookies are signed with. Set one of your own (a long random
# string, the same for every process), or leave it out to have one made and kept in the database.
#SESSION_SECRET=

#Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# Prefix of the mail and backup queues' keys, to keep apart apps on the same Redis (default bull)
#QUEUE_PREFIX=bull

# web vars
WEB_HOSTPORT=3000

# log vars ERROR/INFO/DEBUG
MAIN_LOG_LVL=DEBUG

# Account hardcoded
user=admin
password=admin

# Default Account Setting
dUsername=admin
dPassword=adminpass
dAdmin=true
dSDAdmin=true

# Mail Server Configuration
#MAIL_SMTP=smtp.example.com
#MAIL_PORT=587
#MAIL_USER=USER
#MAIL_PASS=PASS
#MAIL_FROM=no-reply@example.com
#MAIL_SENDER=RoboCupJunior CMS
#MAIL_REPLY=support@example.com
#MAIL_MAX_PER_SECOND=5

# REGISTRATION SYSTEM
CMS_PROTOCOL=http
CMS_HOSTNAME=localhost:3000

# SCALEOUT
PROCESS_NUM=1

# LIMITER
LIMITER_WINDOW_MS=1000
LIMITER_MAX=50
# PDFs and pictures made a minute for each address, of the maps the public map editors send
#FILES_MADE_PER_MINUTE=30
# Wrong logins for an account in fifteen minutes before the next are refused
#LOGIN_FAILURES_MAX=10

# The database's editor (mongo-express) at /admin/mongo, for the super admins; off unless true
#MONGO_EXPRESS=true

# PROXY
# The proxies before the app, whose X-Forwarded-For gives the clients' addresses (see Express's
# "trust proxy"); by default those of the machine and of private networks
#TRUST_PROXY=loopback, linklocal, uniquelocal

# AUTOMATIC BACKUP
#BACKUP_INTERVAL_HOUR=24
#BACKUP_KEEP_VERSION=3

# ENV
# STG or PROD
ENVIRONMENT=PROD
NODE_ENV=production