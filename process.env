# db vars see more at http://mongoosejs.com/docs/connections.html
DB_CONNECT_STR=mongodb://localhost/rcj-cms

# Session Secret: the key the session cookies are signed with. Set one of your own (a long random
# string, the same for every process), or leave it out to have one made and kept in the database.
#SESSION_SECRET=

#Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# Prefix of the mail and backup queues' keys, to keep apart apps on the same Redis (default bull)
#QUEUE_PREFIX=bull

# web vars
WEB_HOSTPORT=3000

# log vars ERROR/INFO/DEBUG
MAIN_LOG_LVL=DEBUG

# Account hardcoded
user=admin
password=admin

# Default Account Setting
dUsername=admin
dPassword=adminpass
dAdmin=true
dSDAdmin=true

# Mail Server Configuration
#MAIL_SMTP=smtp.example.com
#MAIL_PORT=587
#MAIL_USER=USER
#MAIL_PASS=PASS
#MAIL_FROM=no-reply@example.com
#MAIL_SENDER=RoboCupJunior CMS
#MAIL_REPLY=support@example.com
#MAIL_MAX_PER_SECOND=5

# REGISTRATION SYSTEM
CMS_PROTOCOL=http
CMS_HOSTNAME=localhost:3000

# SCALEOUT
PROCESS_NUM=1

# LIMITER
LIMITER_WINDOW_MS=1000
LIMITER_MAX=50

# AUTOMATIC BACKUP
#BACKUP_INTERVAL_HOUR=24
#BACKUP_KEEP_VERSION=3

# ENV
# STG or PROD
ENVIRONMENT=PROD
NODE_ENV=production